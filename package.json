{
  "name": "ssi-learning-app",
  "version": "0.1.0",
  "private": true,
  "description": "SSi Language Learning Application - Framework-agnostic core with UI adapters",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:api": "vitest run -c vitest.api.config.ts",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter player-vue dev",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@vercel/node": "^5.5.27",
    "eslint": "^9",
    "eslint-plugin-vue": "^10",
    "globals": "^15",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8",
    "vitest": "^1.0.0",
    "vue-eslint-parser": "^10"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1089.0",
    "@paddle/paddle-node-sdk": "^3.8.0",
    "@supabase/supabase-js": "^2.86.0"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    }
  }
}
