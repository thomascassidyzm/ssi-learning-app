      icon: "Speaker SVG (🔊)"
      label: "Listen to prompt"
      active_style: "Belt-colored glow"

    speak:
      icon: "Microphone SVG (🎤)"
      label: "Your turn to speak"
      active_style: "Belt-colored glow + timer bar"
