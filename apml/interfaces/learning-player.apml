INK_SPIRIT_REWARDS:
  description: "Target language congratulations that drift upward"
  philosophy: "Hidden formula - show results, not mechanics"

  languages:
    chinese: ["好", "不错", "很好", "对", "棒", "厉害", "太棒了", "加油"]
    italian: ["bene", "bravo", "perfetto", "ottimo", "così", "esatto", "fantastico"]
    spanish: ["bien", "muy bien", "genial", "perfecto", "excelente", "así", "eso"]
    welsh: ["da", "da iawn", "gwych", "ardderchog", "bendigedig"]

  animation:
    type: "Float upward and fade"
    trigger: "Hidden formula based on performance"

## ============================================================================
## COMPOSABLES
## ============================================================================

COMPOSABLES:
  useLearningSession:
    purpose: "Manage learning session state and progression"
    source: "packages/player-vue/src/composables/useLearningSession.ts"

  usePrebuiltNetworkIntegration:
    purpose: "(REMOVED) was: integrate constellation network with learning session"
    source: "DELETED — composables/usePrebuiltNetworkIntegration.ts no longer exists,
             nor useLegoNetwork.ts. The live constellation network is no longer
             populated at runtime: LearningPlayer's ensureNetworkInitialized is now
             a no-op (`() => {}`). See NETWORK_INTEGRATION below — that section is
             aspirational/stale and tracked by constellation-network.apml; do not
             treat these composables as live."

  useScriptCache:
    purpose: "Cache generated learning scripts"
    source: "packages/player-vue/src/composables/useScriptCache.ts"

  useMetaCommentary:
    purpose: "Manage intro messages and encouragements"
    source: "packages/player-vue/src/composables/useMetaCommentary.ts"
    invariant: "Encouragements are a variable-interval reward: ~every 10 min of ACTIVE play (cycles played, not wall-clock — pauses don't count), jittered ±30% so they're unpredictable, and ALWAYS dropped between two speaking rounds (just-finished round not listening, next round not listening, no pod lap firing at this boundary). onRoundComplete is called every round to accumulate active time but only returns commentary when the caller's canFire (clean boundary) is set, so the timer lands on the next clean boundary. The listening schedule is untouched — the encouragement is the flexible guest. Also prevents the next-round intro overlapping a lap (the resume()/pause() race)."
    exposure: "Once-ever science bits (owner ruling 2026-07-24): instruction exposure is per-learner SERVER state (learner_meta_commentary_state, own-row RLS; localStorage is only a fast/offline mirror) — a wiped device recovers from the server and never replays a heard bit. The service re-keys via setLearnerId when the real learner id resolves after setup (guest→signed-in, play-as-class), carrying guest progress forward by furthest-wins merge. Backfill for pre-2026-07 learners: gated migration 20260724_backfill_meta_commentary_exposure.sql.gated (spec + tests in services/commentaryBackfillSpec.ts)."
    taper: "Encouragement taper (owner ruling 2026-07-24): random encouragements dial down with experience and switch fully OFF past a threshold — the fire interval is multiplied by 1/(1-p) through the taper zone (p = position through it), Infinity beyond. Experience = seed number of the round just played; default window 0→8 seeds (first belt equivalent). Admin-tunable via algorithm_config key 'meta_commentary' ({encouragementTaper:{taperStartSeeds,offAtSeeds}}). Instructions are never tapered; the ?fc dev cheat bypasses the taper."

  useBeltProgress:
    purpose: "Track belt progression with localStorage + Supabase sync"
    source: "packages/player-vue/src/composables/useBeltProgress.ts"
    features:
      - "localStorage primary (instant, works offline)"
      - "Supabase background sync (cross-device)"
      - "max(local, remote) merge strategy"

  useInstantPlayback:
    purpose: "Cold-start loading — round-map + first round's cycles in one parallel
              call so the first cycle plays in <2s; localStorage-cached."
    source: "packages/player-vue/src/composables/useInstantPlayback.ts"
    note: "REPLACED useBeltLoader (deleted) and the playback/PriorityRoundLoader
           island (SessionController/CyclePlayer/ThreadManager/RoundBuilder, all
           deleted). bootstrap() = main loop; bootstrapInfPlay(idx) = resume into
           INF PLAY; prewarmInstantCaches(courseCode) warms the caches on a course
           switch (called from App.vue). INSTANT_PLAYBACK_ALL=true in LearningPlayer
           routes every course here; the legacy upfront-load path is a catch fallback."
    features:
      - "Round-map (course_round_index, LEGO-id-ordered authority) fetched once"
      - "First round's cycles grabbed in the SAME parallel call (buffer complete pre-init)"
      - "localStorage cache fast-path; mapVersion-keyed invalidation"

  useAdaptationEngine:
    purpose: "Live real-time adaptation — composes the kept @ssi/core engines
              (MetricsTracker + SpikeDetector + MasteryStateMachine) directly."
    source: "packages/player-vue/src/composables/useAdaptationEngine.ts"
    note: "REPLACED the deleted @ssi/core AdaptationEngine class + WeightedSelector.
           getPauseMultiplier(legoId) drives pause length; hydrated off the
           cold-start critical path (see COLD_START.deferred_hydration)."

  useOfflinePlay:
    purpose: "Infinite play resilience for OFFLINE only (online INF PLAY is the deterministic revival build — see v2.1.4)"
    source: "packages/player-vue/src/composables/useOfflinePlay.ts"
    features:
      - "Automatic online/offline detection"
      - "Shuffled playback from cached items — OFFLINE path only; online never shuffles (appendCachedLoopForOffline / enterInfPlayFromCache refuse to run online)"
      - "Recent item avoidance (no immediate repeats)"

  useLegoNetwork:
    purpose: "(REMOVED) was: D3 force simulation for LEGO network (legacy)"
    source: "DELETED — composables/useLegoNetwork.ts no longer exists."

