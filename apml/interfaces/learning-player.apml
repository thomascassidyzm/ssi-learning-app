NETWORK_INTEGRATION:
  status: "DELETED FROM RUNTIME (2026-06-08) — historical design"
  component: "(none — ConstellationNetworkView.vue DELETED)"
  spec: "apml/interfaces/constellation-network.apml (see its DELETION NOTE)"

  behavior:
    on_item_change: "Pan to center hero node"
    on_voice_phases: "Highlight path through network"
    on_node_tap: "Play target audio for that LEGO"
    on_intro_phase: "Network faded (network-faded class)"

  props_provided:
    nodes: "From usePrebuiltNetworkIntegration"
    edges: "From usePrebuiltNetworkIntegration"
    heroNodeId: "Current LEGO ID"
    currentPath: "Path from phrase decomposition"
    panTransform: "Computed to center hero"
    showPathLabels: "true when voice_2"
    resonatingNodeIds: "Related nodes during voice phases"

## ============================================================================
## TRANSPORT CONTROLS
## ============================================================================

## Navigation principle: "granularity = location". Three controls, three
## POSITION levels. Bottom nav = CYCLE (finest). Header chevrons = ROUND/LEGO.
## Central belt pill = BELT jump (modal) + INF-PLAY readout. All position-keyed;
## the belt DERIVES from the landed round, never a parsed seed string.

TRANSPORT_CONTROLS:
  location: "Bottom of screen (thumb zone)"
  visibility: "Always visible"
  axis: "CYCLE — the finest, most-used control (slot ±1)"

  buttons:
    previous:
      icon: "‹ (chevron back)"
      action: "CYCLE regress — step one practice cycle back (slot -1), crossing round boundaries (first cycle → previous round's last cycle)"
      engine: "simplePlayer.stepCycle(-1) → handleRevisit"
      size: "44px touch target"

    play_pause:
      icon: "Play (▶) or Pause (⏸)"
      action: "Toggle session playback"
      size: "56px (larger, primary action)"
      color: "Accent red (#c23a3a)"

    next:
      icon: "› (chevron forward)"
      action: "CYCLE advance — step one practice cycle forward (slot +1), crossing round boundaries (last cycle → next round's first cycle)"
      engine: "simplePlayer.stepCycle(+1) → handleSkip"
      size: "44px touch target"

HEADER_NAV:
  location: "Header belt row"
  axis: "ROUND / LEGO (introduced LEGO ±1)"

  back:
    icon: "‹‹ (double chevron back)"
    action: "Previous introduced LEGO, jump to round START (slot 0) so intro/debut/build REPLAY. Loads previous LEGO's rounds if not loaded. Doubles as INF-PLAY exit (flips current_mode → main)."
    engine: "handleRoundBack"
    disabled_when: "round 0 and not in INF PLAY, or offline"

  forward:
    icon: "›› (double chevron forward)"
    action: "Main loop: next introduced LEGO (round +1, by LEGO id); at the FINAL LEGO advancing ENTERS INF PLAY. WHILE IN INF PLAY: ADVANCES through the revival/spaced-rep rounds (rounds still exist in INF PLAY) — NOT a no-op; wraps at the tail; belt stays pinned to the final belt; infplayRoundIndex readout bumps."
    engine: "handleRoundForward → enterInfPlay() at course end; advanceInfPlayRound() while in INF PLAY"
    disabled_when: "offline (NO LONGER disabled in INF PLAY)"

  central_belt_pill:
    role: "Belt readout + tap → belt modal + INF-PLAY indicator"
    engine: "handleBeltPillTap → ProgressModal → handleSkipToBelt (belt jump) / handleActivateInfPlay (∞ activator)"
    infplay_state: "When current_mode === 'infplay': purple, THROBS, shows ∞ glyph with NO progress line (.belt-timer-unified.is-infplay, with mist counterpart). The ∞ indicator lives here; the modal's ∞ button is the ACTIVATOR."
    belt_modal: "Belt row is COLOUR-ONLY: each belt is just its coloured dot (.map-chip-dot) with a thin black ring (so WHITE reads on the white modal); belt NAME in title/aria-label. A glowing/throbbing ∞ activator (.infplay-activator) at the row end ENTERS INF PLAY (emit enterInfPlay → handleActivateInfPlay → enterInfPlay()) — the deliberate entry point. Both have :root[data-theme=\"mist\"] counterparts (modal teleports to body)."

## ============================================================================
## RESUME BEHAVIOR
## ============================================================================

## "Resume = where you left off", sized by how long the break was. Updated
## 2026-06-01 (fix/resume-position).

RESUME_BEHAVIOR:
  cursor:
    stored: "course_enrollments: last_completed_lego_id (the permalink), current_cycle_index, last_practiced_at"
    writer: "ProgressStore.setLivePosition ONLY — fired per cycle (phase=prompt), so the DB source is cycle-precise and never lags localStorage. Single writer; useBeltProgress.syncToRemote no longer writes last_completed_lego_id (highest is lifted from the cursor by the ratchet trigger)."
  gap_rule:
    config: "ResumeConfig.cycleResetMinutes (default 5)"
    under_cutoff: "gap < cutoff → resume the EXACT cycle (the Voice-2-incomplete one)"
    over_cutoff: "gap >= cutoff → restart the in-progress ROUND (cycle 0 → the LEGO intro replays). Uniform: no practice rounds; in INF PLAY there is no intro, so it is simply the round start."
    belt_regression: "ResumeConfig.beltRegressionDays (default 60) → walk the cursor back to the current belt's start (ceiling preserved)"
    applied_on: "EVERY resume path — localStorage (resolveResumePosition, via the save's lastUpdated stamp) AND the DB-cursor path (via last_practiced_at). Fires only on a fresh load/reopen; pressing play in a still-live session is a continuation, not a resume."

## ============================================================================
## ACCESS GATING / PAYWALL (2026-06-16)
## ============================================================================

## Premium courses are free through Yellow Belt (PREMIUM_PREVIEW_MAX_SEED, seed
## 19) for non-subscribers; past that requires a subscription. The in-player
## paywall overlay (.paywall-overlay) is the SINGLE conversion point — the old
## /premium marketing page (views/PremiumView.vue + the 'premium' route) was
## deleted. Free / community courses and subscribers are never gated.

ACCESS_GATING:
  source_of_truth: "useEntitlement().canAccessSeed(course, seedNumber) — false for a premium non-subscriber when seedNumber > PREMIUM_PREVIEW_MAX_SEED (@ssi/core). The limit is never reinvented in the player."

  central_guard:
    fn: "gateSeed(targetSeedNumber): boolean (LearningPlayer.vue) — the ONE place every jump/skip site routes a target seed before moving the cursor. Returns true when allowed; when blocked it simplePlayer.pause() + showPaywall=true and returns false so the caller bails. No way for a premium non-subscriber to play a seed > PREMIUM_PREVIEW_MAX_SEED."
    gated_sites:
      - "Sequential round advance — pre-existing check in simplePlayer.onRoundCompleted (next round's seed)."
      - "Cycle-skip rolling into the next round — handleSkip (only the last-cycle → next-round crossing)."
      - "LEGO step forward — handleRoundForward (next round's seed)."
      - "Belt-skip / jump-to-belt — handleSkipToBelt (picked belt's first seed); covers header chevrons + belt modal which route through it."
      - "INF PLAY entry — enterInfPlay (course-end seed); covers round-forward at the final LEGO, belt-forward at course end, and the ∞ activator."
      - "Deep-link / CourseBrowser jump — ssi-jump-to-seed handler."
    resume_gate: "On positionInitialized → true, the landed round's seed is re-checked. A returning premium non-subscriber whose saved / deep-linked / INF-PLAY position resolved past the preview is pulled back (jumpToRound(0)) with the paywall raised — never resumes INTO locked content. Catches all resume/init branches at one point."

  paywall_overlay:
    headline: "\"You've reached the end of the free preview\" + \"£15/month — unlimited access to all languages. Cancel anytime.\""
    primary: "\"Subscribe — £15/month\" → useCheckout().startCheckout (signed-out users get the auth modal first, then auto-continue into Paddle via completePendingCheckout wired in PlayerContainer.handleAuthSuccess). Opens the existing getPaddle().Checkout.open — money-capture backend untouched."
    secondary: "\"I have an access code\" (emit viewProgress) and \"Maybe later\" (dismiss + jumpToRound(0) + resume — keeps the learner in preview, never dumps them)."
    checkout_composable: "composables/useCheckout.ts — lifted out of the deleted PremiumView so the paywall is self-contained. Reused by SettingsScreen 'Go Premium' and CourseSelector 'Go Premium' CTA. Paddle success redirects to /?course=…&just_subscribed=1 (or /?openCourses=1&just_subscribed=1); useSubscription.initialize polls until active on just_subscribed so the learner doesn't bounce off the paywall mid-redirect."
    dismiss: "dismissPaywall() (LearningPlayer.vue) is the ONE dismiss path — Maybe-later click, backdrop click (@click.self), and Escape (document keydown listener, attached only while showPaywall is true) all call it. Fixed 2026-07-16: .learning-player-root previously had no z-index, so its whole subtree (incl. .paywall-overlay's z-index:3000) was capped at the ancestor's implicit stacking level in PlayerContainer.vue — PlayerRestingState's `.resting-state` (z-index:50, pointer-events:auto, rendered whenever !isPlaying — true the instant the paywall pauses playback) painted over it and silently ate every tap on the card. .learning-player-root now carries z-index:100 (above resting-state's 50, well below the nav/course-selector/settings chrome at 2000-3000)."

## ============================================================================
## COLD START & WELCOME (2026-06-08)
## ============================================================================

## "Playback is the loading mask." Cold start gets a cycle into the buffer in
## one indexed query + one tiny cycles fetch; everything not required to play
## the FIRST cycle is fired concurrently and NOT awaited.

COLD_START:
  source: "packages/player-vue/src/components/LearningPlayer.vue (onMounted + loadAllData)"

  instant_playback_bootstrap:
    composable: "composables/useInstantPlayback.ts"
    gate: "INSTANT_PLAYBACK_ALL = true (const in LearningPlayer.vue) — every course
           uses the instant path; INSTANT_PLAYBACK_COURSES allowlist only matters
           if the wildcard is flipped off. The legacy upfront-load path (cached
           script / generateScript+toSimpleRounds) survives ONLY as a catch
           fallback when SimplePlayer/instant init throws."
    how: |
      instantPlayback.bootstrap() fetches the round-map (course_round_index, the
      LEGO-id-ordered authority) AND the whole first round's cycles in one
      parallel call, so the buffer is COMPLETE before player init — no second
      network roundtrip before first play (the old separate Tier-1 awaited fetch
      is removed). Round-map + cycles are localStorage-cached (the cache fast-path
      hydrates rounds from localStorage when present). Resume directly INTO INF
      PLAY uses bootstrapInfPlay(infPlayRoundIndex) instead (deterministic build,
      lands on the revival round keyed on infplay_round_index).
    prewarm_on_switch: |
      App.vue calls prewarmInstantCaches(courseCode) (useInstantPlayback) when the
      course changes, so a course SWITCH (an in-app remount, not a document load)
      finds the round-map/cycles already warm.
    skips_and_legacy: "generateScript / useScriptCache still live — used for skips
                        and the legacy/offline INF-PLAY paths."

  splash_floor:
    state_ref: "loadingStage ref ('awakening' | 'finding' | 'preparing' | 'ready'),
                isAwakening = loadingStage !== 'ready'. setLoadingStage drives it."
    rule: |
      A DELIBERATE minimum splash time, not a data-wait: MINIMUM_ANIMATION_MS =
      300ms for a returning user (localStorage 'ssi-has-played' === 'true'),
      2800ms on first visit (the full cinematic awakening → finding → preparing
      timeline). Data load (loadAllData) and the animation timeline run in
      Promise.all; ready = BOTH data loaded AND the floor elapsed. When the data
      lands before the floor (the common case now), the floor is the gate. After
      Promise.all, warmFirstKnownAudio() (bounded ~2s) makes the opening sound
      instant, then goLoadingStageReady().
    graceful_typewriter_exit: |
      The awakening line is typed char-by-char (40ms) into currentLoadingMessage
      and rendered under `v-if="isAwakening"`, so flipping loadingStage to 'ready'
      used to CUT it mid-word ("Getting your course da" → resting copy). SWR-warm
      loads reach ready in well under the ~1.4s a course-template line needs, so
      the cut landed mid-word almost every time (founder report 2026-07-29).
      goLoadingStageReady() is now the only exit: it awaits
      finishLoadingTypewriterFast() — completes the remaining characters at 12ms
      each (capped at 240ms; beyond that the rest lands in one go so a fast load
      never stretches), holds 220ms so the finished line is readable, then flips
      to 'ready'. Costs 0ms when the line already finished (every first-visit /
      slow load). typeLoadingMessage also clears any pending timeout and carries
      a generation token, so a second call (course switch,
      beginBlockingRegenNotice) can no longer leave two loops appending into the
      same ref.

  deferred_hydration: |
    Belt + adaptation hydration are moved OFF the critical path. The two init
    calls — initializeBeltProgress() (belt remote merge + getMaxSeedNumber),
    initializeAdaptationEngine() (mastery hydration) — each await a Supabase
    round-trip but NEITHER is required before the first cycle plays. They are
    fired CONCURRENTLY via void Promise.all([...]) and NOT awaited; the belt
    readout / pause tuning hydrate reactively a beat later. Every consumer is
    null-safe with a default (adaptationEngine.value?.getPauseMultiplier() ??
    1.0, belt computeds all `?. ?? <default>`). Only getEnrollment (resume
    position) is on the critical path. loadGlobalLegoTexts() + offline-play listener
    setup are likewise fire-and-forget. Lazy chunks (ListeningOverlay, Pronunciation
    Overlay, ProgressModal, SessionComplete) are import-prewarmed on requestIdleCallback
    AFTER ready. Network population is deferred to first play / Progress-screen open.
    (2026-07-14: initializeListeningProgress() / useListeningProgress.ts /
    LegoListeningStore deleted — dead since the 2026-05-19 L1 main-flow
    removal; L1 listening now lives entirely in the runtime 30-cup wheel,
    useLayer1Scheduler.ts, which needs no fire-count hydration.)

  telemetry:
    event: "cold_start (logEvent) — the ONLY event before tap_play, so cold starts
            are measurable; cookie-based so guests are included."
    payload: |
      { isFreshLoad (true = real document load, false = in-app course switch/remount),
        mountToReadyMs (always-valid per-mount onMounted→ready cost),
        totalMs / mainExecMs / mountedMs (nav-relative, only meaningful on a fresh
        load — read from window.__ssiBoot marks written once in main.js),
        animFloorMs (the splash floor), returnUser, guest }
    note: "On a course switch the nav-relative numbers are stale (boot marks fire
           once); mountToReadyMs is the real switch cost. Console '[ColdStart]'
           line mirrors it."

  docs: "docs/cold-start-and-playback.md; docs/buffer-model.md (superseded model)."

## ============================================================================
## WELCOME AUDIO (plays once EVER per learner — 2026-06-08)
## ============================================================================

WELCOME_AUDIO:
  source: "packages/player-vue/src/components/LearningPlayer.vue (playCourseWelcome /
           markWelcomeHeard / skipWelcome)"
  description: "A ~1-min course welcome. Deferred until the learner taps Play —
                never autoplays before interaction. Plays on a DEDICATED Audio
                element (not the shared audioController), with a skip button."

  once_ever_per_learner: |
    (2026-06-08) The welcome plays ONCE EVER per LEARNER, course-agnostic —
    NOT once per course. It used to key on course_enrollments.welcome_played
    (per-course). The flag now lives on learners.welcome_played_at — survives
    PWA reinstall / new device / switching to a different course.
    Resolution order in playCourseWelcome():
      1. welcomeChecked ref / localStorage 'ssi-welcome-heard' === 'true' (the
         same-device fast path; also checked in the loader watchEffect to skip
         even fetching the welcome audio).
      2. For a real (non-guest) learner: courseDataProvider.hasPlayedWelcome
         (learnerId) reads learners.welcome_played_at — the cross-device source
         of truth (one cheap DB read before a ~1-min clip). Guests have no DB
         row → fall through to localStorage-only.
  marking: |
    markWelcomeHeard() — fired on natural end AND on skip (skipped counts as
    heard) — sets welcomeChecked + localStorage, then calls
    courseDataProvider.markWelcomePlayed(learnerId). That POSTs /api/welcome/played
    (api/welcome/played.ts), a service-role endpoint: `learners` is column-write-
    locked for clients (20260521180000_block_anon_role_escalation), so the client
    cannot UPDATE the row directly. JWT-gated (verifyAuthToken) — a caller can
    only mark their OWN learner row (matched by auth user_id). Idempotent: the
    UPDATE is `.is('welcome_played_at', null)` so the first timestamp is never
    overwritten.

## ============================================================================
## INTRO MODE
