CSS_CUSTOM_PROPERTIES:
  theme:
    # SINGLE theme: "mist" (light), forced for everyone via composables/useTheme.ts
    # (data-theme="mist" pinned; toggleTheme/setTheme are no-ops; isDark()=false).
    # The old dark theme (cosmos / "Deep Space Constellation" / "Moonlit Dojo") is
    # deprecated — do NOT reintroduce dark mode. Tokens: styles/design-tokens.css [data-theme="mist"].
    name: "mist (light) — the only theme"
