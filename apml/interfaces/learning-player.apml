## VISUAL LAYOUT (January 2026)
## ============================================================================

LAYOUT:
  structure: |
    ┌─────────────────────────────────────────────────────────────────────┐
    │                    Deep Space Background                            │
    │                    (gradient + nebula + noise)                      │
    │                                                                     │
    │    ┌───────────────────────────────────────────────────────────┐   │
    │    │                                                           │   │
    │    │              CONSTELLATION NETWORK VIEW                   │   │
    │    │                                                           │   │
    │    │         ○ ────── ● ────── ○                              │   │
    │    │        /          \                                       │   │
    │    │       ○            ○ ←── Hero Node (centered)            │   │
    │    │                     \                                     │   │
    │    │                      ○                                    │   │
    │    │                                                           │   │
    │    └───────────────────────────────────────────────────────────┘   │
    │                                                                     │
    │    ┌───────────────────────────────────────────────────────────┐   │
    │    │            HERO TEXT PANE (Glass Effect)                  │   │
    │    │                                                           │   │
    │    │  ┌──────────────────────────────────────────────────────┐│   │
    │    │  │  🔊  │  🎤  │  🔊  │  👀  │   ← Phase Strip          ││   │
    │    │  │ prompt│speak │voice1│voice2│     (icons)              ││   │
    │    │  └──────────────────────────────────────────────────────┘│   │
    │    │                                                           │   │
    │    │  "I want to speak Italian with you"    ← Known text      │   │
    │    │                                                           │   │
    │    │  "Voglio parlare italiano con te"      ← Target (voice_2)│   │
    │    │                                                           │   │
    │    └───────────────────────────────────────────────────────────┘   │
    │                                                                     │
    │              ⏮  ▶️  ⏭                ← Transport Controls       │
    │                                                                     │
    │    ──────────────────────────────────────────────────────────────  │
    │    Star Field (static distant stars)                                │
    └─────────────────────────────────────────────────────────────────────┘

  layers:
    z_0: "Space gradient background"
    z_1: "Space nebula overlay"
    z_2: "Background noise texture"
    z_3: "Static star field"
    z_4: "Constellation network view"
    z_5: "Hero text pane (glass)"
    z_6: "Node hover tooltip"
    z_7: "Transport controls"
    z_8: "Overlays (session complete, consent prompts)"

## ============================================================================
## HERO TEXT PANE
## ============================================================================

HERO_TEXT_PANE:
  description: "Floating glass panel showing current phrase and phase"

  visual:
    background: "Frosted glass effect (backdrop-blur)"
    border: "Subtle belt-colored glow"
    position: "Lower third of screen, over network"

  modes:
    intro_mode:
      display: "Typewriter-style encouraging message"
      elements:
        prefix: "› (chevron)"
        message: "Typewriter text animation"
        cursor: "▌ (blinking block cursor)"
      triggers: "Item type is 'intro'"

    normal_mode:
      display: "Phase strip + known/target text"
      elements:
        phase_strip: "Horizontal 4-section strip with icons"
        known_text: "Known language text (always visible)"
        target_text: "Target language text (voice_2 only)"

## ============================================================================
## TILE ASSEMBLY & SCRIPT DISPLAY (June 2026)
## ============================================================================

TILE_ASSEMBLY:
  description: "Phrase decomposed into per-LEGO tiles (LegoAssembly.vue)"
  source: "packages/player-vue/src/components/LegoAssembly.vue"

  dual_script_model: |
    Every non-Latin-script course shows the NATIVE script as the primary glyph
    with the romanisation as an optional ruby line above each tile
    (block.romanText). The script toggle (ModeTray "Pronunciation") only shows/
    hides the ruby — it is NOT a switch between two scripts. Default on; the
    learner drops the crutch as recognition builds. Three tiling strategies are
    dispatched by script shape (utils/alignRomanToNative.ts):

  key_principle: |
    Tiling is ALWAYS derived from the ROMANISED side (the reliably-segmented one
    — word spaces or syllables). currentPhraseLegoBlocksRaw builds on romanised
    (useNative=false); currentPhraseLegoBlocks then produces the native-primary
    display per script. Lesson from the first cut: the NATIVE decomposition is
    unreliable for spaceless scripts (Japanese's is mostly ghost characters),
    whereas the romaji decomposes cleanly.

  strategies:
    authored_display_tiling:
      langs: "any course with course_practice_phrases.display_tiling (jpn_for_eng
              backfilled June 2026, ~99% of phrases)"
      how: "Strategy 0, authoritative. Popty stores authored tiles
            [{n: native, r: roman, salient}] per phrase, validated both ways at
            build time (roman = stored value sliced, native reassembles exactly).
            Carried additively on the cycle as displayTiling through every
            serving path (generateLearningScript select, toSimpleRounds,
            cycles/infplay-cycles endpoints + get_course_cycles_window RPC,
            bundle). currentPhraseLegoBlocks renders them verbatim when the
            joined n-values reassemble the displayed native phrase
            (whitespace-normalised); NULL or mismatch falls through to the
            runtime strategies below. SCRIPT_VERSION v9 invalidated cached
            scripts so the field appears without a content_version bump."
      priority: "Checked before all runtime strategies — the device segmenter
                 is now the fallback, not the primary path."
    mandarin_pinyin_word:
      langs: "zho"
      how: "buildWordTiles — tile by pinyin word; 1 hanzi = 1 syllable, each
            pinyin word consumes its syllable-count of hanzi (erhua 儿 +
            apostrophe). LEGO decomposition only marks salient tiles."
      validated: "zho_for_eng: 5436 tiled, salient located 100%."
    spaced_word_pair:
      langs: "kor, rus, ell, hye, ara, hin, ukr, fas, bul, heb (RTL: ara/fas/heb)"
      how: "buildWordPairTiles — native and romanisation are both whitespace-
            segmented and 1:1, so zip into one tile per word (native primary,
            romaji ruby). FINER than the LEGO decomposition (whose salient can be
            a whole clause). Salient from the salient LEGO's native text. Ruby
            LTR + bidi-isolated for RTL. Null on count mismatch → native-pair."
      validated: "word-parity 94% (ara) – 100% (rus/hin/bul/heb)."
    spaceless_device_segmented:
      langs: "jpn, tha (Thai)"
      how: "buildSegmentedTiles — the DEVICE segments the native sentence into
            words via Intl.Segmenter(locale,'word') (ICU dictionaries, ja/th),
            so tiling does NOT depend on the backend decomposition (which is
            39-69% ghost for these). Romaji per tile, in order of preference:
            (ja) alignJapaneseRomaji — forced-align the phrase romaji onto the
            segmented words using kana as anchors + kanji as gaps recovered from
            the stream; then positional phrase-romaji on count match; then the
            course native→romaji dict (legos+atoms); else native, no ruby (still
            parseable). Salient by char-offset. Old engines → nativeFromRomanTiles."
      validated: "jpn combined romaji coverage 97.6% tiles / 90% phrases; tha ~96%."
    latin:
      langs: "spa/fra/deu/… (no target_text_roman)"
      how: "hasRomanizedText=false → raw romanised tiling unchanged, no ruby."

  intro_glosses:
    rule: |
      (Tom 2026-06-07, v2: tiles must be IDENTICAL to regular phrases)
      Intro/debut show the known-language gloss UNDER the tiles — first
      presentation must let the learner match the pieces in both languages
      ("cosa|azul / thing|blue") — but the tiles and ruby themselves render
      EXACTLY as the LEGO appears in a regular phrase; the gloss is purely
      additive. attachIntroGlosses (LearningPlayer) wraps every word-tiling
      strategy's output on intro/debut only: component targets (union of
      componentsNative + components — a component whose roman form is NULL,
      e.g. zho 你, only exists in the roman list with native fallback text)
      claim contiguous tile runs, order-independently (DB returns component
      phrases in arbitrary order), longest target first. Each tile gets a
      glossGroup id; LegoAssembly's intro-gloss-groups template branch (a
      v-if BEFORE carriage/single-tile modes) renders runs as flush tile
      rows with the run's gloss centred underneath (.gloss-group-row /
      .gloss-group-tile). Structural particles keep their empty known
      (claimed run, no gloss); unmatched components simply don't gloss —
      tiles are NEVER merged or re-tiled. Single-tile LEGOs get the whole
      known text. Known text never shows outside intro/debut. The gloss
      line is RESERVED on every run (min-height, even when empty — e.g. a
      structural particle's silent gloss): the assembly bottom-aligns the
      groups, so a missing line would push that run's tile down by one
      gloss-height relative to its neighbours.

  typography:
    uniform_bold: |
      (Tom 2026-06-07) Tile text is ONE size + weight (600) everywhere — the
      old salient-vs-context split (smaller/muted non-salient text, softer
      non-salient chrome, hero known-text salient-substring emphasis +
      context fade) is removed. With the ruby line and authored per-word
      tiles the weight differentiation read as noise. isSalient still flows
      on blocks (semantics/telemetry) but changes nothing visually. The
      display box (hero-known / known-text) renders the whole known phrase
      at weight 600.

  script_toggle:
    composable: "composables/useScriptMode.ts (per-course localStorage)"
    semantics: |
      Native-script glyphs are ALWAYS the primary text on romanised courses.
      The toggle only shows/hides the romanisation as a ruby line (block.romanText)
      above each tile — a pronunciation crutch the learner drops as character
      recognition builds from exposure. Default ON (scriptMode 'roman').
    control: "ModeTray.vue — Aa (guide shown) / 文 (characters only)"
    prop: "LegoAssembly :show-romanization (LearningPlayer showRomanization computed)"

## ============================================================================
## LISTENING OVERLAY (headphones mode)
## ============================================================================

LISTENING_OVERLAY:
  source: "packages/player-vue/src/components/ListeningOverlay.vue"
  tabs: |
    Dialogues | Core | All — in that order, Dialogues is the DEFAULT view
    (Tom 2026-06-07). Dialogues = Layer 2 pod scenes (useListeningPods,
    grouped by listening_pod_sentences.scene_number); Core = every seed
    sentence; All = every USE phrase. Phrase data loads lazily on first
    tap of All/Core — the default mount only loads the scene list.
  dialogues_playlist: |
    Scenes play as ONE continuous playlist: scene-end segues into the next
    scene automatically, and after the last scene wraps around to the
    first (Spotify playlist loop). The scene-loop button (visible with a
    scene open) is single-track repeat: ON = restart the current scene
    forever; default OFF. Scene matching is by sceneNumber — PodScene has
    no `id` field (a former `s.id === selected.id` undefined comparison
    made every scene "advance" to scene 2).
  background_lock_protocol: |
    (2026-06-07) The overlay follows the SAME bg/lock rule as the main
    flow, INF PLAY and pod laps: every playback gap advances on an audio
    'ended' event, NEVER a bare setTimeout (iOS freezes timers on a
    backgrounded/locked tab). The 50ms intra-turn and 800ms inter-turn
    gaps play as genuinely-silent one-shot WAV clips on the same element
    (ListeningAudioController.playSilence → playback/silentWav.ts, the
    builder extracted from SimplePlayer's PAUSE fix). playbackRate
    applies to the silence too, so faster speeds tighten gaps
    proportionally. The 15s safety timeout inside play() remains as a
    foreground fallback only. RULE for any new playback surface: a gap
    is "a phase with audio", never "a phase with only a timer".

  speaker_colouring: |
    (Tom 2026-06-07) The voice-casting 4-colour-map principle, made
    VISIBLE: useListeningPods builds the pod-wide "shares a scene" graph
    and greedy-colours speakers in first-appearance order (same algorithm
    as Popty's voice colouring proof — never needed >4 colours on real
    pods). One character = one colour across the whole pod; scene-mates
    never share. SPEAKER_PALETTE (6 mid-tone colours) exported from the
    composable. Rendered as: an uppercase speaker chip + dot above every
    teleprompter dialogue row (.phrase-speaker), and cast dots on each
    scene card (.scene-card-cast). Colour rides turn.colorIndex; display
    name is the speaker label minus its time/place annotation.

  scene_granularity: |
    One scene = one dialogue beat. Montage pods (several mini-dialogues
    sharing a backdrop, e.g. fra pod-0's "day of greetings") must be
    SPLIT into one scene per beat in the data — same-speaker turn merging
    (useListeningPods.mergeTurns) operates within a scene and will glue
    the tail of one beat to the head of the next if they share a
    scene_number (the 2026-06-07 French bug: "Have a good one! Excuse me,
    is this seat taken?" as one card).

## ============================================================================
## PHASE STRIP
## ============================================================================

PHASE_STRIP:
  description: "Horizontal strip showing 4 phases with semantic icons"
  location: "Top of hero text pane"

  sections:
    prompt:
      icon: "Speaker SVG (🔊)"
      label: "Listen to prompt"
      active_style: "Belt-colored glow"

    speak:
      icon: "Microphone SVG (🎤)"
      label: "Your turn to speak"
      active_style: "Belt-colored glow + timer bar"
      timer: "Linear progress bar showing pause countdown"

    voice_1:
      icon: "Speaker SVG (🔊)"
      label: "Native speaker #1"
      active_style: "Belt-colored glow"

    voice_2:
      icon: "Eyes emoji (👀)"
      label: "See the answer"
      active_style: "Belt-colored glow"

  timer_bar:
    location: "Inside mic section when speak phase active"
    style: "Linear fill bar (replaced ring progress)"
    animation: "Width grows from 0% to 100% over pause duration"

## ============================================================================
## PHASE-SPECIFIC UI STATES
## ============================================================================

PHASE_UI_STATES:
  PROMPT:
    phase_strip: "Prompt section highlighted (speaker icon)"
    known_text: "Visible, prominent"
    target_text: "Hidden"
    network: "Hero node centered, subtle glow"

  PAUSE (speak):
    phase_strip: "Speak section highlighted (mic icon) + timer bar"
    known_text: "Visible, slightly dimmed"
    target_text: "Hidden"
    network: "Path nodes begin to highlight"

  VOICE_1:
    phase_strip: "Voice_1 section highlighted (speaker icon)"
    known_text: "Visible"
    target_text: "Hidden"
    network: "Path nodes highlighted with pulse"

  VOICE_2:
    phase_strip: "Voice_2 section highlighted (eyes icon)"
    known_text: "Visible"
    target_text: "Revealed with animation"
    network: "Full path animation (nodes + edges + labels)"

## ============================================================================
## CONSTELLATION NETWORK INTEGRATION
## ============================================================================

NETWORK_INTEGRATION:
  component: "ConstellationNetworkView"
  spec: "apml/interfaces/constellation-network.apml"

  behavior:
    on_item_change: "Pan to center hero node"
    on_voice_phases: "Highlight path through network"
    on_node_tap: "Play target audio for that LEGO"
    on_intro_phase: "Network faded (network-faded class)"

  props_provided:
    nodes: "From usePrebuiltNetworkIntegration"
    edges: "From usePrebuiltNetworkIntegration"
    heroNodeId: "Current LEGO ID"
    currentPath: "Path from phrase decomposition"
    panTransform: "Computed to center hero"
    showPathLabels: "true when voice_2"
    resonatingNodeIds: "Related nodes during voice phases"

## ============================================================================
## TRANSPORT CONTROLS
## ============================================================================

## Navigation principle: "granularity = location". Three controls, three
## POSITION levels. Bottom nav = CYCLE (finest). Header chevrons = ROUND/LEGO.
## Central belt pill = BELT jump (modal) + INF-PLAY readout. All position-keyed;
## the belt DERIVES from the landed round, never a parsed seed string.

TRANSPORT_CONTROLS:
  location: "Bottom of screen (thumb zone)"
  visibility: "Always visible"
  axis: "CYCLE — the finest, most-used control (slot ±1)"

  buttons:
    previous:
      icon: "‹ (chevron back)"
      action: "CYCLE regress — step one practice cycle back (slot -1), crossing round boundaries (first cycle → previous round's last cycle)"
      engine: "simplePlayer.stepCycle(-1) → handleRevisit"
      size: "44px touch target"

    play_pause:
      icon: "Play (▶) or Pause (⏸)"
      action: "Toggle session playback"
      size: "56px (larger, primary action)"
      color: "Accent red (#c23a3a)"

    next:
      icon: "› (chevron forward)"
      action: "CYCLE advance — step one practice cycle forward (slot +1), crossing round boundaries (last cycle → next round's first cycle)"
      engine: "simplePlayer.stepCycle(+1) → handleSkip"
      size: "44px touch target"

HEADER_NAV:
  location: "Header belt row"
  axis: "ROUND / LEGO (introduced LEGO ±1)"

  back:
    icon: "‹‹ (double chevron back)"
    action: "Previous introduced LEGO, jump to round START (slot 0) so intro/debut/build REPLAY. Loads previous LEGO's rounds if not loaded. Doubles as INF-PLAY exit (flips current_mode → main)."
    engine: "handleRoundBack"
    disabled_when: "round 0 and not in INF PLAY, or offline"

  forward:
    icon: "›› (double chevron forward)"
    action: "Main loop: next introduced LEGO (round +1, by LEGO id); at the FINAL LEGO advancing ENTERS INF PLAY. WHILE IN INF PLAY: ADVANCES through the revival/spaced-rep rounds (rounds still exist in INF PLAY) — NOT a no-op; wraps at the tail; belt stays pinned to the final belt; infplayRoundIndex readout bumps."
    engine: "handleRoundForward → enterInfPlay() at course end; advanceInfPlayRound() while in INF PLAY"
    disabled_when: "offline (NO LONGER disabled in INF PLAY)"

  central_belt_pill:
    role: "Belt readout + tap → belt modal + INF-PLAY indicator"
    engine: "handleBeltPillTap → ProgressModal → handleSkipToBelt (belt jump) / handleActivateInfPlay (∞ activator)"
    infplay_state: "When current_mode === 'infplay': purple, THROBS, shows ∞ glyph with NO progress line (.belt-timer-unified.is-infplay, with mist counterpart). The ∞ indicator lives here; the modal's ∞ button is the ACTIVATOR."
    belt_modal: "Belt row is COLOUR-ONLY: each belt is just its coloured dot (.map-chip-dot) with a thin black ring (so WHITE reads on the white modal); belt NAME in title/aria-label. A glowing/throbbing ∞ activator (.infplay-activator) at the row end ENTERS INF PLAY (emit enterInfPlay → handleActivateInfPlay → enterInfPlay()) — the deliberate entry point. Both have :root[data-theme=\"mist\"] counterparts (modal teleports to body)."

## ============================================================================
## RESUME BEHAVIOR
## ============================================================================

## "Resume = where you left off", sized by how long the break was. Updated
## 2026-06-01 (fix/resume-position).

RESUME_BEHAVIOR:
  cursor:
    stored: "course_enrollments: last_completed_lego_id (the permalink), current_cycle_index, last_practiced_at"
    writer: "ProgressStore.setLivePosition ONLY — fired per cycle (phase=prompt), so the DB source is cycle-precise and never lags localStorage. Single writer; useBeltProgress.syncToRemote no longer writes last_completed_lego_id (highest is lifted from the cursor by the ratchet trigger)."
  gap_rule:
    config: "ResumeConfig.cycleResetMinutes (default 5)"
    under_cutoff: "gap < cutoff → resume the EXACT cycle (the Voice-2-incomplete one)"
    over_cutoff: "gap >= cutoff → restart the in-progress ROUND (cycle 0 → the LEGO intro replays). Uniform: no practice rounds; in INF PLAY there is no intro, so it is simply the round start."
    belt_regression: "ResumeConfig.beltRegressionDays (default 60) → walk the cursor back to the current belt's start (ceiling preserved)"
    applied_on: "EVERY resume path — localStorage (resolveResumePosition, via the save's lastUpdated stamp) AND the DB-cursor path (via last_practiced_at). Fires only on a fresh load/reopen; pressing play in a still-live session is a continuation, not a resume."

## ============================================================================
## INTRO MODE
## ============================================================================

INTRO_MODE:
  description: "Gentle listen prompts between learning rounds"

  display:
    style: "Typewriter animation"
    prefix: "› chevron"
    cursor: "▌ blinking"
    font: "JetBrains Mono"

  messages:
    examples:
      - "Just listen for now..."
      - "Let the sounds wash over you..."
      - "No need to repeat yet..."
      - "Getting you ready..."

  network_behavior:
    class: "network-faded"
    opacity: "Reduced to keep focus on message"

## ============================================================================
## INK SPIRIT REWARDS
## ============================================================================

INK_SPIRIT_REWARDS:
  description: "Target language congratulations that drift upward"
  philosophy: "Hidden formula - show results, not mechanics"

  languages:
    chinese: ["好", "不错", "很好", "对", "棒", "厉害", "太棒了", "加油"]
    italian: ["bene", "bravo", "perfetto", "ottimo", "così", "esatto", "fantastico"]
    spanish: ["bien", "muy bien", "genial", "perfecto", "excelente", "así", "eso"]
    welsh: ["da", "da iawn", "gwych", "ardderchog", "bendigedig"]

  animation:
    type: "Float upward and fade"
    trigger: "Hidden formula based on performance"

## ============================================================================
## COMPOSABLES
## ============================================================================

COMPOSABLES:
  useLearningSession:
    purpose: "Manage learning session state and progression"
    source: "packages/player-vue/src/composables/useLearningSession.ts"

  usePrebuiltNetworkIntegration:
    purpose: "Integrate constellation network with learning session"
    source: "packages/player-vue/src/composables/usePrebuiltNetworkIntegration.ts"

  useScriptCache:
    purpose: "Cache generated learning scripts"
    source: "packages/player-vue/src/composables/useScriptCache.ts"

  useMetaCommentary:
    purpose: "Manage intro messages and encouragements"
    source: "packages/player-vue/src/composables/useMetaCommentary.ts"
    invariant: "Encouragements are a variable-interval reward: ~every 10 min of ACTIVE play (cycles played, not wall-clock — pauses don't count), jittered ±30% so they're unpredictable, and ALWAYS dropped between two speaking rounds (just-finished round not listening, next round not listening, no pod lap firing at this boundary). onRoundComplete is called every round to accumulate active time but only returns commentary when the caller's canFire (clean boundary) is set, so the timer lands on the next clean boundary. The listening schedule is untouched — the encouragement is the flexible guest. Also prevents the next-round intro overlapping a lap (the resume()/pause() race)."

  useBeltProgress:
    purpose: "Track belt progression with localStorage + Supabase sync"
    source: "packages/player-vue/src/composables/useBeltProgress.ts"
    features:
      - "localStorage primary (instant, works offline)"
      - "Supabase background sync (cross-device)"
      - "max(local, remote) merge strategy"

  useBeltLoader:
    purpose: "Progressive loading with belt-aware priority queue"
    source: "packages/player-vue/src/composables/useBeltLoader.ts"
    features:
      - "Three-layer loading (blocking/background/infinite)"
      - "P0 blocking loads current belt first 5 rounds"
      - "P1-P5 background loads next belts breadth-first"
      - "Enables skip-ahead without blocking"

  useOfflinePlay:
    purpose: "Infinite play resilience for OFFLINE only (online INF PLAY is the deterministic revival build — see v2.1.4)"
    source: "packages/player-vue/src/composables/useOfflinePlay.ts"
    features:
      - "Automatic online/offline detection"
      - "Shuffled playback from cached items — OFFLINE path only; online never shuffles (appendCachedLoopForOffline / enterInfPlayFromCache refuse to run online)"
      - "Recent item avoidance (no immediate repeats)"

  useLegoNetwork:
    purpose: "D3 force simulation for LEGO network (legacy)"
    source: "packages/player-vue/src/composables/useLegoNetwork.ts"

