# APML Interface: Insight Engine Specification
# SSI Learning App
# Version: 1.4.0 (2026-06-15)
# Status: Integrated — typecheck-green, admin chunk builds; 6 admin boards + a teacher-framed TeacherInsightsView (single RateCompare widget, scope-locked to their class/learner, /teacher-insights un-gated ?demo)

## ============================================================================
## OVERVIEW
## ============================================================================

SPECIFICATION:
  name: "Insight Engine"
  purpose: "Claude-directed admin analytics over a fixed widget library. A new insight is a composition (widget + data + story + graded actions), not a project."
  source: "packages/player-vue/src/insight/"
  surface: "/admin/insights (admin-gated: ssi_admin / god)"
  design_system: "Frostwell Courtyard (schools-surface), ECharts charts themed to the house palette"
  vision_doc: "docs/methodology/insight-engine.md ; gallery public/docs/insight-examples.html"

DESIGN_PHILOSOPHY:
  one_line: "The app renders from a declarative spec; Claude (or a board) emits the spec — no chart code per insight."
  principles:
    - "Spec is the contract: a question, a configured widget, the resolved data, and what you could do about it."
    - "Host fetches, wrapper is pure: a board resolves data and hands { data, isLoading, error } to a render-only wrapper."
    - "Two lenses never share a screen: frame routes Lens A (self/group — learner) vs Lens B (world/content — company); boards filter on frame."
    - "No hardcoded hex in components — Frostwell tokens + a centralised ECharts theme (theme.ts) carry every colour."

## ============================================================================
## THE SPEC CONTRACT (spec.ts — frozen spine)
## ============================================================================

SPEC_CONTRACT:
  source: "packages/player-vue/src/insight/spec.ts"
  note: "No runtime dependencies — typechecks alone. Imported read-only by every widget, resolver, and board."

  shared_vocabulary:
    Frame: "self | group | world | content   (self/group => Lens A · world/content => Lens B)"
    Order: "level | velocity | acceleration  (read curvature, not just level)"
    Tone:  "neutral | good | warn | alarm     (maps to a Frostwell tonal triplet in theme.ts; never a hex on the spec)"
    Entity: "string (open: learner | course | lego | seed | cohort | region | class | build | a concrete id)"
    Window: "string (open: 1d | 7d | 30d | 90d | all — parsed in the resolver)"

  DataQuery:
    description: "The composition Claude emits ({metric}×{entity}×{dims}×{frame}×{order}×{filter})."
    fields: "metric (registered MetricId), entity?, entityId?, frame?, order?, course?, window?, dimensions?, filter?"

  InsightSpec:
    generic: "InsightSpec<K extends WidgetKind> — widget + data co-vary at the board call-site (AnyInsightSpec is the tagged union)."
    fields:
      widget: "WidgetKind"
      query: "DataQuery — resolved by the registry to DataForKind<K>"
      frame: "routes Lens A vs Lens B"
      title: "the question"
      story: "the one-line read"
      annotate: "Annotation[] — the marks that ARE the story"
      actions: "Action[] — graded, owned, terminating footer"
      sovereignty: "required when widget==='sovereign-comparison' OR frame is self/group"
      tag: "widget label for the .fig-tag"

  Annotation:
    description: "Discriminated union by `at` — the WRONG target shape for a widget is a compile error."
    variants: "point | datum | stage | node | cell | row | region | band"

  Action:
    tier: "try | investigate | together   (graded by confidence × stakes)"
    owner: "popty | growth | product | marketing | you | you+claude"
    drill: "optional DataQuery — click re-scopes the SAME lens to a narrower entity"

  ResolvedInsight:
    shape: "{ data: WidgetData; isLoading: boolean; error: string | null }"
    note: "The bundle the host hands the wrapper. Every WidgetData variant is renderable-from-zero; a resolver NEVER throws."

## ============================================================================
## WIDGET LIBRARY (13 widgets + Stat)
## ============================================================================

WIDGET_LIBRARY:
  source: "packages/player-vue/src/insight/widgets/"
  contract: "props { data: <variant>, annotations?: Annotation[] }. Emits nothing. Renders ONLY the chart + annotation marks — the wrapper owns all chrome. Lazy-imports echarts in onMounted; ResizeObserver -> chart.resize(); colours from theme.ts."
  kinds:
    - "stat            — KPI tile (+ optional donut variant, e.g. build-SHA spread)"
    - "time-series     — line trend"
    - "ranked-bar      — horizontal/vertical ranked bars (standing-style)"
    - "sovereign-comparison — the 'standing' widget (Lens A; entity vs aggregate, k-floor)"
    - "distribution    — histogram bins"
    - "scatter         — difficulty × execution plane (scatter + effectScatter)"
    - "funnel          — staged funnel (e.g. trial → paid)"
    - "flow            — Sankey nodes + links"
    - "cohort-grid     — heatmap (retention cohorts OR friction map)"
    - "map             — choropleth by ISO country (ip_country)"
    - "table           — typed columns + tone rows"
    - "narrative-card  — the Discover card (pure HTML, no chart)"
    - "treemap         — course-value tiles (LTV-proxy)"
  charting: "ECharts ^5.5.0 (player-vue dependency, lazy-loaded, admin-only). Configs ported near-verbatim from public/docs/insight-examples.html."

## ============================================================================
## THE SEMANTIC SUBSTRATE — REGISTRY + RESOLVERS
## ============================================================================

REGISTRY:
  source: "packages/player-vue/src/insight/registry.ts"
  purpose: "metric id -> { def, resolver }. A metric is DEFINED + TESTED ONCE; two surfaces can never disagree about 'retention'. def.widget === K binds the resolver to Resolver<K> (a mismatched resolver is a compile error)."
  helpers:
    metricDef: "look up a MetricDef without loading the resolver chunk"
    resolveMetric: "resolve a DataQuery to a renderable WidgetData variant (lazy-imports data/<metric>.ts)"
  metrics:
    courseValue:      "treemap — LTV-proxy = reach × stickiness × retention, per course (data/courseValue.ts)"
    contentFriction:  "cohort-grid — per-unit skip-back + stall + drop-off + audio_failed; reuses analytics_friction_map (data/contentFriction.ts)"
    retention:        "time-series — days-active + return-rate 7/30/90d; reuses analytics_retention_cohorts (data/retention.ts)"
    health:           "stat — audio_failed rate, cacheHit, client_version + device spread; reuses analytics_overview (data/health.ts)"
    trialConversion:  "funnel — trial → paid; subscriptions has 0 rows today -> returns a well-formed zero-stage funnel (data/trialConversion.ts)"
    difficultyTurns:  "table — per-(learner,lego) local difficulty via the B4 curvature sensor; analytics_difficulty_turns (DRAFT migration), admin-only (data/difficultyTurns.ts)"
    coverage:         "table — the COVERAGE lane: the class as a learner (furthest LEGO, pace LEGOs/wk, dosage min/wk, efficiency LEGOs/min); group-by over class_sessions by class_id; analytics_class_coverage (DRAFT migration), admin-only; demo-first via demoCoverage() (data/coverage.ts)"

RESOLVER_CONTRACT:
  source: "packages/player-vue/src/insight/data/<metric>.ts"
  rules:
    - "Read-only. PREFER the analytics_* RPCs (SECURITY DEFINER, is_god_user-gated, anon-callable)."
    - "Mirror the proven useAnalytics* idiom: client.rpc(...), data || [], graceful catch."
    - "Return zeros/empties on no-data or a blocked read. NEVER throw."
    - "Client = useAdminClient().getClient() (anon-key reads suffice). NEVER write data from the app."
    - "A new raw read that PostgREST blocks -> author a NEW SECURITY DEFINER RPC as an UNAPPLIED migration file in supabase/migrations/."

## ============================================================================
## THE FOUR BEHAVIOURS (owned by the wrapper, not each widget)
## ============================================================================

INSIGHT_WIDGET_WRAPPER:
  source: "packages/player-vue/src/insight/InsightWidget.vue"
  props: "exactly two — spec: AnyInsightSpec, resolved: ResolvedInsight"
  dispatch: "import.meta.glob('./widgets/*.vue') + PascalCase naming. Dropping widgets/<Name>.vue makes a kind dispatchable with NO edit to the wrapper, registry, or spec."
  never: "touches Supabase. Renders loading/error/empty so widgets only ever see good data."

  behaviour_1_annotatable:
    what: "Claude marks the point/row/stage that IS the story (spec.annotate[]); the widget renders the marks, the wrapper also renders each note as a tone-coloured caption so the read travels even when a widget can't call out a mark."

  behaviour_2_interrogable:
    what: "A quiet 'why?' affordance that emits an 'interrogate' event."
    status: "Emits today; Phase 4 wires it to an explain call."

  behaviour_3_sovereign:
    what: "Any comparison is entity-vs-aggregate + a k-anonymity floor (default 5). NEVER a named peer in learner-facing data."
    gates: "resolver is the first gate (sets named only for admin identified-visibility); the wrapper is the second gate (suppresses any band below kFloor; renders names only when visibility==='identified' AND data.named)."

  behaviour_4_action_terminated_drillable:
    what: "A graded-actions footer (try / investigate / together + an owner). Action.drill re-scopes on click; the wrapper emits 'drill' / 'act' for the host to re-fetch & swap the spec."

## ============================================================================
## BOARDS (hand-authored compositions — no LLM call yet)
## ============================================================================

BOARDS:
  source: "packages/player-vue/src/insight/boards/"
  pattern: "Each board fetches its data on mount, builds InsightSpec literals (story + annotate + actions authored from the shape of the data), and renders <InsightWidget :spec :resolved> panels in a Frostwell grid. The board owns the page header + course/window pickers; the wrapper owns all widget chrome."
  CourseScoreboard:
    lens: "Lens B · company"
    question: "Which courses are creating real learner value, and where is growth coming from?"
    widgets: "2× stat (KPI) + treemap (course value) + ranked-bar (lifetime hours) + time-series (new learners / week)"
    data: "courseValue + retention metrics + analytics_growth RPC"
  ContentFrictionBoard:
    lens: "Lens B · quality"
    question: "Where does the curriculum hurt everyone?"
    widgets: "cohort-grid (friction heatmap, full width) + ranked-bar (top friction bands) + narrative-card (the editorial read + actions to Popty)"
    data: "contentFriction metric (per selected course)"
    law: "unit-concentrated hot cells = a quality problem, not a learner problem -> action terminates in Popty (re-split the LEGO)"
  HealthStrip:
    lens: "Lens B · ops"
    question: "Is audio breaking? Is my fix live?"
    widgets: "stat (audio_failed rate + cache-hit) + stat (build-SHA spread donut) + time-series (failure-rate trend)"
    data: "health metric (resolveHealthFull, per selected window 7d/14d/30d)"
  DifficultyTurnsBoard:
    lens: "Attention · per-pupil (admin-only — rows name learners / PII)"
    question: "Who's struggling, who just turned?"
    widgets: "table (Learner · LEGO · Signal · σ-vs-own-noise) — the loudest struggling turn annotated + graded actions (try/investigate/together)"
    data: "difficultyTurns metric — the B4 curvature sensor (@ssi/core assessLocalDifficulty) over each learner's persisted per-(learner,lego) latency series; analytics_difficulty_turns RPC, per selected window 30d/90d"
    law: "σ is measured against the learner's OWN baseline, not the cohort — the signal is personal, not a comparison; only the two actionable states (struggling ↑ / easing ↓) surface"
  RatesBoard:
    lens: "Rates · entity vs average (reusable across levels — learner / class / school / course)"
    question: "Any metric as a rate — how does this entity's rate compare to a chosen average cohort?"
    widgets: "ONE reusable composite widget (RateCompare.vue): big entity rate + delta-vs-average (▲/▼ %) + percentile chip + entity-vs-average comparison bars + small ECharts trend (RateTrend.vue, entity vs average, 8 periods) + an ANONYMISED distribution strip (privacy fix — the centrepiece: quartile band + unlabelled cohort points, marking only 'You' + the chosen average; NO other named entity, the old named cohort-league was removed) + a small secondary position contextLine"
    privacy: "An entity is compared ONLY to an aggregate/average, never to another named entity — enforced in the widget (getRateComparison returns an anonymised distribution; no other entity's name/label ever renders)."
    selectors: "Metric (6 HERO_RATES) · Entity (a learner/class/school/course LEVEL switch + an entity picker) · Average (the metric's swappable cohorts). Default: progressPace / a class entity / course avg."
    metrics: "6 HERO_RATES, all expressed as a RATE: progressPace (Rate of progress — LEGOs/wk, THE headline) · appMinutesDay (min/day) · newLegosHr (LEGOs/hr) · repeatsRatio (repeat:new/session) · interactionsMin (cycles/min) · daysActiveWk (days/wk)"
    data: "data/demoRates.ts — seeded mulberry32 synthetic population per (metric, level); getRateComparison(metric, level, entity, average) → RateComparisonData, total + deterministic + never throws. Real-path resolver is a TODO."
    demo_first: "DEMO short-circuits to demoRates (?demo) — ZERO database access. Without ?demo the board shows a 'preview with ?demo' note (no DB call), the resolver isn't wired yet."
    law: "RATE IS PRIMARY — rate of progress matters more than position; the rate leads, the furthest-LEGO position rides along only as the small secondary contextLine. Every interesting metric is a rate; the metric, the entity, and the average cohort are all swappable through ONE widget."
    data_type: "RateComparisonData lives in spec.ts as a COMPOSITE-widget type (NOT in the WidgetData union / NOT a registry kind) — RateCompare is a hand-composed board widget like HealthStrip, so the frozen 18-way spine union is untouched."
  CoverageBoard:
    lens: "Coverage · class-as-learner (the SECOND teaching-insights lane — tutor-insights.md §2–§3)"
    question: "Each class as a learner — coverage, pace, dosage, efficiency over wall-clock?"
    widgets: "table (Class · Course · Coverage · Pace · Active min/wk · Efficiency, primary, pace-sorted) + ranked-bar (classes by pace, derived) + narrative-card (fastest/slowest read); fastest annotated good, stalled annotated alarm; graded actions (investigate the stalled class / celebrate the top-pace class)"
    data: "coverage metric — a group-by over class_sessions by the clean class_id (zero new instrumentation, independent of Lane B); analytics_class_coverage RPC (DRAFT migration), per selected window 30d/90d"
    demo_first: "DEMO short-circuits to demoCoverage() — fully renderable with ZERO database access (?demo). Real path degrades to a well-formed empty state with a note until the analytics_class_coverage migration is applied."
    law: "Pace (coverage over wall-clock) is the headline — skip-ahead reads as mastery, not missing data. The class is durable, so the curve survives teacher churn. Roll up = same query at a higher GROUP BY (class → group → school → chain)."

## ============================================================================
## THE HOST + INTEGRATION
## ============================================================================

INSIGHTS_VIEW:
  source: "packages/player-vue/src/insight/InsightsView.vue"
  purpose: "The /admin/insights host — a board switcher rendering the six board components. RatesBoard ('Rate compare') is the first tab and the default activeBoard (most prominent)."
  layout: "Frostwell page header (schools-kicker + Arsenal h1 + subtitle) + a segmented board switcher + a lazily-mounted active board."
  lazy: "Boards are defineAsyncComponent imports, so the ECharts widget graph stays out of the initial admin chunk until a board is shown."

ROUTE:
  source: "packages/player-vue/src/router/index.ts"
  entry: "{ path: 'insights', name: 'admin-insights', component: () => import('@/insight/InsightsView.vue') } under the /admin parent (AdminContainer)."
  guard: "router.beforeEach gates everything under /admin via useUserRole().canAccessAdmin (ssi_admin / god)."

TOPBAR_TAB:
  source: "packages/player-vue/src/components/admin/AdminTopBar.vue"
  entry: "{ label: 'Insights', to: '/admin/insights', match: p => p.startsWith('/admin/insights') } — placed after Methodology."

TEACHER_INSIGHTS_VIEW:
  source: "packages/player-vue/src/insight/TeacherInsightsView.vue"
  purpose: "The schools-wide Stats surface — the calm, single-purpose opposite of the /admin/insights cockpit. Contains NOTHING but the entity-vs-average RateCompare widget. Serves ALL THREE schools roles (teacher, school_admin, govt_admin/group-leader), not just teachers — the file/route names predate the real wiring and are kept for now."
  reuse: "Reuses RateCompare.vue + RateTrend.vue unchanged — does NOT fork the widget. isInsightDemo() (../data/demo — the same ?demo gate CoverageBoard.vue uses) selects demo vs real."
  demo_path: "?demo — UNCHANGED: MY_CLASSES fixture + demoRates.ts, ZERO database access, full 6-HERO_RATES metric picker + class/learner drill + the AVERAGE_ESCALATION ladder."
  real_path: "REAL as of 2026-07-14 for the ONE flagship metric (rate of progress, LEGOs/week) at CLASS-entity granularity only. Classes come from useClassesData().fetchClasses() — already role-scoped (teacher: class_teachers membership; school_admin: their school; govt_admin: their group subtree) via the SAME fetch TeacherDashboard/DashboardView use, so the picker only ever offers classes in the caller's own scope. Data comes from GET /api/school/rate-compare (api/school/rate-compare.ts): resolveVisibleScope checks class_id is in-scope, then analytics_class_sessions_scoped (new RPC, service_role-only EXECUTE) returns raw session rows; api/_utils/rateCompare.ts derives window-pace, an 8-week trend, and the cohort distribution in TypeScript (mirrors coverage.ts's split). Compare-to is school / group / global average (never another named class) — the comparison cohort is resolved server-side from the entity's own school_id/group_id, never client input. K_FLOOR=5 (matches spec.ts Sovereignty.kFloor default): fewer than 5 active cohort classes -> insufficientData with an honest reason, no fabricated average. Deferred (not yet real): the other 5 HERO_RATES, the learner-level drill (needs the homework-sourced attention lane, tutor-insights.md §4), and a single school/group AGGREGATE entity (averaging across a school's classes that may span different courses isn't apples-to-apples; the roll-up instead lets any role pick any class in their scope, per tutor-insights.md §2's 'same query, higher GROUP BY' — the entity is always a class)."
  entry_points: "/schools/analytics (embedded=true inside SchoolsContainer) — already live in TopNav's baseTabs for every schools role (teachers/school_admin via hasSchoolRole, plus govt_admin). No new route needed; this is the pre-existing 'Analytics' tab, now backed by real data. /teacher-insights (top-level, un-gated) stays the un-authed ?demo preview URL."
  route: "{ path: '/teacher-insights', name: 'teacher-insights' } (standalone, ?demo preview) and { path: 'analytics', name: 'analytics' } under /schools (embedded, real for signed-in roles)."

