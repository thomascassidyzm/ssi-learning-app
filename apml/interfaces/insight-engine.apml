# APML Interface: Insight Engine Specification
# SSI Learning App
# Version: 1.7.0 (2026-08-20) — VAD FOLLOWS THE ORG HIERARCHY (founder ruling): the Voice & pause renderer is extracted to insight/VadPanel.vue and served by TWO doors — the admin whole-forest board and a new hierarchy-scoped GET /api/org/vad behind one authz predicate (api/_utils/vadVisibility.ts), rendered on the node insights surface for group leaders, school leaders and teachers
# Status: Integrated — typecheck-green, admin chunk builds; 7 admin boards + THE LENS (node-scoped engine on every node home) + a teacher-framed TeacherInsightsView (single RateCompare widget, scope-locked to their class/learner, /teacher-insights un-gated ?demo)

## ============================================================================
## OVERVIEW
## ============================================================================

SPECIFICATION:
  name: "Insight Engine"
  purpose: "Claude-directed admin analytics over a fixed widget library. A new insight is a composition (widget + data + story + graded actions), not a project."
  source: "packages/player-vue/src/insight/"
  surface: "/admin/insights (admin-gated: ssi_admin / god)"
  design_system: "Frostwell Courtyard (schools-surface), ECharts charts themed to the house palette"
  vision_doc: "docs/methodology/insight-engine.md ; gallery public/docs/insight-examples.html"

DESIGN_PHILOSOPHY:
  one_line: "The app renders from a declarative spec; Claude (or a board) emits the spec — no chart code per insight."
  principles:
    - "Spec is the contract: a question, a configured widget, the resolved data, and what you could do about it."
    - "Host fetches, wrapper is pure: a board resolves data and hands { data, isLoading, error } to a render-only wrapper."
    - "Two lenses never share a screen: frame routes Lens A (self/group — learner) vs Lens B (world/content — company); boards filter on frame."
    - "No hardcoded hex in components — Frostwell tokens + a centralised ECharts theme (theme.ts) carry every colour."

## ============================================================================
## THE SPEC CONTRACT (spec.ts — frozen spine)
## ============================================================================

SPEC_CONTRACT:
  source: "packages/player-vue/src/insight/spec.ts"
  note: "No runtime dependencies — typechecks alone. Imported read-only by every widget, resolver, and board."

  shared_vocabulary:
    Frame: "self | group | world | content   (self/group => Lens A · world/content => Lens B)"
    Order: "level | velocity | acceleration  (read curvature, not just level)"
    Tone:  "neutral | good | warn | alarm     (maps to a Frostwell tonal triplet in theme.ts; never a hex on the spec)"
    Entity: "string (open: learner | course | lego | seed | cohort | region | class | build | a concrete id)"
    Window: "string (open: 1d | 7d | 30d | 90d | all — parsed in the resolver)"

  DataQuery:
    description: "The composition Claude emits ({metric}×{entity}×{dims}×{frame}×{order}×{filter})."
    fields: "metric (registered MetricId), entity?, entityId?, frame?, order?, course?, window?, dimensions?, filter?"

  InsightSpec:
    generic: "InsightSpec<K extends WidgetKind> — widget + data co-vary at the board call-site (AnyInsightSpec is the tagged union)."
    fields:
      widget: "WidgetKind"
      query: "DataQuery — resolved by the registry to DataForKind<K>"
      frame: "routes Lens A vs Lens B"
      title: "the question"
      story: "the one-line read"
      annotate: "Annotation[] — the marks that ARE the story"
      actions: "Action[] — graded, owned, terminating footer"
      sovereignty: "required when widget==='sovereign-comparison' OR frame is self/group"
      tag: "widget label for the .fig-tag"

  Annotation:
    description: "Discriminated union by `at` — the WRONG target shape for a widget is a compile error."
    variants: "point | datum | stage | node | cell | row | region | band"

  Action:
    tier: "try | investigate | together   (graded by confidence × stakes)"
    owner: "popty | growth | product | marketing | you | you+claude"
    drill: "optional DataQuery — click re-scopes the SAME lens to a narrower entity"

  ResolvedInsight:
    shape: "{ data: WidgetData; isLoading: boolean; error: string | null }"
    note: "The bundle the host hands the wrapper. Every WidgetData variant is renderable-from-zero; a resolver NEVER throws."

## ============================================================================
## WIDGET LIBRARY (13 widgets + Stat)
## ============================================================================

WIDGET_LIBRARY:
  source: "packages/player-vue/src/insight/widgets/"
  contract: "props { data: <variant>, annotations?: Annotation[] }. Emits nothing. Renders ONLY the chart + annotation marks — the wrapper owns all chrome. Lazy-imports echarts in onMounted; ResizeObserver -> chart.resize(); colours from theme.ts."
  kinds:
    - "stat            — KPI tile (+ optional donut variant, e.g. build-SHA spread)"
    - "time-series     — line trend"
    - "ranked-bar      — horizontal/vertical ranked bars (standing-style)"
    - "sovereign-comparison — the 'standing' widget (Lens A; entity vs aggregate, k-floor)"
    - "distribution    — histogram bins"
    - "scatter         — difficulty × execution plane (scatter + effectScatter)"
    - "funnel          — staged funnel (e.g. trial → paid)"
    - "flow            — Sankey nodes + links"
    - "cohort-grid     — heatmap (retention cohorts OR friction map)"
    - "map             — choropleth by ISO country (ip_country)"
    - "table           — typed columns + tone rows"
    - "narrative-card  — the Discover card (pure HTML, no chart)"
    - "treemap         — course-value tiles (LTV-proxy)"
  charting: "ECharts ^5.5.0 (player-vue dependency, lazy-loaded, admin-only). Configs ported near-verbatim from public/docs/insight-examples.html."

## ============================================================================
## THE SEMANTIC SUBSTRATE — REGISTRY + RESOLVERS
## ============================================================================

REGISTRY:
  source: "packages/player-vue/src/insight/registry.ts"
  purpose: "metric id -> { def, resolver }. A metric is DEFINED + TESTED ONCE; two surfaces can never disagree about 'retention'. def.widget === K binds the resolver to Resolver<K> (a mismatched resolver is a compile error)."
  helpers:
    metricDef: "look up a MetricDef without loading the resolver chunk"
    resolveMetric: "resolve a DataQuery to a renderable WidgetData variant (lazy-imports data/<metric>.ts)"
  metrics:
    courseValue:      "treemap — LTV-proxy = reach × stickiness × retention, per course (data/courseValue.ts)"
    contentFriction:  "cohort-grid — per-unit skip-back + stall + drop-off + audio_failed; reuses analytics_friction_map (data/contentFriction.ts)"
    retention:        "time-series — days-active + return-rate 7/30/90d; reuses analytics_retention_cohorts (data/retention.ts)"
    health:           "stat — audio_failed rate, cacheHit, client_version + device spread; reuses analytics_overview (data/health.ts)"
    trialConversion:  "funnel — trial → paid; subscriptions has 0 rows today -> returns a well-formed zero-stage funnel (data/trialConversion.ts)"
    difficultyTurns:  "table — per-(learner,lego) local difficulty via the B4 curvature sensor; analytics_difficulty_turns (DRAFT migration), admin-only (data/difficultyTurns.ts)"
    coverage:         "table — the COVERAGE lane: the class as a learner (furthest LEGO, pace LEGOs/wk, dosage min/wk, efficiency LEGOs/min); group-by over class_sessions by class_id; analytics_class_coverage (DRAFT migration), admin-only; demo-first via demoCoverage() (data/coverage.ts)"

RESOLVER_CONTRACT:
  source: "packages/player-vue/src/insight/data/<metric>.ts"
  rules:
    - "Read-only. PREFER the analytics_* RPCs (SECURITY DEFINER, is_god_user-gated, anon-callable)."
    - "Mirror the proven useAnalytics* idiom: client.rpc(...), data || [], graceful catch."
    - "Return zeros/empties on no-data or a blocked read. NEVER throw."
    - "Client = useAdminClient().getClient() (anon-key reads suffice). NEVER write data from the app."
    - "A new raw read that PostgREST blocks -> author a NEW SECURITY DEFINER RPC as an UNAPPLIED migration file in supabase/migrations/."

## ============================================================================
## THE FOUR BEHAVIOURS (owned by the wrapper, not each widget)
## ============================================================================

INSIGHT_WIDGET_WRAPPER:
  source: "packages/player-vue/src/insight/InsightWidget.vue"
  props: "exactly two — spec: AnyInsightSpec, resolved: ResolvedInsight"
  dispatch: "import.meta.glob('./widgets/*.vue') + PascalCase naming. Dropping widgets/<Name>.vue makes a kind dispatchable with NO edit to the wrapper, registry, or spec."
  never: "touches Supabase. Renders loading/error/empty so widgets only ever see good data."

  behaviour_1_annotatable:
    what: "Claude marks the point/row/stage that IS the story (spec.annotate[]); the widget renders the marks, the wrapper also renders each note as a tone-coloured caption so the read travels even when a widget can't call out a mark."

  behaviour_2_interrogable:
    what: "A quiet 'why?' affordance that emits an 'interrogate' event."
    status: "Emits today; Phase 4 wires it to an explain call."

  behaviour_3_sovereign:
    what: "Any comparison is entity-vs-aggregate + a k-anonymity floor (default 5). NEVER a named peer in learner-facing data."
    gates: "resolver is the first gate (sets named only for admin identified-visibility); the wrapper is the second gate (suppresses any band below kFloor; renders names only when visibility==='identified' AND data.named)."

  behaviour_4_action_terminated_drillable:
    what: "A graded-actions footer (try / investigate / together + an owner). Action.drill re-scopes on click; the wrapper emits 'drill' / 'act' for the host to re-fetch & swap the spec."

## ============================================================================
## BOARDS (hand-authored compositions — no LLM call yet)
## ============================================================================

BOARDS:
  source: "packages/player-vue/src/insight/boards/"
  pattern: "Each board fetches its data on mount, builds InsightSpec literals (story + annotate + actions authored from the shape of the data), and renders <InsightWidget :spec :resolved> panels in a Frostwell grid. The board owns the page header + course/window pickers; the wrapper owns all widget chrome."
  CourseScoreboard:
    lens: "Lens B · company"
    question: "Which courses are creating real learner value, and where is growth coming from?"
    widgets: "2× stat (KPI) + treemap (course value) + ranked-bar (lifetime hours) + time-series (new learners / week)"
    data: "courseValue + retention metrics + analytics_growth RPC"
  ContentFrictionBoard:
    lens: "Lens B · quality"
    question: "Where does the curriculum hurt everyone?"
    widgets: "cohort-grid (friction heatmap, full width) + ranked-bar (top friction bands) + narrative-card (the editorial read + actions to Popty)"
    data: "contentFriction metric (per selected course)"
    law: "unit-concentrated hot cells = a quality problem, not a learner problem -> action terminates in Popty (re-split the LEGO)"
  HealthStrip:
    lens: "Lens B · ops"
    question: "Is audio breaking? Is my fix live?"
    widgets: "stat (audio_failed rate + cache-hit) + stat (build-SHA spread donut) + time-series (failure-rate trend)"
    data: "health metric (resolveHealthFull, per selected window 7d/14d/30d)"
  DifficultyTurnsBoard:
    lens: "Attention · per-pupil (admin-only — rows name learners / PII)"
    question: "Who's struggling, who just turned?"
    widgets: "table (Learner · LEGO · Signal · σ-vs-own-noise) — the loudest struggling turn annotated + graded actions (try/investigate/together)"
    data: "difficultyTurns metric — the B4 curvature sensor (@ssi/core assessLocalDifficulty) over each learner's persisted per-(learner,lego) latency series; analytics_difficulty_turns RPC, per selected window 30d/90d"
    law: "σ is measured against the learner's OWN baseline, not the cohort — the signal is personal, not a comparison; only the two actionable states (struggling ↑ / easing ↓) surface"
  RatesBoard:
    lens: "Rates · entity vs average (reusable across levels — learner / class / school / course)"
    question: "Any metric as a rate — how does this entity's rate compare to a chosen average cohort?"
    widgets: "ONE reusable composite widget (RateCompare.vue): big entity rate + delta-vs-average (▲/▼ %) + percentile chip + entity-vs-average comparison bars + small ECharts trend (RateTrend.vue, entity vs average, 8 periods) + an ANONYMISED distribution strip (privacy fix — the centrepiece: quartile band + unlabelled cohort points, marking only 'You' + the chosen average; NO other named entity, the old named cohort-league was removed) + a small secondary position contextLine"
    privacy: "An entity is compared ONLY to an aggregate/average, never to another named entity — enforced in the widget (getRateComparison returns an anonymised distribution; no other entity's name/label ever renders)."
    selectors: "Metric (6 HERO_RATES) · Entity (a learner/class/school/course LEVEL switch + an entity picker) · Average (the metric's swappable cohorts). Default: progressPace / a class entity / course avg."
    metrics: "6 HERO_RATES, all expressed as a RATE: progressPace (Rate of progress — LEGOs/wk, THE headline) · appMinutesDay (min/day) · newLegosHr (LEGOs/hr) · repeatsRatio (repeat:new/session) · interactionsMin (cycles/min) · daysActiveWk (days/wk)"
    data: "data/demoRates.ts — seeded mulberry32 synthetic population per (metric, level); getRateComparison(metric, level, entity, average) → RateComparisonData, total + deterministic + never throws. Real-path resolver is a TODO."
    demo_first: "DEMO short-circuits to demoRates (?demo) — ZERO database access. Without ?demo the board shows a 'preview with ?demo' note (no DB call), the resolver isn't wired yet."
    law: "RATE IS PRIMARY — rate of progress matters more than position; the rate leads, the furthest-LEGO position rides along only as the small secondary contextLine. Every interesting metric is a rate; the metric, the entity, and the average cohort are all swappable through ONE widget."
    data_type: "RateComparisonData lives in spec.ts as a COMPOSITE-widget type (NOT in the WidgetData union / NOT a registry kind) — RateCompare is a hand-composed board widget like HealthStrip, so the frozen 18-way spine union is untouched."
  VadPanel:
    file: "insight/VadPanel.vue — the ONE Voice & pause renderer, lifted verbatim out of VadBoard on 2026-08-20 when VAD stopped being admin-only. It takes a SUMMARY (from summariseVad) and has NO opinion about who may see what; that opinion lives server-side, once. Two data doors, one renderer: two copies of an honesty rule is where the honesty rots."
    consumers: "boards/VadBoard.vue (admin whole-forest read) and views/admin/NodeInsightsView.vue (hierarchy-scoped node read)"
  vad_hierarchy:
    ruling: "Founder, 2026-08-20, verbatim: 'no, the VAD data should follow the same hierarchy of visibility that all data follows / students < teachers < school leaders < group leaders / as long as the hierarchy is legitimate, the data should be viewable.' VAD is ORDINARY ORG DATA — not a special class with its own gate."
    predicate: "api/_utils/vadVisibility.ts — ONE predicate, deliberately thin because it COMPOSES the two existing resolvers rather than inventing a third authz model: resolveVisibleScope (schoolScope.ts) for the learner set (teacher -> own classes, school_admin -> own school, govt_admin -> own subtree), and leaderGroupIdFor + isWithinLeaderSubtree for the node. ssi_admin sees the forest; a learner sees themselves; nobody sees sideways or upwards."
    teacher_note: "resolveGroupTreeCaller deliberately rejects a plain teacher (node surfaces gate on the educational_role, not on mere school membership). A teacher reaches their own students' VAD through CLASS MEMBERSHIP instead — resolveVisibleScope's class set — so the ruling is honoured WITHOUT widening the node-surface leader gate."
    endpoint: "GET /api/org/vad?groupId= | ?classId= | ?learnerId= (api/org/vad.ts). ?groupId= accepts a group id, a school id OR a class id, resolved with the SAME precedence as api/groups/[id]/home.ts so the two endpoints can never disagree about what one :id means. Returns the FULL roster plus only the rows that exist, so hide-don't-zero survives the wire; the client shapes it with the SAME summariseVad the admin board uses (insight/data/vadScope.ts is an adapter, not a second analysis)."
    surface: "views/admin/NodeInsightsView.vue — a Voice & pause section beneath the rate engine, on /org/:id/insights (member) and its admin twins (/admin/groups|schools/:id/analytics, /admin/classes/:id/insights). It lands there because insights is already the lens on the node and this is an insight about the node — no new page. A 403 is STATED plainly rather than hiding the section (a section that vanishes reads as 'no data'). Learner rows are not clickable on the member surface, where the per-learner page does not exist (founder ruling 2026-07-19)."
    rls: "No RLS policy was touched. This is the server-mediated door the RLS doctrine calls for — own-row in the policy, hierarchy authz in an endpoint with tests. learner_lego_metrics moved server-side for non-admins for the same reason prosody already was: a leader's own JWT is own-row on it too."
    verified: "Live walk 2026-08-20 against the IME Demo Programme with the shipped predicate (api/_utils/vadVisibility.live.test.ts, gated on VAD_LIVE=1): programme leader -> 381 learners / 24 classes; Sunrise Pune node -> 82 learners, 42 with VAD mastery (51%), 777 prosody events; another org's leader -> 403; Sunrise school leader -> own school yes, sibling school no, programme no; uptake 181 of 381 (the gap is real)."
  VadBoard:
    lens: "Attention · voice (the ADMIN door — the whole-forest roster and its school picker. The renderer itself is VadPanel, shared with the scoped node surfaces since 2026-08-20.)"
    question: "Of the learners in this class/school, how many have mic-derived data at all — and what does it say about the ones who do?"
    widgets: "an UPTAKE tile (the fraction, first and biggest — 'N of M learners have mic-derived data') + ranked-bar (adaptive-pause mastery mix: mastered/confident/consolidating/acquisition) + distribution (per-learner mean normalised latency, ms per character) + table (uptake class by class) + a native prosody metric panel + a native click-through learner table (row -> /admin/users/<learnerId>, the per-learner 'Adaptive pause mastery' section that already renders)"
    data: "data/vadUptake.ts — a DIRECT browser read of learner_lego_metrics, joined to the roster via schools -> classes -> user_tags(tag_type='class', tag_value='CLASS:<id>') -> learners.user_id, all keyed on learners.id. This direct read works because the caller is an ssi_admin; the SCOPED surfaces use data/vadScope.ts -> GET /api/org/vad instead (see vad_hierarchy). Prosody comes from GET /api/admin/vad-prosody (see prosody_door)."
    prosody_door: "GET /api/admin/vad-prosody (api/admin/vad-prosody.ts) returns ONE per-learner aggregate of cycle_prosody — counts and sums with their own bases, never per-event rows and never the envelope contour. It exists because player_events is OWN-ROW under RLS for everyone INCLUDING ssi_admins: verified live 2026-08-12 with a real admin JWT, learner_lego_metrics returned another learner's 65 rows while player_events returned 0 of their 321. That same block, not the analytics exclusion, is why 'Recent activity' reads 0 for demo learners on the admin user page. The RLS posture is untouched — this is the server-mediated door the RLS doctrine calls for. When the endpoint fails the panel STATES the gap rather than rendering dashes or zeroes. SINCE 2026-08-20 it is HIERARCHY-SCOPED rather than ssi_admin-only (resolveVadCaller): admin gets every learner unchanged, a leader or teacher gets the learners inside their own scope, a learner gets themselves, and a caller who can see nobody gets an EMPTY result rather than a 403 (an empty scope must not be indistinguishable from a broken one). The read + fold live in api/_utils/vadProsody.ts, shared with GET /api/org/vad — one implementation, one place aggregates-only could ever be broken."
    why_direct: "A deliberate policy migration excludes every demo learner from all analytics_* aggregates, so a board built on the rollups filters this telemetry straight back out (that is why DifficultyTurnsBoard shows none of it). This board therefore reads the two tables directly, exactly as composables/admin/useAdminUserDetail.ts does for one learner. The exclusion policy is untouched."
    identity: "player_events.user_id is uuid but holds learners.id, NOT the auth uid (CLAUDE.md canonical pattern) — prosody is keyed on learners.id throughout."
    law: "UPTAKE IS THE INSIGHT, NOT MISSING DATA. Roughly half the demo learners carry no row whatsoever in the VAD-fed tables — not zeros, nothing. Every aggregate states the denominator it was actually taken over; a learner with no rows is counted in the total and excluded from every average, never averaged in as a zero. A scope with zero VAD learners renders an explicit 'no learner here has mic-derived data yet' state, never an empty chart."
    naming_honesty: "learner_lego_metrics.mean_latency_ms is a MISNOMER — the value is normalised latency in milliseconds PER CHARACTER of the target phrase (@ssi/core MetricsTracker.normalizeLatency). Every user-facing label on this board says 'ms/char'."
    prosody_claims: "Only what the cycle_prosody payload carries: peak / average energy (dB), envelope peak count, startedDuringPrompt rate, stillSpeakingAtVoice1 rate — each with its own event base. The 128-point envelope contour is deliberately NOT fetched (scalar JSON projections only)."
    defaults: "Opens on the school with the most VAD-carrying learners (so the board lands populated), whole-school scope, with a class chip row beneath."
  CoverageBoard:
    lens: "Coverage · class-as-learner (the SECOND teaching-insights lane — tutor-insights.md §2–§3)"
    question: "Each class as a learner — coverage, pace, dosage, efficiency over wall-clock?"
    widgets: "table (Class · Course · Coverage · Pace · Active min/wk · Efficiency, primary, pace-sorted) + ranked-bar (classes by pace, derived) + narrative-card (fastest/slowest read); fastest annotated good, stalled annotated alarm; graded actions (investigate the stalled class / celebrate the top-pace class)"
    data: "coverage metric — a group-by over class_sessions by the clean class_id (zero new instrumentation, independent of Lane B); analytics_class_coverage RPC (DRAFT migration), per selected window 30d/90d"
    demo_first: "DEMO short-circuits to demoCoverage() — fully renderable with ZERO database access (?demo). Real path degrades to a well-formed empty state with a note until the analytics_class_coverage migration is applied."
    law: "Pace (coverage over wall-clock) is the headline — skip-ahead reads as mastery, not missing data. The class is durable, so the curve survives teacher churn. Roll up = same query at a higher GROUP BY (class → group → school → chain)."

## ============================================================================
## THE HOST + INTEGRATION
## ============================================================================

INSIGHTS_VIEW:
  source: "packages/player-vue/src/insight/InsightsView.vue"
  purpose: "The /admin/insights host — a board switcher rendering the six board components. RatesBoard ('Rate compare') is the first tab and the default activeBoard (most prominent)."
  layout: "Frostwell page header (schools-kicker + Arsenal h1 + subtitle) + a segmented board switcher + a lazily-mounted active board."
  lazy: "Boards are defineAsyncComponent imports, so the ECharts widget graph stays out of the initial admin chunk until a board is shown."

ROUTE:
  source: "packages/player-vue/src/router/index.ts"
  entry: "{ path: 'insights', name: 'admin-insights', component: () => import('@/insight/InsightsView.vue') } under the /admin parent (AdminContainer)."
  guard: "router.beforeEach gates everything under /admin via useUserRole().canAccessAdmin (ssi_admin / god)."

TOPBAR_TAB:
  source: "packages/player-vue/src/components/admin/AdminTopBar.vue"
  entry: "{ label: 'Insights', to: '/admin/insights', match: p => p.startsWith('/admin/insights') } — placed after Methodology."

THE_LENS_NODE_SCOPED_ENGINE:
  source: "packages/player-vue/src/insight/NodeRateEngine.vue + packages/player-vue/src/views/admin/NodeInsightsView.vue + api/groups/[id]/rate-compare.ts"
  ruling: "Founder 2026-07-19 (THE LENS, phase 3 of the unification): the Insight Engine becomes the analytics lens of NODE HOME. 'See insights' on every node opens the engine with the ENTITY pre-filled = that node and COMPARE-TO defaulting to the PARENT's average — the compare-to chain IS the map rail's ancestor path (class -> school avg -> region avg -> country -> global), derived from the tree. The admin Stats page stays as the power-user home of all lenses; the node entry is the scoped door into the same engine, not a fork."
  endpoint: "GET /api/groups/:id/rate-compare — resolves :id exactly like /api/groups/:id/home (group node / school id via schools.node_group_id / class id). ONE response carries picker OPTIONS (courses below the node sorted active-first — busiest by the node's own recent practice, dataless courses flagged hasData:false and listed last so a manual pick is never blind; the ancestor chain nearest-first + global/this-course + global/all-courses) AND the resolved comparison — one round trip, deep-linkable (?course_code=&compare_to=). Server resolves defaults: course = the node's busiest by RECENT ACTIVITY (30d ranks, 365d marks hasData, tie alphabetical — founder rule 2026-07-20, NEVER class count, which opened dataless-course landings like Coastal Districts on eng_for_hin), preferring the highest-ranked active course whose ancestor-compare cohort clears the k-floor (one scope-wide RPC, rows reused for the final comparison); compare = parent's average, and when the DEFAULT compare's cohort misses the floor it LADDERS — global · this course, then global · all courses (generalises the old root-only auto-widen, 2026-07-20: a node whose peers share none of its courses, e.g. Metro International under an eng_for_* programme, still opens on a real comparison; intermediate ancestors are skipped because their this-course cohorts are subsets of global's; explicit compare picks never ladder and keep their named empty state; entity value stays anchored to the selected course — only the cohort widens). Ranking horizons are window-independent, so switching windows never re-defaults the course. A node with classes but zero practice on every course gets the named empty state ('No practice recorded below this level yet.' / '…in this class yet.'), never the generic compare message. Shared math: api/_utils/rateCompare.ts primitives over analytics_class_sessions_scoped (unchanged). Cohort member unit = peers-like-me: classes when the entity is a class, schools when it is a school node or interior group (school spread is the k-clearable unit above class). Authz doors: ssi_admin (any node, K floor 1 — admins already hold row access; K_FLOOR would blank the tool at current scale while protecting nothing); DEMO entities also hold floor 1 for every caller (2026-07-20: a demo cohort is demo-only by construction via schoolIdsInWorld — seeded fictional schools; K_FLOOR=5 blanked every demo leader surface while protecting nobody); leaders/school admins/teachers via resolveVisibleScope (class -> classIds, school node -> own school in schoolIds via ownSchoolIdForNode, group -> governed group or strict descendant), K_FLOOR=5 held in full + coverage-expired gate. Cohorts leave the server only as aggregates + the anonymised distribution — never a peer's name or id (pinned in tests)."
  engine_component: "NodeRateEngine.vue — the ONE engine component both admin and teacher surfaces mount. Props: nodeId, v-model course/compare (server-resolved defaults reflected back up so wrappers can mirror the URL query), plainWords (design law §1.12 — 'School average', 'Everyone on this course', 'All SSi learners · all courses'; never 'entity'/'cohort'/'node' in teacher-facing copy), getToken. Registers its loader with useDashboardRefresh (the ONE refresh protocol — no polling) but input changes call the loader DIRECTLY: the singleton's in-flight guard is for the button, and routing initial loads through it let a ghost instance's refresh swallow the fresh instance's only load (the first-load-fails-then-refresh-works bug, fixed 2026-07-19). Cold load is ONE round trip, pinned in tests: the engine remembers the last server-applied {nodeId, course, compare} and treats the wrapper's URL-mirror echo of those values (null prop = server default) as a no-op instead of refetching; a latest-request-wins seq guard covers overlapping fetches. Carries the --rc-* role tokens on its root so RateCompare reads identically wherever it mounts. Honest states: loading / re-login / insufficient (pickers stay so the user can widen the comparison) / fetch-failed."
  course_labels: "The engine NEVER prints a raw course code. Labels come from @ssi/core's courses/displayName.ts — the single source of truth: courseShortName(code) for the target language alone ('Welsh (South)'), courseDisplayName(code) for the full 'Welsh (South) for English speakers'. The engine's FIXED single-course field (shown when the node has exactly one course, so there is nothing to disambiguate against) uses the SHORT form; the course PICKER keeps the full form, because a node running eng_for_hin alongside eng_for_tam would otherwise show 'English' twice. Founder-reported 2026-08-07: Insights printed 'Cym_s_for_eng' where the Classes page correctly said 'Welsh (South)' — courseDisplayName's target pattern was ^[a-z]{2,3}$, so every dialect course missed the match and fell through to the Title-case-the-raw-code fallback. The language slot now admits an optional 1-3 char variant suffix and languageName brackets it (cym_s -> 'Welsh (South)'), matching the words useI18n's getLanguageName already renders — which is why Classes was right and Insights was not."
  admin_mounts: "NodeInsightsView.vue — since founder pass A (2026-07-19) it keeps the NODE-HOME CHROME: the WHERE-YOU-ARE map rail (NodeMapRail, you-are-here lit, fed by one GET /api/groups/:id/home fetch) + the same identity header grammar (kicker '<Label> · Insights', node name). The '← Back to group/class home' link pattern is DEAD — the rail is the way around; the verbs corner offers 'Overview' (node home) and 'All boards' (/admin/stats) the same way node home offers 'See insights'. Mounted at the OLD analytics URLs — /admin/schools/:id/analytics and /admin/groups/:id/analytics (the URLs live, the old-school AnalyticsView.vue page DIED — deleted) — plus /admin/classes/:id/insights (AdminClassInsights.vue shell, same admin-gate + AdminTopBar pattern as AdminClassHome). NodeHomeView's verb row: 'See analytics'/'Class tools' became 'See insights' on EVERY node (the class-level 'Class tools' secondary verb died with the admin Class tools page — founder ruling 2026-07-19)."

TEACHER_INSIGHTS_VIEW:
  source: "packages/player-vue/src/insight/TeacherInsightsView.vue"
  purpose: "REBUILT 2026-07-19 (THE LENS, phase 3) as a thin plain-words wrapper over NodeRateEngine.vue — the same one engine component the admin surfaces mount. Serves ALL THREE schools roles (teacher, school_admin, govt_admin/group-leader), not just teachers — the file/route names predate the real wiring and are kept for now. Owns exactly ONE control the engine doesn't have: a 'Your classes' picker sourced from GET /api/me/teaching-context's classes_detail. Course, compare-to, the metric readout and the widget are entirely NodeRateEngine's — this view never forks them."
  reuse: "Mounts NodeRateEngine.vue with :plain-words=\"true\" — does NOT fork the widget or its controls. Killed: the ?demo fixture fork (MY_CLASSES + demoRates.ts), the useClassesData/useSchoolContext/useSchoolData plumbing, and the direct GET /api/school/rate-compare fetch — all pre-MODEL. demoRates.ts itself is untouched (still used by RatesBoard.vue in the admin cockpit)."
  data_source: "GET /api/me/teaching-context (THE-MODEL.md §6's one capability read) — extended additively 2026-07-19 with classes_detail: [{id, name, course_code}] and groups_detail: [{id, label, name}] alongside the original byte-identical groups/classes/can_play_as_class fields, so this view gets class names + the owning school/group's name in the same round trip it already needed for the teacher-shell gate. The selected class id is passed straight through as NodeRateEngine's node-id — GET /api/groups/:id/rate-compare resolves a class id, authorizes the caller via resolveVisibleScope's classIds, and returns the picker options (courses, ancestor compare chain) + the resolved comparison in one round trip. This is what kills the em-dash-title / stale-school-name bug at the root: there is no separate useSchoolContext school-name lookup left to desync from the engine's own resolution."
  header: "Plain words per design law §1.12: kicker 'Your class', title '<owning school/group name> · <class name>' (or just the class name for a groupless tutor), subtitle 'How your class is doing, compared with the average.' Never 'entity'/'cohort'/'node' — pinned by test."
  deep_links: "?course= / ?compare= mirror NodeRateEngine's v-model state (server-resolved defaults reflected back, same pattern as NodeInsightsView.vue). ?class= selects among the caller's OWN classes.only (classes_detail) — an id outside that set is ignored and the first own class is used instead, never another teacher's class. The old ?scope=learner&name=<display> deep link (from the Students table) is handled honestly: shows the class view with a quiet note that per-learner rates aren't available yet, rather than the old seeded per-learner preview."
  empty_states: "Loading teaching-context / a missing session ('Sign in to see your class's rate') / a failed fetch / zero classes ('No classes yet — once you have a class with sessions, it compares here.') are this view's own honest states, shown BEFORE the engine mounts (no node id to give it yet). Once a class is selected, NodeRateEngine's own honest states (loading / re-login / insufficient / fetch-failed) take over."
  entry_points: "/schools/analytics (embedded=true inside SchoolsContainer) — live in TopNav's baseTabs / SchoolsTopBar for teachers. NOT for group-scoped govt_admins (nav unification, 2026-07-29) NOR school-scoped school_admins (third persona, 2026-07-30): their Insights door is the node insights (/schools/org/:id/insights for their group / school node); a deep link to /schools/analytics redirects there via SchoolsContainer (this view is class-scoped — it showed a confidently-wrong 'No classes yet' to a group leader). Legacy no-group govt_admin and no-school school_admin rows still reach it. /teacher-insights (top-level, un-gated) is now the same real wrapper standalone — the old un-authed ?demo preview is gone; an unauthenticated visit shows the honest sign-in state."
  route: "{ path: '/teacher-insights', name: 'teacher-insights' } (standalone) and { path: 'analytics', name: 'analytics' } under /schools (embedded) — both real, both backed by teaching-context + NodeRateEngine."

