# APML Engine: Cycle Orchestrator Specification
# SSI Learning App
# Version: 2.0.0 (2026-06-08)
# Status: Production-ready — reconciled to live implementation
# Last updated: 2026-06-30

## ============================================================================
## OVERVIEW
## ============================================================================

SPECIFICATION:
  name: "Cycle Orchestrator (4-phase learning cycle)"
  purpose: "State machine for the 4-phase prompt-response learning cycle"
  version: "2.0.0"

  ⚠️ SUPERSEDED_CLASS:
    old: "@ssi/core CycleOrchestrator (packages/core/src/engine/CycleOrchestrator.ts)"
    status: "DELETED — the single-class orchestrator no longer exists"
    note: |
      The @ssi/core CycleOrchestrator + AudioController + RobustAudioController
      classes were removed. The 4-phase cycle logic now lives entirely in the
      player-vue package. This spec documents that LIVE implementation. The
      ICycleOrchestrator / IAudioController INTERFACES and the CyclePhase /
      TEXT_VISIBILITY enums in packages/core/src/engine/types.ts are KEPT
      (the interface shape is still useful; the concrete class is gone).

  live_implementation:
    primary_engine: "packages/player-vue/src/playback/SimplePlayer.ts"
    primary_composable: "packages/player-vue/src/composables/useSimplePlayer.ts"
    single_cycle_helper: "packages/player-vue/src/composables/useCyclePlayback.ts"
    audio_controller: "RealAudioController class (defined inline in packages/player-vue/src/components/LearningPlayer.vue)"
    kept_types: "packages/core/src/engine/types.ts (CyclePhase enum, TEXT_VISIBILITY map, IAudioController/ICycleOrchestrator interfaces)"
    pause_formula: "packages/player-vue/src/playback/computePauseDuration.ts"
    docs: "docs/cold-start-and-playback.md (live, traced 2026-06-08); docs/buffer-model.md (superseded design, never built)"

  WHICH_ENGINE_RUNS_WHAT:
    SimplePlayer:
      role: "PRIMARY live engine — owns the round/cycle queue and the phase walk"
      drives: "the main learning loop (every belt round, pods, listening, bookends)"
      driven_by: "simplePlayer.play() / resume() in LearningPlayer.vue, via useSimplePlayer"
      phase_machine: "idle → (buffering) → prompt → pause → voice1 → voice2 → next cycle"
    useCyclePlayback:
      role: "Single-cycle helper (playCycle(cycle, getAudioSource))"
      drives: "narrower paths — intro-advance / session-based (demo) progression / next-item follow-on (startCyclePlayback in LearningPlayer.vue)"
      phase_machine: "IDLE → PROMPT → PAUSE → VOICE_1 → VOICE_2 → IDLE (no buffering phase, no round queue)"
    RealAudioController:
      role: "Thin wrapper over the single reusable <audio> element (mobile-unlock-safe), preload LRU, cache-first URL resolution"
      note: "Replaces the deleted @ssi/core AudioController + RobustAudioController"

CORE_PRINCIPLE: |
  The learning cycle is the fundamental unit of SSI methodology.
  Each cycle takes a learner through PROMPT → PAUSE → VOICE_1 → VOICE_2.
  Text visibility is carefully controlled to force recall, not reading.
  Audio and text are bound by ID inside an immutable Cycle object (see the
  January 2026 Cycle refactor) — never looked up by text string at runtime.

## ============================================================================
## THE 4-PHASE LEARNING CYCLE
## ============================================================================

CYCLE_PHASES:
  description: |
    Every learning item goes through (up to) 4 audible phases in fixed order.
    The phases are designed to maximize active recall and minimize passive reading.
    SimplePlayer adds a guard phase 'buffering' BEFORE prompt (not a 5th playback
    phase — see STATE_MACHINE) and an optional post-voice2 'linger' hold.

  PHASE_1_PROMPT:
    name: "PROMPT"  # SimplePlayer Phase: 'prompt'
    purpose: "Play known language audio to prompt learner"
    sequence: 1
    duration: "Audio duration of known phrase"

    audio:
      plays: "known language audio (cycle.known.audioUrl)"
      example: "I want coffee"

    text_visibility:
      known: true
      target: false
      rationale: "Show what to translate, hide the answer"

    learner_action: "Listen and prepare to speak"

    next_phase: "PAUSE (or VOICE_1 directly for intro cycles where pauseDuration === 0)"

  PHASE_2_PAUSE:
    name: "PAUSE"  # SimplePlayer Phase: 'pause'
    purpose: "Gap for learner to attempt target language"
    sequence: 2
    duration: "Dynamic — computePauseDuration(t1, t2, modeConfig)"

    audio:
      plays: "A genuinely-silent real-PCM one-shot WAV clip on the MAIN audio element"
      why: |
        CRITICAL (SimplePlayer.startPausePhase + silentWav.ts): the pause is NOT
        a bare setTimeout. It plays SILENT_PAUSE_CLIP (a real silent WAV, longer
        than any realistic pause) so the now-playing media session stays asserted
        and the phase advance still fires while the tab is backgrounded / screen
        locked on iOS. A 'trim timer' (setTimeout for the exact computed duration)
        OR the clip's own 'ended' event — whichever fires first — advances to
        VOICE_1 via the same onAudioEnded hub as every other phase.

    text_visibility:
      known: true
      target: false
      rationale: "Learner must produce target from memory"

    learner_action: "Speak the target language aloud"

    timing:
      source_of_truth: "packages/player-vue/src/playback/computePauseDuration.ts"
      formula: "boot + assembly model — clamp(min_pause_ms, max_pause_ms, boot·beltBoot(p) + assembly·beltAssembly(p)) where assembly = assembly_lin·max(0, ref−assembly_threshold) + assembly_quad·(over/1000)², ref = native reference (avg/target1/sum), p = belt progress 0(White)→1(Green). Legacy knee/two-rate curve still honoured when assembly knobs absent."
      config_table: "algorithm_config (normal_mode + turbo_boost rows) — admin-tunable without redeploy"
      bake_fallback: "DEFAULT_NORMAL from useAlgorithmConfig at cycle-bake time (toSimpleRounds / scriptItemToCycle); the live runtime override recomputes with live config so admin changes win"
      simpleplayer_default: "DEFAULT_PAUSE_DURATION = 6500 ms (bootUpTime 2000 + 0.75 × estimatedTarget 6000) when no baked/override value"

    adaptation:
      driver: "useAdaptationEngine.getPauseMultiplier(legoId) — per-LEGO multiplier"
      composed_from: "MetricsTracker + SpikeDetector + MasteryStateMachine (@ssi/core engines, composed directly in the composable — there is NO AdaptationEngine class anymore)"
      runtime_override: "SimplePlayerRuntimeOverrides.getPauseDuration(cycle) — Turbo/adaptation can shorten the pause; flipping mid-round takes effect on the very next pause"
      null_safe: "getPauseMultiplier ?? 1.0 — adaptation hydrates off the cold-start critical path"

    next_phase: "VOICE_1"

  PHASE_3_VOICE_1:
    name: "VOICE_1"  # SimplePlayer Phase: 'voice1'
    purpose: "First exposure to correct target pronunciation"
    sequence: 3
    duration: "Audio duration of target voice 1"

    audio:
      plays: "target language voice 1 (cycle.target.voice1Url)"
      example: "Voglio caffè (Maria's voice)"

    text_visibility:
      known: true
      target: false  # CRITICAL: Still hidden!
      rationale: "Force listening, not reading"

    learner_action: "Listen and compare to what they said"

    next_phase: "VOICE_2"

  PHASE_4_VOICE_2:
    name: "VOICE_2"  # SimplePlayer Phase: 'voice2'
    purpose: "Second exposure with visual confirmation"
    sequence: 4
    duration: "Audio duration of target voice 2 (+ optional lingerMs hold)"

    audio:
      plays: "target language voice 2 (cycle.target.voice2Url)"
      example: "Voglio caffè (Giovanni's voice)"
      side_effect: "prefetchNextCycle() fires at VOICE_2 start — warms next cycle's known(high)+voice1/voice2(low) URLs during the ~2-3s of playback + inter-cycle gap"

    text_visibility:
      known: true
      target: true  # NOW shown
      rationale: "Visual confirmation after auditory processing"

    learner_action: "See and verify the target text"

    linger:
      field: "cycle.lingerMs"
      behaviour: "intro/debut cycles hold the (now-visible) target tiles for lingerMs after voice2 ends before advancing — lets the learner read the tiling"

    next_phase: "END (advance cycle → next cycle / round)"

CYCLE_FLOW_DIAGRAM: |
  ┌───────────────────────────────────────────────────────────────────────┐
  │                    4-PHASE LEARNING CYCLE (SimplePlayer)               │
  ├───────────────────────────────────────────────────────────────────────┤
  │                                                                       │
  │ (buffering)─▶┌────────┐  ┌────────┐  ┌────────┐  ┌────────┐           │
  │   gate only  │ PROMPT │─▶│ PAUSE  │─▶│VOICE_1 │─▶│VOICE_2 │─▶(linger?) │
  │   pre-prompt └────────┘  └────────┘  └────────┘  └────────┘    │      │
  │                  │            │           │           │        ▼      │
  │             Known audio  Silent WAV   Target V1   Target V2   next    │
  │             Known text✓  Known text✓  Known text✓ Known text✓ cycle   │
  │             Target ✗     Target ✗     Target ✗    Target ✓            │
  │                                                                       │
  └───────────────────────────────────────────────────────────────────────┘

## ============================================================================
## STATE MACHINE DEFINITION (SimplePlayer — primary engine)
## ============================================================================

STATE_MACHINE:
  name: "SimplePlayer"
  file: "packages/player-vue/src/playback/SimplePlayer.ts"
  state_type: "Phase = 'idle' | 'buffering' | 'prompt' | 'pause' | 'voice1' | 'voice2'"
  state_shape: "PlaybackState { roundIndex, cycleIndex, phase, isPlaying }"
  initial_state: "idle"

  states:
    idle:
      description: "Not playing — between cycles / before start / after stop"
      enters_from: [initial, stop, jumpToRound]
      exits_to: [buffering, prompt]
      actions_allowed: [play, resume, jumpToRound, jumpToSeed, jumpToLegoId, skipToPhase]

    buffering:
      description: |
        GUARD phase before PROMPT, not a 5th playback phase. Only entered when the
        cycle's known audio URL points at the network proxy (not a local blob) AND
        a runtime ensureKnownReady override is wired. Lets the UI surface a subtle
        'still fetching' message instead of starting PROMPT over silence. Skipped
        for single-audio cycles (listening / pod / bookend).
      enters_from: [prompt-entry gate]
      exits_to: [prompt]
      auto_transition: "On ensureKnownReady resolve/reject (bounded ~5s), then re-enters prompt"

    prompt:
      description: "Playing known language audio"
      enters_from: [idle, buffering]
      exits_to: [pause]  # or voice1 directly if pauseDuration === 0 (intro cycles)
      actions_allowed: [skipToPhase, skipRound, stepCycle, pause, stop]
      auto_transition: "On audio 'ended' → onAudioEnded → getNextPhase"

    pause:
      description: "Silent WAV clip plays; learner attempts target"
      enters_from: [prompt]
      exits_to: [voice1]
      actions_allowed: [skipToPhase, skipRound, stepCycle, pause, stop]
      auto_transition: "On trim-timer OR silent-clip 'ended' (whichever first) → endPausePhase → onAudioEnded"

    voice1:
      description: "Playing first target voice"
      enters_from: [pause]
      exits_to: [voice2]
      actions_allowed: [skipToPhase, skipRound, stepCycle, pause, stop]
      auto_transition: "On audio 'ended' → onAudioEnded → getNextPhase"

    voice2:
      description: "Playing second target voice (target text now visible); prefetchNextCycle fires"
      enters_from: [voice1]
      exits_to: [idle / next cycle]
      actions_allowed: [skipToPhase, skipRound, stepCycle, pause, stop]
      auto_transition: "On audio 'ended' → onAudioEnded → (lingerMs hold?) → advanceCycle"

  transition_table:
    note: "Literal SimplePlayer.getNextPhase() transitions"
    idle: null
    buffering: null  # startPhase('prompt') handles buffering→prompt explicitly, not via getNextPhase
    prompt: "pause (or voice1 if currentCycle.pauseDuration === 0)"
    pause: "voice1"
    voice1: "voice2"
    voice2: null  # end of cycle → advanceCycle → next cycle / advanceRound

  advance:
    advanceCycle: "emit cycle_completed → next cycle in round, or advanceRound"
    advanceRound: "emit round_completed (LearningPlayer.handleRoundBoundary runs) → next round, or session_complete"

## ============================================================================
## STATE MACHINE DEFINITION (useCyclePlayback — single-cycle helper)
## ============================================================================

USE_CYCLE_PLAYBACK:
  file: "packages/player-vue/src/composables/useCyclePlayback.ts"
  used_for: "intro-advance, demo session-based progression, next-item follow-on (startCyclePlayback in LearningPlayer.vue)"
  phase_type: "CyclePhase = 'PROMPT' | 'PAUSE' | 'VOICE_1' | 'VOICE_2' | 'IDLE'"
  api: "const { state, playCycle, stop } = useCyclePlayback(); await playCycle(cycle, getAudioSource)"
  flow: |
    playCycle runs the 4 phases sequentially as awaited promises:
      PROMPT  → playAudio(known)
      PAUSE   → wait(cycle.pauseDurationMs)        # plain setTimeout, NO silent WAV here
      VOICE_1 → playAudio(target.voice1AudioId)
      VOICE_2 → playAudio(target.voice2AudioId)
      → IDLE
  differences_from_SimplePlayer:
    - "No round/cycle queue — plays exactly one Cycle and resolves"
    - "No 'buffering' guard phase"
    - "PAUSE is a bare wait() timer (no background-safe silent clip)"
    - "Single reusable <audio> element with stall detection (1.5s interval) + 15s absolute safety timeout"
    - "getAudioSource returns { type:'url'|'blob' } resolved by resolveAudioFromCache"

## ============================================================================
## EVENTS
## ============================================================================

EVENTS:
  description: "Events emitted by SimplePlayer (subscribed via useSimplePlayer's onX callbacks)"
  emitter: "SimplePlayer.emit(name, data)"

  state_changed:
    description: "Emitted whenever PlaybackState changes (roundIndex/cycleIndex/phase/isPlaying)"

  phase_changed:
    description: "Emitted on entering each phase"
    payload: "{ phase, cycle, round }"
    subscribed: "simplePlayer.onPhaseChanged((phase) => …) — drives text visibility, phase strip, ring"

  cycle_completed:
    description: "Emitted when a full cycle completes (after voice2 + any linger)"
    payload: "{ cycle, round }"
    subscribed: "simplePlayer.onCycleCompleted(...)"

  round_completed:
    description: "Emitted when the last cycle of a round completes"
    payload: "{ round }"
    subscribed: "simplePlayer.onRoundCompleted(...) → LearningPlayer.handleRoundBoundary (encouragements / interjections / belt advance)"

  session_complete:
    description: "Emitted when there is no next round to advance to"
    subscribed: "simplePlayer.onSessionComplete(...) → SessionComplete screen"

  audio_failed:
    description: "Emitted when audio cannot play (iOS autoplay gesture lost, or a play-error)"
    payload: "AudioFailedEvent { reason: 'needs-gesture' | 'play-error', role?, cycleType?, legoId?, cycleId?, errorCode?, attempt?, lastError? }"
    behaviour: |
      reason='needs-gesture' (NotAllowedError from a backgrounded tab) → halt, UI prompts
      'tap to resume'. reason='play-error' (404/decode/CORS/blob-URL race) is emitted
      twice: attempt=1 just before a single silent retry, attempt=2 (accompanying a halt)
      if the retry also fails. Advancing the phase machine while no sound played would
      lie to the learner about what they heard, so the player halts and offers tap-to-retry.
    subscribed: "simplePlayer.onAudioFailed(...) → audioFailedBanner"

## ============================================================================
## AUDIO CONTROLLER (RealAudioController + cache-first source)
## ============================================================================

AUDIO_CONTROLLER:
  description: |
    The deleted @ssi/core AudioController / RobustAudioController are replaced by
    RealAudioController (inline class in LearningPlayer.vue) plus a cache-first
    audio source. SimplePlayer owns its OWN single <audio> element directly and
    plays via private playAudio(url); it does not depend on RealAudioController.

  RealAudioController:
    file: "packages/player-vue/src/components/LearningPlayer.vue (class RealAudioController)"
    owns: "ONE reusable HTMLAudioElement created in the constructor (mobile unlock preserved across intro + cycle audio)"
    methods:
      play: "(audioRef) => Promise<void> — stop()s prior audio, resolves URL via audioSource (blob: if cached), plays, notifies endedCallbacks"
      stop: "() => void — bumps playGeneration to invalidate pending callbacks"
      setAudioSource: "(audioSource) — cache-first URL resolution (createAudioCacheSource over AudioCache)"
      setPlaybackRate: "(rate) — re-applied after audio.load() (resets to 1.0); used by the pod 2× lap"
      onEnded / offEnded: "register/unregister ended callbacks"
    preload_lru: "MAX_PRELOAD_CACHE_SIZE = 50 — evicts oldest preloaded URLs to bound memory in long sessions"

  cache_first_source:
    persistent_path: "createAudioCacheSource(audioCache, courseCode, () => offlinePlaybackActive() || cachePlayOnline)"
    simpleplayer_resolver: "SimplePlayerRuntimeOverrides.resolveAudioUrl — resolves the URL just before playAudio (sub-ms); falls back to original URL on reject (never breaks playback)"
    online_equals_offline: "cachePlayOnline default-ON (?stream=1 forces the legacy streaming path); cached MP3 → WAV blob (AudioCache.getWavBlobUrl) on the cache path"

  implementation_notes:
    mobile_safari: |
      CRITICAL: reuse a SINGLE Audio element to preserve the iOS 'user gesture unlock'
      state. Creating new Audio() per playback breaks autoplay on iOS Safari. Both
      RealAudioController and useCyclePlayback hold one reused element each.
    background_safe_pause: |
      The PAUSE phase plays a real silent WAV (not a bare timer) so the locked-screen
      media session stays alive on iOS. Holding the locked session is a SEPARATE concern
      from audio supply — see docs/cold-start-and-playback.md. Do NOT add element-level
      silent keepalive (CLAUDE.md).

## ============================================================================
## CONFIGURATION
## ============================================================================

CONFIGURATION:
  pause_duration:
    source_of_truth: "computePauseDuration.ts + algorithm_config table (normal_mode / turbo_boost)"
    formula: "clamp(min_pause_ms, max_pause_ms, pause_base_ms + (t1 + t2) * pause_multiplier)"
    runtime_override: "SimplePlayerRuntimeOverrides.getPauseDuration(cycle) — Turbo/adaptation, applied per cycle"
    fallback: "DEFAULT_PAUSE_DURATION = 6500 ms when no baked or override value"

  turbo:
    overrides: "getPauseDuration (shorter pause), getPlaybackSpeedMultiplier (target voices), shouldSkipCycle (cull turboOmit-tagged cycles)"
    note: "Pure callbacks read at each phase — toggling Turbo mid-round takes effect on the next cycle boundary"

  prefetch:
    next_cycle: "SimplePlayer.prefetchNextCycle() at VOICE_2 start — known(high)+voice1/voice2(low), crosses round boundaries"
    rolling_filler: "fillBuffer / expandScript in LearningPlayer.vue warm ~20 min of cycles+pods+L1 ahead of the playhead (even while locked)"
    removed: "AudioPrefetcher + BundleDownloader (deleted 2026-06-08); preloadSimpleRoundAudio / warmUpInfPlayRoundsBackground / deepPrefetchRestOfCourse are no-op'd (mobile WebKit connection-queue hazard)"

  instant_playback:
    flag: "const INSTANT_PLAYBACK_ALL = true (LearningPlayer.vue) — every course uses the instant-playback bootstrap"
    loader: "useInstantPlayback.bootstrap() — round-map + first-round cycles, localStorage-cached (warm = 0 network)"
    legacy: "The old upfront-load path is kept only as a catch-fallback; PriorityRoundLoader was DELETED 2026-06-08 (never instantiated with INSTANT_PLAYBACK_ALL)"

## ============================================================================
## TEXT VISIBILITY RULES
## ============================================================================

TEXT_VISIBILITY:
  description: "Rules for when to show known/target text"
  principle: "Force active recall, prevent passive reading"
  source: "packages/core/src/engine/types.ts → TEXT_VISIBILITY map (KEPT; still the canonical table)"

  map:
    IDLE:       { known: false, target: false }
    PROMPT:     { known: true,  target: false }
    PAUSE:      { known: true,  target: false }
    VOICE_1:    { known: true,  target: false }
    VOICE_2:    { known: true,  target: true }   # ← target revealed ONLY here
    TRANSITION: { known: false, target: false }

  implementation:
    note: |
      The Vue UI reacts to phase_changed (SimplePlayer) / cyclePlaybackState.phase
      (useCyclePlayback). showTargetText is true only at VOICE_2. Phase names map:
      SimplePlayer 'voice2' ↔ CyclePhase.VOICE_2.

## ============================================================================
## INTEGRATION EXAMPLE (live)
## ============================================================================

INTEGRATION_EXAMPLE:
  vue_component: |
    ```javascript
    // In LearningPlayer.vue setup() — primary engine
    const simplePlayer = useSimplePlayer()

    simplePlayer.onPhaseChanged((phase) => { currentPhase.value = phase })
    simplePlayer.onCycleCompleted((cycle) => { /* progress, telemetry */ })
    simplePlayer.onRoundCompleted((round) => handleRoundBoundary(round))
    simplePlayer.onSessionComplete(() => showSessionComplete())
    simplePlayer.onAudioFailed((event) => { audioFailedBanner.value = event })

    simplePlayer.setRuntimeOverrides({
      getPauseDuration: (cycle) => adaptiveOrTurboPause(cycle),
      getPlaybackSpeedMultiplier: (cycle) => turboActive ? 1.5 : 1.0,
      shouldSkipCycle: (cycle) => turboActive && cycle.turboOmit === true,
      ensureKnownReady: (cycle) => warmKnownAudio(cycle),
      resolveAudioUrl: (url) => resolveFromCache(url),
    })

    simplePlayer.initialize(rounds)   // build the queue (via useInstantPlayback)
    simplePlayer.play()               // first user-gesture play (unlocks iOS audio)

    // --- narrower single-cycle path (intro / demo / next-item follow-on) ---
    const { state, playCycle, stop } = useCyclePlayback()
    await playCycle(cycle, resolveAudioFromCache)   // runs one 4-phase cycle
    ```

## ============================================================================
## VALIDATION RULES
## ============================================================================

VALIDATION:
  cycle_integrity:
    - "A Cycle is complete (known + target voice1 + voice2 bound by ID/URL) or it does not play"
    - "Audio bound by ID/URL on the immutable Cycle — never looked up by text string at runtime (Jan-2026 Cycle refactor)"
    - "Single-audio cycles (listening / pod / bookend) legitimately lack some phases' audio — the missing-audio warning is suppressed for them"

  state_integrity:
    - "Exactly one Phase at a time"
    - "Transitions follow getNextPhase() (prompt→pause→voice1→voice2); intro cycles (pauseDuration===0) skip pause"
    - "endPausePhase is idempotent (playGeneration guard) — trim timer and clip 'ended' cannot double-advance"

  timing_integrity:
    - "Pause duration is clamped [min_pause_ms, max_pause_ms]"
    - "Per-clip absolute safety timeout caps any single clip (useCyclePlayback: 15s)"

  audio_integrity:
    - "Speaking cycles must have known audio + at least one target voice"
    - "Audio failures emit audio_failed for telemetry; the player retries once then halts (never silently fakes a phase)"

