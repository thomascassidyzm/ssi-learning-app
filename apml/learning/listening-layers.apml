# APML Learning: Listening Layers Specification
# SSI Learning App v1.0.0
# Version: 1.0.0 (2025-12-03)
# Status: Superseded in part (2026-04-29) — see banner below
# Last updated: 2026-08-10 (Easy listening speed back to 1.0x — belt ceiling and exposure ramp both flat)
# Source: Aran Jones methodology insights, 2025-12-03

# =============================================================================
# REVISION BANNER (2026-04-29)
# =============================================================================
# Aran revised the firing schedule and stage definitions. The CANONICAL spec
# is now the live visualiser at https://popty.app/listening-playground.html.
# Implementation in packages/player-vue/src/providers/generateLearningScript.ts
# (DEFAULT_LISTENING_CONFIG + Phase 6/7) and dashboard mirror at
# services/learning-script-generator.cjs reflects the revised spec.
#
# Headline differences from this 2025-12 doc:
#   - L2 activation: every round at and after R6 (start of seed 2), NOT
#     "150 seeds completed".
#   - L1 windowing: active-10 (10 most recent graduated seeds, every 3 rounds)
#     plus reserve-50 (next 50 older seeds, every 13 rounds), NOT 4 batches
#     of 20 with hourly rotation.
#   - Speeds: only 1.0× and 2.0× exist for listening playback. The 1.2/1.4/1.6
#     intermediates are dropped.
#   - Pod stage definitions corrected (see STAGE_PLAYLIST in player code).
#   - UPDATE 2026-06-10 (Tom): pod stage 1 is now "Phase 0" — the explainer
#     plays INSTEAD of the translation for 2 pod-rounds (per-stage durations
#     via PodsConfig.stageDurations), then retires; stage 2 "Phase 1" is the
#     plain translation pattern for 3 rounds; speed ramp follows. Sentences
#     with no explainer audio (first-encounter discipline upstream: fully-
#     repeat lines, vocab codas) play their translation in the explainer
#     slot. See DEFAULT_STAGE_PLAYLIST/DEFAULT_STAGE_DURATIONS in
#     usePodLapScheduler.ts and DEFAULT_PODS in useAlgorithmConfig.ts.
#   - Reserve overflow (older than active-10 + reserve-50) will eventually
#     feed into Choice Pods (P1 music / P2 sport / P3 society) — TBD.
#
# UPDATE (2026-07-14, Tom + Aran): Layer-1 listening — both the runtime
# 30-cup wheel (packages/player-vue/src/composables/useLayer1Scheduler.ts)
# AND the drained/eternal SEED-PHASE production review in SPEAKING mode
# (generateLearningScript.ts's emitSeedSandwich, offset >= SEED_PHASE_START
# _OFFSET) — now play the SAME fixed pattern: target -> known -> target ->
# target, ALL at 1.0x. The trailing @2x stretch rep is gone; a drained seed
# doesn't need it. Canonical spec: docs/methodology/layer1-listening-cups.md.
# The dead pre-cups decay/stage/urn-sampling machinery in
# generateLearningScript.ts (ListeningConfig.layer1Playlist/
# layer1StagePlaylist/l1ActiveSize/l1ReserveSize/l1UrnPullCount,
# emitL1Cluster, learner_l1_state fire-count hydration) was deleted — it had
# been unreachable since the 2026-05-19 L1 main-flow removal.
#
# UPDATE (2026-08-06, Tom): LISTENING FOLLOWS THE BELT SPEED GATING.
# Tom, live on staging (French): "LIStening exercises are way too fast
# initially - they need to follow the belt speed gating - at least somewhat...
# in the listening exercise we hear t-k-t-t phrases all at 1x speed... targ
# lang clips start at 0.8x, then in yellow belt go to 0.9x, then orange go to
# 0.95x and finally at green they go to full speed (1.0x)."
#
# So the "ALL at 1.0x" in the 2026-07-14 update above is SUPERSEDED for the
# TARGET clips. The four rates are exactly the SPEAKING side's existing curve,
# reused, never re-implemented:
#   beltSpeed(seedNumber) in packages/player-vue/src/providers/toSimpleRounds.ts
#     white (seeds 1-7)   0.8x
#     yellow (seeds 8-19) 0.9x
#     orange (seeds 20-39) 0.95x
#     green+ (seeds 40+)  1.0x
#
# Applied via computeListeningSpeed(roleSpeed, seedNumber, targetSpeed) in the
# same module — the belt ramp as a MULTIPLIER on the clip's own role rate,
# folding in the course globalSpeed, exempting legacy slow-recorded courses
# (nativeSpeed false) on identical terms to computeCycleSpeed, and clamping at
# MIN_SPEED 0.7. Two consumers:
#   - Layer-1 cups (useLayer1Scheduler.buildSeedPlays): role rate 1.0, keyed on
#     each replayed SEED's OWN number - the faithful analogue of a speaking
#     review of that seed.
#   - Layer-2 pods / Stage-0 / fusion drills (LearningPlayer.playPodLap): role
#     rate = ROLE_SPEED[playRole], keyed on the LEARNER's current seed
#     (beltAnchorSeed) because a pod sentence has no seed number of its own.
#     The pod stage progression (ps 1.0 / ps15x 1.5 / ps2x 2.0) is per-SENTENCE
#     maturity and is preserved as a RATIO - a 2x stretch rep stays a fast rep
#     relative to the learner's belt (white belt: ps 0.8x, ps2x 1.6x). Pods
#     activate at main round 5, so beginners really were meeting 1.0x target
#     audio - that is the bug this closes.
#
# KNOWN-language clips ('trans') are NEVER ramped: the learner's own language,
# the meaning anchor. Tom said "targ lang clips".
#
# UPDATE (2026-08-07, Tom — T-13): EASY DEFAULTS LISTENING TO 0.8x.
# "EASY setting defaults listening playback to 0.8x speed." Implemented as a
# CAP on the same curve — EASY_LISTENING_SPEED = 0.8 in toSimpleRounds.ts,
# applied as min(beltSpeed(seed), 0.8) when TargetSpeedConfig.easyMode is set
# — so Easy is the white-belt rung held for as long as the learner stays on
# Easy, never a second curve and never faster than the belt would give. It
# multiplies the clip's own role rate exactly as the ramp does (a 2x stretch
# rep is 1.6x on Easy), takes the same legacy-course exemption, and is read
# ONLY by computeListeningSpeed: the speaking side's Easy is longer thinking
# time and more reps, not a slower voice, so computeCycleSpeed ignores it.
# LearningPlayer sets easyMode from the live learning mode
# (currentTargetSpeedConfig), so both listening consumers inherit it.
# The Dialogues overlay (ListeningOverlay.vue) has its own speed row: on Easy
# it opens at 0.8x (0.8 added to SPEED_OPTIONS so the default has a button),
# still the learner's to change for the session.
#
# Locked by packages/player-vue/src/playback/listeningSpeedRamp.test.ts, in the
# spirit of speedRampSync.test.ts - the point of both is that there is ONE
# curve. A parallel listening curve that can drift out of sync with the
# speaking one is precisely the bug this codebase already paid for (2026-08-04,
# the two round-builders).
#
# UPDATE (2026-08-07, Tom — SUPERSEDES the stage ladder AND, by default, the
# belt ramp above): LISTENING IS ONE MODE.
#
# Verbatim: "I think we've simplified this completely. To just... One mode,
# which is just... Every single phrase. It's played Target, Known, Target,
# Target. And I think that's all that happens, and the target None, Target,
# Target, it's all at... The same speed, so it might be 0.8. Or maybe even
# Notepoint. Seven, the very first time, and it might be 0.8, then it might
# stay on 0.8 for a few times, then it might go up to one, never more than one,
# depending on what mode we're in. Fast can probably start at the regular
# speed." Plus: "they should probably have A minimal cognitive load for
# listening and it should be slower on easy mode in the listening."
#
# Four rules. One home: packages/player-vue/src/playback/listeningExposureRamp.ts.
#
#   1. ONE PATTERN — every listening phrase, in BOTH layers, plays
#      target - known - target - target. No stages, no per-stage variation, no
#      fifth slot. Layer 1 already had this sandwich; the two layers now share
#      ONE definition (DEFAULT_LISTENING_PATTERN) mapped onto each layer's audio
#      (l1PlaylistFromPattern / podPlaylistFromPattern), rather than two lists
#      that happened to agree.
#   2. ONE SPEED PER PHRASE — all four clips at the same rate, INCLUDING the
#      known-language one. This reverses the "KNOWN clips are NEVER ramped" line
#      in the 2026-08-06 block above: they are now ramped, with everything else.
#   3. TWO RAMPS COMPOSE — a BELT CEILING with the EXPOSURE ramp underneath it.
#      Tom, 2026-08-07 23:56Z, correcting the exposure-only reading that shipped
#      first: "for Easy the BELT TABLE is authoritative... 0.8x for white/yellow
#      belt, 0.9x for orange/green, 1.0x for blue and beyond, NEVER above 1.0.
#      The per-exposure ramp applies UNDERNEATH the belt ceiling."
#
#          speed = min( exposure step , belt ceiling ) x globalSpeed, clamp 1.0
#
#      The belt rung is the MAXIMUM for that learner; the exposure ramp is what
#      approaches it from below on early hearings. A WHITE-BELT EASY LEARNER
#      NEVER EXCEEDS 0.8x however many times they have heard the phrase: 0.7 on
#      the first hearing, 0.8 thereafter, and the ramp's 1.0 step is unreachable
#      until they are a blue belt.
#
#      Easy belt table (its OWN table, NOT the speaking side's beltSpeed —
#      gentler, holding each rung for two belts and not reaching 1.0 until
#      blue, where beltSpeed reaches it at green):
#          seeds   1-19   white + yellow    0.8
#          seeds  20-79   orange + green    0.9
#          seeds  80+     blue and beyond   1.0
#      Fast has NO ceiling (a single 1.0 rung) — "this correction is Easy-only".
#      Exposure ramp, Easy: 0.7 x1, 0.8 x4, then 1.0. Fast: one terminal 1.0.
#
#      The ceiling is keyed on the LEARNER's position (beltAnchorSeed), not the
#      replayed phrase's — Tom's wording is learner-centric twice over ("a
#      white-belt LEARNER's ceiling"). This is a deliberate change from the
#      2026-08-06 belt ramp, which keyed Layer 1 on each replayed seed's own
#      number, and it means a blue belt replaying an early seed is not dragged
#      back to 0.8.
#
#      Layer 2 reads the exposure count off the cohort's
#      existing `alive` clock; Layer 1 DERIVES it from the cup wheel (one cup
#      poured per round, so a seed is heard once per turn of the wheel —
#      seedExposureAt/batchReadyRound), keeping Layer 1 stateless and
#      resume-safe, which is the property the whole cup model rests on.
#      SUPERSEDED 2026-08-10 AS TO EASY'S SHIPPED NUMBERS — see the UPDATE
#      block below. The composition rule, the tables and the machinery are all
#      unchanged; what changed is that Easy now SHIPS a flat 1.0 in both, so
#      neither holds a learner below native pace by default.
#   4. 1.0 IS A HARD CEILING, clamped in CODE (LISTENING_SPEED_CEILING), not in
#      the default config values — the configs are live `algorithm_config` rows
#      that override code defaults at runtime, so a row carrying 1.5 must still
#      play at 1.0. The course globalSpeed still folds in and can only ever
#      slow a clip down (French 0.95: first Easy hearing is 0.665).
#
# RETIRED: the nine-stage pod ladder (DEFAULT_PODS.stagePlaylist,
# ['ps08x','explainer','ps08x'] ... ['ps2x']) no longer drives listening. With
# it go the 1.5x/2.0x stretch reps and the Phase-0 EXPLAINER slot — the
# explainer AUDIO and its resolution path in buildMainStage are kept, simply
# unreferenced on the default path. Flagged to Tom as the one deliberate
# content loss of this change.
#
# KEPT AND REACHABLE BY CONFIG ALONE (no deploy):
#   - listening.speedSource: 'belt' restores the 2026-08-06 belt curve.
#     computeListeningSpeed/beltSpeed and listeningSpeedRamp.test.ts are
#     deliberately untouched: the belt ruling and the exposure spec are ramps
#     over DIFFERENT axes and Tom has ruled on both, so neither is deleted on
#     the other's account. RESOLVED 2026-08-07 23:56Z: they COMPOSE — see rule 3
#     above. This switch survives as the way to fall all the way back to the
#     pre-redesign belt-only behaviour.
#   - listening.listeningUseStagePlaylist: true restores the nine-stage ladder.
#
# EVERY number is a config key, per Tom's standing rule that "all of this
# should be parametrised into the EASY settings in the configs in the app":
# per-mode ramp tables on ModeConfig.listeningSpeedRamp (alongside the Easy
# SPEAKING knobs), the mode-agnostic pattern/ceiling/speed-source on the
# `listening` row.
#
# UPDATE (2026-08-10, Tom — EASY LISTENING GOES BACK TO 1.0x):
#
# Verbatim, after testing listening live: "'Easy' seems to have slowed the
# conversations in the listening section - I don't think we want to be doing
# that"; and "I think we can return the default listening speed settings to
# 1.0x on EASY, I think we moved them to 0.8x."
#
# He was right that we moved them, and it was the BELT CEILING he could hear:
# rule 3's Easy table is a HARD ceiling the exposure ramp can never climb past,
# so an early-course Easy learner was pinned at 0.8x for ever however many
# times they met a phrase — and beltCeilingForSeed returns the FIRST rung for
# an unknown learner position, so an unknown position landed on 0.8 too.
#
# THREE separate Easy-only 0.8s were live, not one, and all three go to 1.0.
# Only fixing the first would have been inaudible to Tom on the surface he was
# actually testing, so the whole set moves together:
#
#   (a) DEFAULT_EASY_BELT_CEILINGS  [{fromSeed 1, 1.0}]
#       (was 0.8 / 0.9 / 1.0 at seeds 1 / 20 / 80 — rule 3 above)
#   (b) DEFAULT_EASY_LISTENING_RAMP [{1.0, terminal}]
#       (was 0.7 x1, 0.8 x4, then 1.0)
#   (c) EASY_LISTENING_SPEED = 1.0 in providers/toSimpleRounds.ts
#       (was 0.8 — the T-13 ruling in the 2026-08-07 block above). At 1.0 the
#       cap min(beltSpeed, EASY_LISTENING_SPEED) is a no-op, so Easy rides the
#       plain belt ramp exactly as Fast does. TWO consumers, both of which Tom
#       could hear: computeListeningSpeed, which still governs the Stage-0
#       sequences and fusion drills that are NOT exposure-ramped (see the
#       runtime note below); and ListeningOverlay.vue's speed row, which
#       OPENED at 0.8x on Easy — that is the Dialogues surface, i.e. literally
#       "the conversations in the listening section", and both modes now open
#       at 1.0.
#
# Easy listening therefore plays at native pace from the first hearing, at
# every belt, modulated only by the course globalSpeed (French 0.95 -> 0.95).
#
# NOT re-opened: the 2026-08-06 BELT ramp (0.8 white -> 0.9 yellow -> 0.95
# orange -> 1.0 green) still governs the non-exposure-ramped listening paths
# for EVERY learner in BOTH modes. Today's ruling is that Easy was slowed
# RELATIVE TO FAST and should not be; it is not a ruling on the belt curve,
# which Tom gave separately and has not withdrawn. So a white-belt learner on
# either mode still meets 0.8x on Stage-0 / fusion-drill clips. Flagged rather
# than silently changed.
#
# WHAT DID NOT CHANGE, deliberately:
#   - LISTENING_SPEED_CEILING = 1.0. "Never more than one" is a separate,
#     still-standing ruling and listening still cannot play above 1.0x.
#   - The ramp and belt-ceiling MACHINERY, the min-then-globalSpeed composition
#     order, beltCeilingForSeed's learner-centric keying, and the
#     degrade-to-shipped-table normalisers. All intact and all tested — the
#     acceptance suite now drives them from explicit fixtures (GENTLE_RAMP /
#     GENTLE_BELTS in listeningOneMode.test.ts) rather than from the shipped
#     defaults, so the gentle curves stay covered.
#   - Easy is still gentler than Fast on every OTHER axis: longer pauses,
#     doubled reps, maxPhraseLengthFraction 0.5, review syllable filter.
#   - Both tables remain DB values (algorithm_config.easy_mode.
#     listeningSpeedRamp / .listeningBeltCeilings), so the 2026-08-07 curves
#     are one Supabase edit away if Tom ever wants them back — no deploy.
#     Verified 2026-08-10: the live easy_mode row carries NEITHER key, so the
#     code defaults are what learners actually hear.
#
# Runtime note: PodPlay.speedIsFinal marks an exposure-ramped play so
# LearningPlayer.playPodLap does not belt-ramp it a second time (it would have
# double-counted globalSpeed and re-split the phrase, since that pass only
# touches target roles). Stage-0 sequences and fusion drills are NOT
# exposure-ramped and keep the belt ramp.
#
# Locked by packages/player-vue/src/playback/listeningOneMode.test.ts.
#
# UPDATE (2026-07-14, Tom + Aran): Layer-2 (Listening Pods) main-flow
# delivery — Stage-0, the audio-drilled per-atom breakdown ladder that used
# to prepend a sentence's first N views (explainer chunk-by-chunk → pairs →
# intention), is RETIRED from the main-flow pod path. It is replaced by an
# ALWAYS-VISIBLE visual: the whole dialogue TURN (one or more glued sentences)
# stays on screen for the duration of the pod lap, each sentence lighting up
# as it plays; under/within each sentence is a LEGO-tile breakdown — one tile
# per atom_map entry, its known-language gloss shown beneath, in
# target-sentence order ("the visuals betray the target language grammar").
# This is the SAME LegoAssembly engine the main speaking cycle's intro/debut
# tiles use (packages/player-vue/src/components/LegoAssembly.vue), reused
# (not reimplemented) via a thin wrapper, PodTurnDisplay.vue. No
# reveal-gating — unlike the 4-phase speaking cycle's VOICE_2 rule, pod
# listening shows text the whole time (matches how Listening Mode's Dialogues
# teleprompter already shows text unconditionally). Speaking-mode pods keep
# their existing DECAY/reveal model in the main cycle — untouched, separate
# concern. Every pod phrase remains a complete communicative unit with
# independent meaning ("good morning, Sarah", never "good/morning/Sarah") —
# audio carries prosodic shape, the visual now carries grammar. Content-side
# segmentation enforcement (the rule + pod1) is built in the dashboard repo in
# parallel; the app renders whatever segmentation it receives.
#
# Every sentence now enters straight at whole-sentence Stage 1 on its first
# view (usePodLapScheduler.ts's nextLap — the Stage-0 prepend AND the
# agent-authored fusion-rung sub-ladder for main-flow were both removed;
# fusionDrill.ts's pairwise fusion ladder itself stays, still load-bearing for
# Listening Mode's Dialogues > Drill mode via useListeningPods.ts, a fully
# separate learner-opt-in surface untouched by this change). stage0Sequence.ts
# stays for the admin-only Pod stage auditioner (/admin/pod-auditioner),
# which still previews/tunes Stage-0 timing for content authoring; its
# higher-level runtime-weaving functions (buildStage0Tier, composeSentenceArc,
# loadStage0ClipMaps, stage0ViewFor) had zero other callers once removed from
# the scheduler and were deleted outright (see @ssi/core/pods/index.ts header
# for the fuller account).
#
# UPDATE (2026-07-24, Tom — supersedes the 2026-07-23 whole-scene-per-lap
# ruling): Layer-2 pod INTAKE is by COHORT, where a cohort is one EXCHANGE and
# the SCENE is the wall. An EXCHANGE is a speaker turn plus its reply — two
# consecutive turns, a turn being a maximal glue_to_next run (flattenPodRows
# computes glue speaker-aware; same unit as podTurns.ts's display spans). The
# first lap of a new scene introduces its opening exchange; each subsequent
# lap extends the SAME scene by its next exchange until the scene completes;
# only then does the next scene begin its debut. An adjacency pair can never
# straddle a lap (a pair IS two consecutive turns, and turns pair off in
# order); a scene with an odd turn count leaves its closing turn — e.g. a
# narrator coda — as its own cohort. Why the supersession: measured on
# ita_for_eng:pod-0, scenes 6+ run 17-36 sentences (~110+ plays for a
# whole-scene debut lap), and the owner's staging test found even scene 1's
# 8-sentence debut too much for a first exposure. Cohorts remain pure
# structure over the flattened sentence list (@ssi/core/pods/podCohorts.ts):
# rows with a missing scene_number (legacy cached content) never force a
# scene break — they join the run in progress; rows with no glue/speaker info
# each read as their own turn and pair off two sentences at a time. STAGE
# COHESION: all sentences introduced in the same lap stay at the SAME stage
# forever — alive counting is per exchange-cohort (cohort c's alive =
# cohort-round - c + 1), and the shared two-doors drill counter lifts a
# cohort only as far as its least-drilled member. The pod stays ONE organism:
# laps still replay the full accumulated content with no explicit scene
# pauses or markers — the cohort unit itself is the punctuation.
# Ratchet migration: course_enrollments.completed_pod_rounds keeps its
# historical unit (sentences covered); each completed lap snaps it to the
# debuted cohort's end boundary (or +1 once all cohorts are in, so eternal
# aging never freezes). Live learners migrate in place — no reset, no
# write-time transform, old/new clients interoperate on the same row; a
# learner who completed whole-scene laps under the 2026-07-23 model holds a
# scene-boundary sentence count, which reads at exchange granularity as "all
# of that scene's exchanges started" — replays age correctly and the next
# lap debuts the following exchange (read-time mapping, podCohortRoundFor).
# ?pod=1 / ?podview=1 previews compose whole cohorts (previews feel like
# actual dialogue); ?podview Next/Prev steps cohort-by-cohort (exchanges).
#
# UPDATE (2026-08-07, Tom — T-13 cold-start window; supersedes the A-52
# floor-only rule of the same day): THE FIRST LAP IS ONE FULL EXCHANGE.
# Tom: "the cold start must be ONE FULL EXCHANGE — a lone line ('Good morning,
# Sarah') is not enough, but the WHOLE SCENE arriving at once is too much."
# One policy, two sides, in the partition (@ssi/core/pods/podCohorts.ts,
# applyPodColdStartWindow):
#   FLOOR   — a first cohort below POD_COLD_START_MIN_SENTENCES = 2 can only
#             be a lone trailing turn (a scene whose whole content is one
#             line). It absorbs following WHOLE exchanges until it is an
#             exchange, crossing a scene wall if it must: an adjacency pair
#             still never straddles a lap, and a lone line outranks the wall
#             for one cohort. Evidence: live telemetry
#             (docs/listening-repeat-diagnosis-2026-08-06.md) — a Hebrew
#             learner's first pod held exactly ONE sentence and, since every
#             lap restarts from sentence one, that clip played 19 times across
#             7 laps: indistinguishable from a broken app.
#   CEILING — nothing else is ever merged. A cohort that is already an
#             exchange stands alone however short; a turn plus its reply IS
#             the intended first serving. The A-52 floor of 3 stacked a second
#             exchange onto any 2-sentence opener, which on eus_for_spa pulled
#             2 + 5 = the whole opening scene into lap one — the "whole scene
#             at once" Tom saw in Aran's session.
# Measured across all 70 live pods: 45 open on a 3-sentence exchange and are
# untouched by either rule; the 25 that open on a 2-sentence exchange (every
# eng_for_* pod among them) now serve that exchange alone instead of a merged
# 4 — eus_for_spa, 7. No live pod opens on a lone line today, so the floor is
# the safety net for the shape A-52 measured rather than an everyday path.
# The window lives in the partition rather than the scheduler so the ratchet,
# stage cohesion and alive-counting follow it with no further change and every
# client derives the same cohorts. It is deliberately NOT conditioned on the
# learner's easy/fast mode even though the ruling arose on Easy: the partition
# is PURE, and a mode-dependent one would have the two modes disagree about
# where laps begin while sharing one sentence ratchet.
#
# UPDATE (2026-08-09, Tom — SUPERSEDES the 2026-07-24 exchange intake):
# ONE NEW SENTENCE PER POD VISIT. Verbatim: "max 1 new sentence per POD visit,
# 2 only if they genuinely belong together (Bonjour Sarah! / Bonjour, comment
# allez-vous?). Next POD visit should move that first selection into Lap 2 and
# introduce ONE new sentence, not a pile of new content."
#
# What was wrong: intake is partitioned over the FLATTENED per-sentence list
# (flattenPodRows splits a silence-split turn into one unit per sentence), but
# the exchange rule — a speaker turn plus its reply — was sized on authored
# TURN rows, and a turn is a whole paragraph. Measured live on 2026-08-09,
# fra/spa/deu_for_eng:pod-0 (142 turn-rows → 294 sentences): 71 cohorts, mean
# 4.14 sentences per lap, max 8, and 59 of 71 laps debuting more than two.
#
# The fix is in the same PURE partition (@ssi/core/pods/podCohorts.ts):
# buildPodCohorts = buildPodSentenceCohorts + applyPodColdStartWindow — one
# cohort per SENTENCE, with the unchanged T-13 cold-start floor merging the
# opening line into a two-sentence first serving. On fra_for_eng that is
# exactly Tom's example: lap 1 = "Bonjour, Sarah !" + "Bonjour.", lap 2 adds
# "Comment allez-vous ?" alone, and every later lap adds one.
# The SENTENCE is also the unit the ratchet has always stored
# (course_enrollments.completed_pod_rounds), so this is a return to the legacy
# pacing: live learners migrate in place, no reset, monotonic forward.
# Scene walls and the exchange partition survive as buildPodExchangeCohorts —
# no longer the intake unit, kept as the tested definition of "a turn plus its
# reply" and the record of the 2026-07-24 ruling. Stage cohesion is unchanged
# and now binds only the cold-start pair. ?pod=1 / ?podview=1 previews compose
# a cohort, so they now preview one sentence (two at the pod's opening).
#
# The body of this spec below is preserved for historical context.
# =============================================================================

## ============================================================================
## OVERVIEW
## ============================================================================

SPECIFICATION:
  name: "Listening Layers System"
  purpose: "Manage long-tail spaced repetition through passive listening"
  source: "packages/core/src/learning/ListeningLayerEngine.ts"
  version: "1.0.0"

CORE_INSIGHT: |
  After Fibonacci decay reaches zero, active prompts are not required.
  Listening exercises on seed sentences are sufficient to reactivate memory.
  This separates "maintenance" from "acquisition" into two distinct layers.

## ============================================================================
## LAYER 1: REACTIVATION LISTENING
## ============================================================================

LAYER_1:
  name: "Concluded Seed Sentences"
  purpose: "Maintain memory of completed content through passive listening"

  content:
    source: "All seed sentences where fibonacci_position >= retirement_threshold"
    type: "seed_pair audio (full sentence)"
    format: "target language only (no prompt/response cycle)"

  speed_progression:
    description: "Playback speed increases with each revisit"
    schedule:
      revisit_1: 1.2
      revisit_2: 1.4
      revisit_3: 1.6
      revisit_4: 1.8
      revisit_5_plus: 2.0
    note: "2x is practical ceiling - most impact achieved"

  implementation: |
    function getPlaybackSpeed(revisitCount: number): number {
      const speeds = [1.0, 1.2, 1.4, 1.6, 1.8, 2.0]
      return speeds[Math.min(revisitCount, 5)]
    }

  windowing:
    description: "After Layer 2 activates, Layer 1 uses rotating windows"

    foundation:
      always_include: "Seeds 1-50"
      reason: "Core foundation must always be maintained"

    rotation:
      additional_seeds: 100
      pattern: |
        Block A: Seeds 1-50 + 51-150
        Block B: Seeds 1-50 + 151-250
        Block C: Seeds 1-50 + 251-350
        (continues rotating)

    implementation: |
      function getLayer1Window(blockIndex: number): SeedRange[] {
        const foundation = { start: 1, end: 50 }
        const rotationStart = 51 + (blockIndex * 100)
        const rotation = { start: rotationStart, end: rotationStart + 99 }
        return [foundation, rotation]
      }

## ============================================================================
## LAYER 2: ACQUISITION LISTENING
## ============================================================================

LAYER_2:
  name: "Conversational Listening"
  purpose: "Acquire new vocabulary through comprehensible input"

  activation:
    trigger: "completed_seeds >= 150"
    reason: "Sufficient foundation for comprehensible input"

  content:
    source: "Natural conversational podcast-style content"
    format: "Sentence-segmented with known/target pairing"
    key_insight: |
      NOT restricted to known vocabulary.
      Comprehensible input with unknown items aids acquisition.

  cycle_pattern:
    initial:
      sequence:
        - { type: "target", speed: 1.0 }
        - { type: "known", speed: 1.0 }
        - { type: "target", speed: 1.0 }
        - { type: "target", speed: 2.0 }

    progression:
      description: "Add sentences over time"
      example: |
        4x target sentences →
        known sentence for last 3 →
        4x target sentences →
        4x target sentences (2x speed)

    scaffolding_removal:
      trigger: "revisit_count >= 4"
      action: "Drop known sentence match for that target"
      reason: "Familiarity no longer requires scaffolding"

  implementation: |
    interface Layer2Segment {
      targetSentences: AudioRef[]
      knownSentences: AudioRef[]  // Scaffolding
      revisitCount: number
    }

    function buildLayer2Cycle(segment: Layer2Segment): PlaybackItem[] {
      const items = []

      for (const target of segment.targetSentences) {
        items.push({ audio: target, speed: 1.0 })

        // Include known scaffolding if not yet familiar
        if (segment.revisitCount < 4) {
          const known = segment.knownSentences.find(k => k.pairsWith === target.id)
          if (known) items.push({ audio: known, speed: 1.0 })
        }
      }

      // Repeat at 2x speed
      for (const target of segment.targetSentences) {
        items.push({ audio: target, speed: 2.0 })
      }

      return items
    }

  parameters:
    max_segment_length: "TBD - analyze examples"
    difficulty_scaling: "TBD - scale with progress?"

## ============================================================================
## SCHEDULING
## ============================================================================

SCHEDULING:
  description: "When to trigger each layer"

  early_phase:
    condition: "completed_seeds < 150"
    layer_1: "every 60 minutes"
    layer_2: "not active"
    listening_frequency: "every 60 minutes"

  later_phase:
    condition: "completed_seeds >= 150"
    layer_1: "every 60 minutes"
    layer_2: "every 60 minutes (offset by 30 min)"
    listening_frequency: "every 30 minutes"
    note: "Layer 1 and Layer 2 alternate"

  implementation: |
    function getNextListeningEvent(state: LearnerState): ListeningEvent {
      const lastL1 = state.lastLayer1Timestamp
      const lastL2 = state.lastLayer2Timestamp
      const now = Date.now()

      if (state.completedSeeds < 150) {
        // Only Layer 1
        if (now - lastL1 >= 60 * 60 * 1000) {
          return { layer: 1 }
        }
      } else {
        // Alternate Layer 1 and Layer 2
        const nextL1 = lastL1 + 60 * 60 * 1000
        const nextL2 = lastL2 + 60 * 60 * 1000

        if (nextL1 <= nextL2 && now >= nextL1) {
          return { layer: 1 }
        } else if (now >= nextL2) {
          return { layer: 2 }
        }
      }

      return null // No listening event due yet
    }

