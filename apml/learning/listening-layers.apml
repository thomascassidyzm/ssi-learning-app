# APML Learning: Listening Layers Specification
# SSI Learning App v1.0.0
# Version: 1.0.0 (2025-12-03)
# Status: Superseded in part (2026-04-29) — see banner below
# Source: Aran Jones methodology insights, 2025-12-03

# =============================================================================
# REVISION BANNER (2026-04-29)
# =============================================================================
# Aran revised the firing schedule and stage definitions. The CANONICAL spec
# is now the live visualiser at https://popty.app/listening-playground.html.
# Implementation in packages/player-vue/src/providers/generateLearningScript.ts
# (DEFAULT_LISTENING_CONFIG + Phase 6/7) and dashboard mirror at
# services/learning-script-generator.cjs reflects the revised spec.
#
# Headline differences from this 2025-12 doc:
#   - L2 activation: every round at and after R6 (start of seed 2), NOT
#     "150 seeds completed".
#   - L1 windowing: active-10 (10 most recent graduated seeds, every 3 rounds)
#     plus reserve-50 (next 50 older seeds, every 13 rounds), NOT 4 batches
#     of 20 with hourly rotation.
#   - Speeds: only 1.0× and 2.0× exist for listening playback. The 1.2/1.4/1.6
#     intermediates are dropped.
#   - Pod stage definitions corrected (see STAGE_PLAYLIST in player code).
#   - UPDATE 2026-06-10 (Tom): pod stage 1 is now "Phase 0" — the explainer
#     plays INSTEAD of the translation for 2 pod-rounds (per-stage durations
#     via PodsConfig.stageDurations), then retires; stage 2 "Phase 1" is the
#     plain translation pattern for 3 rounds; speed ramp follows. Sentences
#     with no explainer audio (first-encounter discipline upstream: fully-
#     repeat lines, vocab codas) play their translation in the explainer
#     slot. See DEFAULT_STAGE_PLAYLIST/DEFAULT_STAGE_DURATIONS in
#     usePodLapScheduler.ts and DEFAULT_PODS in useAlgorithmConfig.ts.
#   - Reserve overflow (older than active-10 + reserve-50) will eventually
#     feed into Choice Pods (P1 music / P2 sport / P3 society) — TBD.
#
# UPDATE (2026-07-14, Tom + Aran): Layer-1 listening — both the runtime
# 30-cup wheel (packages/player-vue/src/composables/useLayer1Scheduler.ts)
# AND the drained/eternal SEED-PHASE production review in SPEAKING mode
# (generateLearningScript.ts's emitSeedSandwich, offset >= SEED_PHASE_START
# _OFFSET) — now play the SAME fixed pattern: target -> known -> target ->
# target, ALL at 1.0x. The trailing @2x stretch rep is gone; a drained seed
# doesn't need it. Canonical spec: docs/methodology/layer1-listening-cups.md.
# The dead pre-cups decay/stage/urn-sampling machinery in
# generateLearningScript.ts (ListeningConfig.layer1Playlist/
# layer1StagePlaylist/l1ActiveSize/l1ReserveSize/l1UrnPullCount,
# emitL1Cluster, learner_l1_state fire-count hydration) was deleted — it had
# been unreachable since the 2026-05-19 L1 main-flow removal.
#
# UPDATE (2026-07-14, Tom + Aran): Layer-2 (Listening Pods) main-flow
# delivery — Stage-0, the audio-drilled per-atom breakdown ladder that used
# to prepend a sentence's first N views (explainer chunk-by-chunk → pairs →
# intention), is RETIRED from the main-flow pod path. It is replaced by an
# ALWAYS-VISIBLE visual: the whole dialogue TURN (one or more glued sentences)
# stays on screen for the duration of the pod lap, each sentence lighting up
# as it plays; under/within each sentence is a LEGO-tile breakdown — one tile
# per atom_map entry, its known-language gloss shown beneath, in
# target-sentence order ("the visuals betray the target language grammar").
# This is the SAME LegoAssembly engine the main speaking cycle's intro/debut
# tiles use (packages/player-vue/src/components/LegoAssembly.vue), reused
# (not reimplemented) via a thin wrapper, PodTurnDisplay.vue. No
# reveal-gating — unlike the 4-phase speaking cycle's VOICE_2 rule, pod
# listening shows text the whole time (matches how Listening Mode's Dialogues
# teleprompter already shows text unconditionally). Speaking-mode pods keep
# their existing DECAY/reveal model in the main cycle — untouched, separate
# concern. Every pod phrase remains a complete communicative unit with
# independent meaning ("good morning, Sarah", never "good/morning/Sarah") —
# audio carries prosodic shape, the visual now carries grammar. Content-side
# segmentation enforcement (the rule + pod1) is built in the dashboard repo in
# parallel; the app renders whatever segmentation it receives.
#
# Every sentence now enters straight at whole-sentence Stage 1 on its first
# view (usePodLapScheduler.ts's nextLap — the Stage-0 prepend AND the
# agent-authored fusion-rung sub-ladder for main-flow were both removed;
# fusionDrill.ts's pairwise fusion ladder itself stays, still load-bearing for
# Listening Mode's Dialogues > Drill mode via useListeningPods.ts, a fully
# separate learner-opt-in surface untouched by this change). stage0Sequence.ts
# stays for the admin-only Pod stage auditioner (/admin/pod-auditioner),
# which still previews/tunes Stage-0 timing for content authoring; its
# higher-level runtime-weaving functions (buildStage0Tier, composeSentenceArc,
# loadStage0ClipMaps, stage0ViewFor) had zero other callers once removed from
# the scheduler and were deleted outright (see @ssi/core/pods/index.ts header
# for the fuller account).
#
# UPDATE (2026-07-23, Tom): Layer-2 pod INTAKE is by COHORT, not by single
# sentence. Each lap debuts a cohort that is one ENTIRE SCENE (scene_number
# group — afternoon ruling, replacing the morning's 2-3 sentence greedy
# packing, which split an adjacency pair across laps: the question landed one
# lap, its reply the next). Scenes are authored to start simple, so early
# cohorts are naturally small. Cohorts are pure structure over the flattened
# sentence list (@ssi/core/pods/podCohorts.ts): one cohort per maximal run of
# rows sharing a scene_number; rows with a missing scene_number (legacy
# cached content) never force a break — they join the run in progress, and an
# all-null list is one cohort. STAGE COHESION: all sentences introduced in the same lap
# stay at the SAME stage forever — alive counting is per cohort (cohort c's
# alive = cohort-round - c + 1), and the shared two-doors drill counter lifts
# a cohort only as far as its least-drilled member. The pod stays ONE
# organism: laps still replay the full accumulated content with no explicit
# scene pauses or markers — the cohort unit itself is the punctuation.
# Ratchet migration: course_enrollments.completed_pod_rounds keeps its
# historical unit (sentences covered); each completed lap now snaps it to the
# debuted cohort's end boundary (or +1 once all cohorts are in, so eternal
# aging never freezes). Live learners migrate in place — no reset, no
# write-time transform, old/new clients interoperate on the same row.
# ?pod=1 / ?podview=1 previews compose whole cohorts (previews feel like
# actual dialogue); ?podview Next/Prev steps cohort-by-cohort.
#
# The body of this spec below is preserved for historical context.
# =============================================================================

## ============================================================================
## OVERVIEW
## ============================================================================

SPECIFICATION:
  name: "Listening Layers System"
  purpose: "Manage long-tail spaced repetition through passive listening"
  source: "packages/core/src/learning/ListeningLayerEngine.ts"
  version: "1.0.0"

CORE_INSIGHT: |
  After Fibonacci decay reaches zero, active prompts are not required.
  Listening exercises on seed sentences are sufficient to reactivate memory.
  This separates "maintenance" from "acquisition" into two distinct layers.

## ============================================================================
## LAYER 1: REACTIVATION LISTENING
## ============================================================================

LAYER_1:
  name: "Concluded Seed Sentences"
  purpose: "Maintain memory of completed content through passive listening"

  content:
    source: "All seed sentences where fibonacci_position >= retirement_threshold"
    type: "seed_pair audio (full sentence)"
    format: "target language only (no prompt/response cycle)"

  speed_progression:
    description: "Playback speed increases with each revisit"
    schedule:
      revisit_1: 1.2
      revisit_2: 1.4
      revisit_3: 1.6
      revisit_4: 1.8
      revisit_5_plus: 2.0
    note: "2x is practical ceiling - most impact achieved"

  implementation: |
    function getPlaybackSpeed(revisitCount: number): number {
      const speeds = [1.0, 1.2, 1.4, 1.6, 1.8, 2.0]
      return speeds[Math.min(revisitCount, 5)]
    }

  windowing:
    description: "After Layer 2 activates, Layer 1 uses rotating windows"

    foundation:
      always_include: "Seeds 1-50"
      reason: "Core foundation must always be maintained"

    rotation:
      additional_seeds: 100
      pattern: |
        Block A: Seeds 1-50 + 51-150
        Block B: Seeds 1-50 + 151-250
        Block C: Seeds 1-50 + 251-350
        (continues rotating)

    implementation: |
      function getLayer1Window(blockIndex: number): SeedRange[] {
        const foundation = { start: 1, end: 50 }
        const rotationStart = 51 + (blockIndex * 100)
        const rotation = { start: rotationStart, end: rotationStart + 99 }
        return [foundation, rotation]
      }

## ============================================================================
## LAYER 2: ACQUISITION LISTENING
## ============================================================================

LAYER_2:
  name: "Conversational Listening"
  purpose: "Acquire new vocabulary through comprehensible input"

  activation:
    trigger: "completed_seeds >= 150"
    reason: "Sufficient foundation for comprehensible input"

  content:
    source: "Natural conversational podcast-style content"
    format: "Sentence-segmented with known/target pairing"
    key_insight: |
      NOT restricted to known vocabulary.
      Comprehensible input with unknown items aids acquisition.

  cycle_pattern:
    initial:
      sequence:
        - { type: "target", speed: 1.0 }
        - { type: "known", speed: 1.0 }
        - { type: "target", speed: 1.0 }
        - { type: "target", speed: 2.0 }

    progression:
      description: "Add sentences over time"
      example: |
        4x target sentences →
        known sentence for last 3 →
        4x target sentences →
        4x target sentences (2x speed)

    scaffolding_removal:
      trigger: "revisit_count >= 4"
      action: "Drop known sentence match for that target"
      reason: "Familiarity no longer requires scaffolding"

  implementation: |
    interface Layer2Segment {
      targetSentences: AudioRef[]
      knownSentences: AudioRef[]  // Scaffolding
      revisitCount: number
    }

    function buildLayer2Cycle(segment: Layer2Segment): PlaybackItem[] {
      const items = []

      for (const target of segment.targetSentences) {
        items.push({ audio: target, speed: 1.0 })

        // Include known scaffolding if not yet familiar
        if (segment.revisitCount < 4) {
          const known = segment.knownSentences.find(k => k.pairsWith === target.id)
          if (known) items.push({ audio: known, speed: 1.0 })
        }
      }

      // Repeat at 2x speed
      for (const target of segment.targetSentences) {
        items.push({ audio: target, speed: 2.0 })
      }

      return items
    }

  parameters:
    max_segment_length: "TBD - analyze examples"
    difficulty_scaling: "TBD - scale with progress?"

## ============================================================================
## SCHEDULING
## ============================================================================

SCHEDULING:
  description: "When to trigger each layer"

  early_phase:
    condition: "completed_seeds < 150"
    layer_1: "every 60 minutes"
    layer_2: "not active"
    listening_frequency: "every 60 minutes"

  later_phase:
    condition: "completed_seeds >= 150"
    layer_1: "every 60 minutes"
    layer_2: "every 60 minutes (offset by 30 min)"
    listening_frequency: "every 30 minutes"
    note: "Layer 1 and Layer 2 alternate"

  implementation: |
    function getNextListeningEvent(state: LearnerState): ListeningEvent {
      const lastL1 = state.lastLayer1Timestamp
      const lastL2 = state.lastLayer2Timestamp
      const now = Date.now()

      if (state.completedSeeds < 150) {
        // Only Layer 1
        if (now - lastL1 >= 60 * 60 * 1000) {
          return { layer: 1 }
        }
      } else {
        // Alternate Layer 1 and Layer 2
        const nextL1 = lastL1 + 60 * 60 * 1000
        const nextL2 = lastL2 + 60 * 60 * 1000

        if (nextL1 <= nextL2 && now >= nextL1) {
          return { layer: 1 }
        } else if (now >= nextL2) {
          return { layer: 2 }
        }
      }

      return null // No listening event due yet
    }

## ============================================================================
## APP NAVIGATION
## ============================================================================

APP_NAVIGATION:
  description: "User-facing listening mode"

  listening_icon:
    action: |
      1. Switch OFF prompts (no active recall)
      2. Cycle between Layer 1 and Layer 2
      3. Minimal cognitive load for user
    quote: "Sweet and easy"

  subject_specific:
    location: "Dedicated tab in navigation"
    content: "Subject-specific listening material"
    format: "Layer 2 format (conversational)"
    behavior: "User-selectable from listening section"

## ============================================================================
## CONTENT REQUIREMENTS
## ============================================================================

CONTENT_REQUIREMENTS:
  layer_1:
    - "Existing seed audio (target language)"
    - "Playback rate adjustment (Web Audio API)"

  layer_2:
    - "Conversational podcast-style content"
    - "Sentence segmentation"
    - "Known/target sentence pairing"
    - "May need new TTS voices for natural feel"

