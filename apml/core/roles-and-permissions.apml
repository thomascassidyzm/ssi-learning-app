# SSi Roles and Permissions Specification
# AI Projects Markup Language (APML) — intent capture, largely superseded by direct code generation
# Single Source of Truth for all user roles across the platform

metadata:
  title: "SSi Roles and Permissions"
  version: "1.5.0"
  date: "2026-08-06"
  author: "Tom Cassidy & Claude"
  status: "specification"
  extends: "apml/schools/ssi-schools-integration.apml"

# =============================================================================
# DESIGN PRINCIPLES
# =============================================================================

principle RoleHierarchy:
  statement: "Roles form a clear hierarchy with inherited permissions"

  levels:
    1_platform: "ssi_admin - platform-wide control"
    2_government: "govt_admin - regional language authority"
    3_school: "school_admin - single school management"
    4_classroom: "teacher - classroom management"
    5_learner: "student/learner - learning experience"
    6_content: "course_creator - content creation (orthogonal)"

  inheritance: |
    Higher roles CAN access lower-role features but DON'T by default.
    A school_admin can "become" a teacher to create a class.
    A govt_admin can view school dashboards in read-only mode.

  transitive_visibility:
    statement: "An admin can drill down through their whole subtree and see what each level sees."
    model: |
      group (govt_admin) -> school (school_admin) -> class (teacher) -> student.
      A govt admin drills group → school → class and sees the same per-student
      activity the teacher sees at the leaf. Visibility is scope-based: you can
      see everything beneath the node you administer.
    implementation: |
      The drill-down works because class/student data loads by id, unscoped by
      role (fetchClassDetail(classId)). Navigation: DashboardView govt detail
      → class rows link to /schools/classes/:id; ClassDetail back-nav returns to
      the school for a drilled-in govt admin.
    aligned_with: "ProgressVisibilityFollowsHierarchy — in-hierarchy progress visibility is the normal, intended model."

principle SeparationOfConcerns:
  statement: "Content creation is separate from content delivery"

  delivery_roles:
    - "learner"
    - "student"
    - "teacher"
    - "school_admin"
    - "govt_admin"
    - "ssi_admin"

  creation_roles:
    - "course_creator"
    - "ssi_admin"

  note: |
    A course_creator uses Popty (ssi-dashboard-v7-clean) to create courses.
    They do NOT have special permissions in the learning app.
    They may also be a learner, teacher, or school_admin separately.

principle ProgressVisibilityFollowsHierarchy:
  statement: "Admins see the progress of the learners they're responsible for. Only data shared OUTSIDE the institution is aggregated."

  note: |
    Progress data — how far a learner has got, how much they've practised — is
    the whole point of the dashboard. A responsible admin seeing it for the
    learners in their subtree is normal in a learning environment, not a privacy
    concern. A govt admin overseeing their group drills group → school → class →
    student, just like a head or a teacher (see RoleHierarchy.transitive_visibility).

    (Supersedes an earlier "higher roles see aggregates only, never individual
    data" stance, which conflated the in-app working view with external reporting.)

  in_app_working_view:
    govt_admin: "Their group's schools → classes → students, down to per-student progress"
    school_admin: "Their school's classes and student progress"
    teacher: "Their classes and student progress"

  external_published_reports:
    rule: "Anonymised aggregates only (e.g. regional totals); no individual identifiers."
    applies_to: "PDF/CSV exports and any data leaving the institution."

# =============================================================================
# ROLE DEFINITIONS
# =============================================================================

role ssi_admin:
  name: "Platform Administrator"
  description: "SSi team members with full platform access"

  scope: "Entire platform"

  permissions:
    courses:
      - "view_all_courses"
      - "approve_community_courses"
      - "feature_courses"
      - "disable_courses"

    users:
      - "view_all_users"
      - "impersonate_user"
      - "ban_user"
      - "grant_roles"

    schools:
      - "view_all_schools"
      - "view_all_regions"

    analytics:
      - "view_platform_analytics"
      - "view_revenue_metrics"
      - "export_reports"

    content:
      - "access_popty_dashboard"
      - "create_official_courses"

  ui_access:
    - "player-vue (learner experience)"
    - "schools-dashboard (as any role)"
    - "admin-dashboard (platform admin)"
    - "popty (content creation)"

  assignment:
    method: "Manual by existing ssi_admin"
    storage: "user_profiles.platform_role = 'ssi_admin'"

role govt_admin:
  name: "Government/Regional Language Authority"
  description: "Officials overseeing language learning adoption in a region"

  scope: "All schools in their assigned region(s)"

  examples:
    - "Welsh Government Language Office"
    - "Brittany Regional Council"
    - "Basque Country Education Ministry"
    - "Irish Language Commissioner"

  permissions:
    schools:
      - "view_schools_in_region"
      - "view_aggregate_school_metrics"

    analytics:
      - "view_regional_adoption"
      - "view_aggregate_learning_hours"
      - "view_geographic_distribution"
      - "export_anonymized_reports"

    never:
      - "view_individual_student_data"
      - "view_individual_teacher_data"
      - "modify_school_settings"
      - "access_content_creation"

  ui_access:
    - "govt-dashboard (regional overview)"
    - "player-vue (as personal learner, if desired)"

  assignment:
    method: "Manual by ssi_admin"
    requires: "Verified government/institution email"
    storage:
      table: "govt_admins"
      columns:
        user_id: "uuid references user_profiles"
        region_code: "text (e.g., 'wales', 'brittany', 'basque')"
        organization_name: "text"
        verified_at: "timestamptz"
      # AUTHZ ONLY. govt_admins answers "may this caller act here?" and is read
      # by groupTreeAuth and nothing else. Every people count and people list in
      # the org UI reads user_tags — so a leader recorded ONLY here governs a
      # group they are not a member of, and the org page names no manager at all
      # (live defect, 2026-08-06).
      membership_twin:
        table: "user_tags"
        row: "tag_type 'group', tag_value 'GROUP:<id>', role_in_context 'admin'"
        why: |
          Founder ruling (Tom, 2026-08-06): the CREATOR of a group/org
          automatically becomes its first MANAGER (group leader). Written at
          creation by api/_utils/groupLeaderTag.ensureGroupLeaderTag, wired into
          createRootOrgAndLeader (root orgs, /orgs signup) and POST /api/groups
          (sub-groups). ssi_admins are exempt — they create groups they do not lead.
        role_value: |
          'admin', not 'leader': the live check constraint
          user_tags_role_in_context_check admits exactly admin|teacher|student.
          A SCHOOL: tag with role 'admin' already means "administers this school",
          so a GROUP: tag with role 'admin' means "administers this group". NOT
          'teacher' — that lands the leader in teacherCount. Grants nothing:
          every reader of role 'admin' filters tag_type='school' first.
        reads: |
          groupLeaderTag.leadersForNodes UNIONS govt_admins with the tag, so orgs
          created before the ruling still name their leader without a backfill.
          Surfaced as `leaders` on GET /api/groups/:id/home, rendered "Led by …"
          on the node home (and "No group leader yet" on a leaderless root —
          absence must be loud, not silent).

      # DUPLICATE-NAME WARNING at creation AND rename (2026-08-06). Deborah made two orgs
      # both called "Deborah Testing" and nothing told her — both slugged to
      # `deborah-testing`, which is what let a path-string subtree match count
      # each org's people into the other's rollup.
      duplicate_name_warning:
        rule: |
          A create OR RENAME whose name slugs onto an EXISTING SIBLING's slug
          answers 409 { code: 'duplicate_name', duplicates: [...] } and writes
          nothing.
          The same request re-sent with confirm_duplicate: true skips the check
          and proceeds byte-identically to before. WARNING, never a constraint:
          no unique index, no forced rename, no auto-suggested name. Two orgs
          may genuinely share a name once a human has said so.
        comparison: |
          On the SLUG, not the raw name — api/_utils/groupSlug.groupSlug mirrors
          compute_group_path()'s one lossy line
          LOWER(REGEXP_REPLACE(name, '[^a-zA-Z0-9]+', '-', 'g'))
          so "deborah testing" and "Deborah-Testing" collide where a
          name-equality check would miss them. Unit-tested against those
          variants so it cannot drift from the trigger.
        scope: |
          SAME PARENT ONLY. Root org vs other root orgs; sub-group vs the other
          children of its own parent. A "Year 7" in two different schools is NOT
          a collision and must not warn — a warning that fires on legitimate
          structure gets ignored within a week.
        redaction: |
          A root collision is with ANOTHER TENANT's org: a non-admin creator
          gets back only the name and created_at. ssi_admins, and sub-group
          collisions inside the caller's own already-validated subtree, get the
          full row (id, path).
        fails_open: |
          Any error in the duplicate lookup means NO WARNING, never a failed
          creation or rename. A warning is a nicety; a blocked signup is a lost
          customer. On the rename path this covers TWO reads — the sibling
          lookup and the row's own name/parent read; either failing skips the
          warning and lets the write proceed.
        rename_specifics: |
          PATCH /api/groups/:id runs the check after authorization and after the
          re-parent cycle checks, before the update — a warned rename writes
          nothing. Two things creation didn't have to do:
            · EXCLUDE THE ROW ITSELF (id !== the patched group), so renaming
              "Deborah Testing" to "deborah-testing" on the same row is silent.
            · Compare against the EFFECTIVE name and parent AFTER the patch —
              the supplied value where the request carries one, the row's own
              current value otherwise. So a pure re-parent (ssi_admin only) that
              lands a group beside a same-named sibling warns too.
        covered_paths: |
          POST /api/groups (both the self-serve root lane and the admin/leader
          lane), POST /api/onboarding/provision's 'org' track (the /orgs signup
          door), and PATCH /api/groups/:id (rename — ssi_admin and leader
          lanes alike). Client: AdminStructure "+ Add organisation" and its
          row rename, NodeActionBar "Add a group" and its Rename verb,
          Onboarding's org door — all via
          utils/duplicateNameWarning.readDuplicateWarning, which distinguishes
          this 409 from the "one organisation per leader for now" 409 on the
          `code`, never the status. Every confirm parameter is passed with
          explicit parens at the call site: a bare @keyup.enter handler would
          hand it the KeyboardEvent, which is truthy, and confirm silently.

role school_admin:
  name: "School Administrator"
  description: "Manages a single school's SSi deployment"
  defined_in: "apml/schools/ssi-schools-integration.apml"

  scope: "Single school"

  permissions:
    teachers:
      - "invite_teachers"
      - "remove_teachers"
      - "view_teacher_list"

    classes:
      - "view_all_classes"
      - "view_class_rosters"

    analytics:
      - "view_school_analytics"
      - "view_teacher_engagement"

    settings:
      - "regenerate_teacher_join_code"
      - "update_school_name"

  ui_access:
    - "schools-dashboard (full admin view)"
    - "player-vue (as personal learner)"

  assignment:
    method: "Self-registration during signup"
    storage: "user_profiles.educational_role = 'school_admin'"

role teacher:
  name: "Teacher"
  description: "Creates and manages classes, runs class sessions"
  defined_in: "apml/schools/ssi-schools-integration.apml"

  scope: "Own classes within school"

  permissions:
    classes:
      - "create_class"
      - "delete_own_class"
      - "run_class_session"
      - "view_class_roster"
      - "regenerate_student_join_code"

    students:
      - "view_student_count"
      - "remove_student_from_class"

  ui_access:
    - "schools-dashboard (teacher view)"
    - "player-vue (personal + class play mode)"

  assignment:
    method: "Join via school's teacher_join_code"
    storage:
      - "user_profiles.educational_role = 'teacher'"
      - "user_tags.tag_value = 'SCHOOL:{school_id}'"

role student:
  name: "Student"
  description: "Learner associated with a class"
  defined_in: "apml/schools/ssi-schools-integration.apml"

  scope: "Own learning progress"

  permissions:
    learning:
      - "access_player"
      - "track_own_progress"
      - "skip_belts"

    class:
      - "view_own_class_name"
      - "leave_class"

  ui_access:
    - "player-vue (learner experience)"

  assignment:
    method: "Join via class's student_join_code"
    storage:
      - "user_profiles.educational_role = 'student'"
      - "user_tags.tag_value = 'CLASS:{class_id}'"

role learner:
  name: "Individual Learner"
  description: "Self-directed learner, not affiliated with school"

  scope: "Own learning progress"

  permissions:
    learning:
      - "access_player"
      - "track_own_progress"
      - "skip_belts"

    courses:
      - "enroll_in_courses"
      - "access_free_community_courses"
      - "purchase_paid_courses"

  ui_access:
    - "player-vue (learner experience)"

  assignment:
    method: "Default role on signup"
    storage: "user_profiles.educational_role = NULL"

role course_creator:
  name: "Course Creator"
  description: "Language activist creating community courses"

  scope: "Own courses in Popty"

  permissions:
    popty:
      - "create_course"
      - "edit_own_course"
      - "submit_for_review"
      - "view_course_analytics"

    never:
      - "publish_without_review"
      - "edit_others_courses"
      - "access_paid_course_creation"

  ui_access:
    - "popty (content creation)"
    - "player-vue (as learner, for testing)"

  assignment:
    method: "Application reviewed by ssi_admin"
    storage:
      table: "course_creators"
      columns:
        user_id: "uuid references user_profiles"
        languages: "text[] (ISO 639-3 codes they can create for)"
        approved_at: "timestamptz"
        approved_by: "uuid references user_profiles"

# =============================================================================
# ROLE COMBINATIONS
# =============================================================================

combinations:
  description: "Users can hold multiple roles simultaneously"

  valid_combinations:
    teacher_and_student:
      description: "Teacher learning another language personally"
      example: "Welsh teacher learning Spanish for themselves"

    school_admin_and_teacher:
      description: "Head teacher who also runs classes"
      example: "Small school where admin teaches too"

    course_creator_and_learner:
      description: "Language activist who also learns other languages"
      example: "Breton creator learning Welsh"

    govt_admin_and_learner:
      description: "Official who also wants to learn"
      example: "Welsh Gov employee learning Welsh"

  storage:
    educational_role: "Primary role in school context"
    platform_role: "Platform-level role (ssi_admin only)"
    course_creator: "Separate table for content creation"
    govt_admin: "Separate table for government access"

# =============================================================================
# REGIONS AND LANGUAGES
# =============================================================================

data Regions:
  description: "Geographic/political regions for language policy"

  schema:
    table: "regions"
    columns:
      code: "text primary key (e.g., 'wales', 'brittany')"
      name: "text"
      country_code: "text (ISO 3166-1 alpha-2)"
      primary_language: "text (ISO 639-3)"
      govt_contact_email: "text nullable"
      created_at: "timestamptz"

  initial_data:
    wales:
      code: "wales"
      name: "Wales"
      country_code: "GB"
      primary_language: "cym"

    brittany:
      code: "brittany"
      name: "Brittany"
      country_code: "FR"
      primary_language: "bre"

    basque_es:
      code: "basque_es"
      name: "Basque Country (Spain)"
      country_code: "ES"
      primary_language: "eus"

    basque_fr:
      code: "basque_fr"
      name: "Basque Country (France)"
      country_code: "FR"
      primary_language: "eus"

    catalonia:
      code: "catalonia"
      name: "Catalonia"
      country_code: "ES"
      primary_language: "cat"

    ireland:
      code: "ireland"
      name: "Ireland"
      country_code: "IE"
      primary_language: "gle"

    scotland:
      code: "scotland"
      name: "Scotland"
      country_code: "GB"
      primary_language: "gla"

    cornwall:
      code: "cornwall"
      name: "Cornwall"
      country_code: "GB"
      primary_language: "cor"

    isle_of_man:
      code: "isle_of_man"
      name: "Isle of Man"
      country_code: "IM"
      primary_language: "glv"

data SchoolRegionLink:
  description: "Link schools to regions for govt_admin access"

  schema:
    add_column_to: "schools"
    column:
      name: "region_code"
      type: "text references regions(code)"
      nullable: true
      description: "Which region this school belongs to"

  assignment:
    method: "school_admin selects during setup or in settings"
    validation: "Region must exist and be active"

# =============================================================================
# ENDANGERED LANGUAGES ROADMAP
# =============================================================================

data EndangeredLanguages:
  description: "Languages targeted for government/community adoption"

  business_model:
    community_courses:
      pricing: "Free forever"
      examples: ["Welsh", "Breton", "Irish", "Basque", "Catalan"]
      rationale: "Community language activists as evangelists"

    big_10_courses:
      pricing: "Paid subscription"
      examples: ["Spanish for English", "English for Chinese"]
      rationale: "Sustainable revenue"

    government_contracts:
      pricing: "Annual contract (e.g., £30k/month)"
      includes:
        - "Schools platform access"
        - "govt_admin dashboard"
        - "Aggregate analytics"
        - "Curriculum alignment reports"

  roadmap:
    phase_1_celtic:
      status: "In Progress"
      languages:
        cym_for_eng:
          name: "Welsh for English Speakers"
          variants: ["north", "south"]
          status: "LIVE"
          region: "wales"

        gle_for_eng:
          name: "Irish for English Speakers"
          status: "PLANNED"
          region: "ireland"
          target_launch: "2026 Q3"

        gla_for_eng:
          name: "Scottish Gaelic for English Speakers"
          status: "PLANNED"
          region: "scotland"
          target_launch: "2026 Q4"

        bre_for_fra:
          name: "Breton for French Speakers"
          status: "PLANNED"
          region: "brittany"
          target_launch: "2026 Q4"

        cor_for_eng:
          name: "Cornish for English Speakers"
          status: "LIVE"
          region: "cornwall"

        glv_for_eng:
          name: "Manx for English Speakers"
          status: "LIVE"
          region: "isle_of_man"

    phase_2_iberian:
      status: "Future"
      languages:
        eus_for_spa:
          name: "Basque for Spanish Speakers"
          status: "PLANNED"
          region: "basque_es"

        eus_for_fra:
          name: "Basque for French Speakers"
          status: "PLANNED"
          region: "basque_fr"

        cat_for_spa:
          name: "Catalan for Spanish Speakers"
          status: "PLANNED"
          region: "catalonia"

        cat_for_fra:
          name: "Catalan for French Speakers"
          status: "FUTURE"
          region: "catalonia"  # Northern Catalonia

        glg_for_spa:
          name: "Galician for Spanish Speakers"
          status: "FUTURE"

        oci_for_fra:
          name: "Occitan for French Speakers"
          status: "FUTURE"

    phase_3_global:
      status: "Long-term"
      languages:
        mri_for_eng:
          name: "Maori for English Speakers"
          status: "FUTURE"
          region: "new_zealand"

        haw_for_eng:
          name: "Hawaiian for English Speakers"
          status: "FUTURE"
          region: "hawaii"

# =============================================================================
# GOVERNMENT DASHBOARD
# =============================================================================

interface GovtAdminDashboard:
  name: "Government Language Authority Dashboard"
  location: "apps/govt-dashboard (NEW)"

  purpose: |
    Provide regional language authorities with adoption metrics
    and aggregate learning data WITHOUT exposing individual data.

  sections:
    overview:
      title: "Regional Overview"
      displays:
        - "Total schools using SSi"
        - "Total teachers"
        - "Total students"
        - "Total learning hours (this month)"
        - "New speakers estimate (reached conversational level)"

    adoption:
      title: "Adoption Metrics"
      displays:
        - "Schools by adoption status (pie chart)"
        - "Geographic distribution (map)"
        - "Month-over-month growth"
        - "Target vs actual adoption rate"

    engagement:
      title: "Learning Engagement"
      displays:
        - "Hours learned per week (trend)"
        - "Average session length"
        - "Belt distribution (anonymized)"
        - "Course completion rate"

    curriculum:
      title: "Curriculum Alignment"
      displays:
        - "Vocabulary coverage vs curriculum requirements"
        - "Grammar points covered"
        - "Link to standards mapping document"

    export:
      title: "Reports"
      actions:
        - "Export anonymized monthly report (PDF)"
        - "Export adoption spreadsheet (CSV)"
        - "Schedule automated reports"

  data_privacy:
    never_shows:
      - "Individual student names"
      - "Individual teacher names"
      - "School names (unless opt-in)"
      - "Response latencies or performance data"

    aggregation_minimum: "Data only shown if >= 5 schools/50 students"

  mock_data:
    overview_stats:
      schools_total: 1500
      schools_using_ssi: 247
      adoption_rate: "16.5%"
      teachers: 1234
      students: 45678
      hours_this_month: 89432
      new_speakers_estimate: 2340

# =============================================================================
# ADMIN ACT-AS ("View the app as")
# =============================================================================

interface AdminActAs:
  name: "Admin Act-As / View the app as"
  location: "player-vue (entry on /admin/access; live experience on /schools)"
  status: "implemented"

  purpose: |
    Lets an ssi_admin (Tom + Aran) step into a real persona — teacher,
    school leader (school_admin), or group admin (govt_admin) — and use the
    live, interactive /schools app exactly as that person sees it, then step
    back out. Realises the ssi_admin "schools-dashboard (as any role)" ui_access
    and the RoleHierarchy "can become a lower role" principle.

  supersedes: |
    The removed god-mode JWT impersonation (godMode.selectUser) that forged an
    identity and fought RLS, AND the read-only /admin/schools/:id views for the
    "experience it as them" use case. Read-only admin views still exist for
    pure inspection.

  mechanism:
    kind: "Client-side context overlay — NOT JWT impersonation"
    role_overlay: |
      useUserRole holds an `actingAs` persona. effective-role computeds
      (isTeacher/isSchoolAdmin/isGovtAdmin/hasSchoolRole) reflect the persona
      so the /schools route guard passes, while platformRole stays 'ssi_admin'
      so admin controls (incl. the exit banner) remain.
    scope: |
      useSchoolContext.loadAsPersona(userId) primes currentUser with the
      persona's OWN user_id + role + scope (the same resolution as their
      self-view). A teacher's classes are scoped by teacher_user_id, so seeing
      their real roster requires being them. Govt scope resolves group_id /
      group_path (canonical group-tree scope), region_code as legacy fallback.
    queries: |
      Run under the admin's own Supabase session. RLS is live on the schools
      org tables (verified 2026-08-06 — was off when this line was first
      written); the ssi_admin bypass in those policies covers any scope.
      No forged JWT.
    persistence: |
      sessionStorage 'ssi-acting-as' — a reload keeps act-as within the tab,
      and it clears when the tab closes. Restored on App mount.

  safety:
    no_stored_link: |
      The admin's own learner row and auth session are never written to, so no
      admin<->persona link is ever stored. Exiting just clears client context.
    reversible: "Persistent exit banner on every screen; one tap returns to admin."
    isolation: "Personas live in the Wales demo subtree (is_demo=true), isolated from real schools."

  personas:
    source: "packages/player-vue/src/composables/schools/actAsPersonas.ts"
    teacher: "test_teacher_rhian (Rhian Griffiths)"
    school_admin: "test_admin_elen (Elen Rhys)"
    govt_admin: "test_govt_gwilym (Gwilym ap Dafydd) — scoped to the Demo/Wales group"

  gating: "canActAs = isSsiAdmin (real platform role); entry panel + start are admin-only."

  files:
    - "composables/useUserRole.ts (actingAs overlay, startActingAs/stopActingAs)"
    - "composables/schools/useSchoolContext.ts (loadAsPersona, group-aware govt resolver)"
    - "composables/useActAs.ts (orchestration + reload restore)"
    - "composables/schools/actAsPersonas.ts (persona list)"
    - "views/admin/AdminAccess.vue (entry panel)"
    - "components/ActingAsBanner.vue (exit bar)"
    - "App.vue (banner mount + restore)"

  related_fix: |
    Govt admin school drill-down: DashboardView renders a detail block
    (stat strip + classes table) and fetches the school's classes when a govt
    admin selects a school; class rows link to /schools/classes/:id so the
    admin drills group → school → class → per-student activity (the full
    transitive_visibility chain). ClassDetail back-nav returns to the school.

# =============================================================================
# ADMIN DEMO SCHOOLS ("Create demo school")
# =============================================================================

interface AdminDemoSchools:
  name: "Self-serve demo school generator"
  location: "player-vue /admin/demo-schools"
  status: "implemented"

  purpose: |
    Lets Nick (Head of Partnerships), or any ssi_admin, provision a full
    showcase org for a sales prospect without engineering help: real Supabase
    auth accounts (not client demo mode — the founder's ruling, "creating an
    actual account for them is much better than a demo"), real schools/
    groups/classes rows, and realistic seeded learner activity, so every
    schools-dashboard tab looks alive the moment it's created.

  generalises: |
    scripts/demo-data/generate-ime-demo.cjs (the one-off IME demo-group
    script) into a parameterised, HTTP-callable engine
    (api/_utils/demoSchoolGen.ts) covering three org shapes: single_school,
    group (multi-academy trust style), government_region.

  org_shapes:
    single_school: "One schools row; the prospect name IS the school name."
    group: "One groups row (type='group') + govt_admin leader persona + N schools."
    government_region: "Same shape as group, type='region' — label-only difference."

  isolation: |
    Every row carries is_demo=true (learners, matches every other demo
    surface) and is_test=true (schools, groups — the same flag board_metrics
    and test_learner_ids() already exclude on). A dedicated demo_orgs table
    (service-role-only RLS posture) tracks each generation run — is_test
    alone can't distinguish "a sales demo this tool created" from other test/
    soak data, since every school row in the DB is currently is_test.

  reused_primitives: |
    ensureClassLearnerEntity (owner ruling 2026-07-16 — every class-creation
    path must call it), ensureJoinCodesRegistered
    (api/_utils/schoolJoinCodes.ts — same helper api/onboarding/provision.ts
    and api/admin/create-school.ts use), api/admin/create-signin-link.ts
    (magic-link minting, called per staff row from the result card).
    teacher_join_code / admin_join_code / student_join_code are DB-trigger-
    generated, never hand-rolled.

  credentials:
    passwords: "Generated per staff account, returned ONCE in the create response, never persisted."
    signin_links: "Minted on demand via create-signin-link, keyed by learnerId stored in demo_orgs.metadata — works any time, including after the one-time password is gone."

  lifecycle:
    default_expiry: "30 days from creation, extendable (POST action=extend)."
    teardown: |
      Bans every staff auth account (Supabase ban_duration — reversible, not
      a delete) and marks demo_orgs.status='expired'. Synthetic learner rows
      never sign in, so they need no teardown. A daily cron
      (api/cron/expire-demo-schools.ts) auto-expires anything past its date;
      the manual "Expire now" action in the UI does the same teardown early.

  files:
    - "supabase/migrations/20260716e_demo_orgs.sql (tracking table, service-role-only)"
    - "api/_utils/demoSchoolGen.ts (provisioning engine)"
    - "api/admin/demo-schools.ts (verifyAdmin-gated: list/create/expire/extend)"
    - "api/cron/expire-demo-schools.ts (daily auto-expiry)"
    - "views/admin/AdminDemoSchools.vue (create form + list)"
    - "components/admin/DemoOrgResultCard.vue (shareable result card, reused by both fresh-create and re-open)"

# =============================================================================
# DATABASE SCHEMA ADDITIONS
# =============================================================================

schema GovtAdminTable:
  table: "govt_admins"
  description: "Government/regional authority administrators"

  columns:
    id:
      type: "uuid"
      primary_key: true
      default: "gen_random_uuid()"

    user_id:
      type: "uuid"
      references: "user_profiles.id"
      unique: true

    region_code:
      type: "text"
      references: "regions.code"

    organization_name:
      type: "text"
      description: "e.g., 'Welsh Government Language Office'"

    verified_at:
      type: "timestamptz"
      nullable: true

    verified_by:
      type: "uuid"
      references: "user_profiles.id"
      nullable: true

    created_at:
      type: "timestamptz"
      default: "now()"

  indexes:
    - "idx_govt_admins_user ON govt_admins(user_id)"
    - "idx_govt_admins_region ON govt_admins(region_code)"

schema CourseCreatorTable:
  table: "course_creators"
  description: "Community course creators"

  columns:
    id:
      type: "uuid"
      primary_key: true
      default: "gen_random_uuid()"

    user_id:
      type: "uuid"
      references: "user_profiles.id"
      unique: true

    languages:
      type: "text[]"
      description: "ISO 639-3 codes they can create courses for"
      example: "['bre', 'cym']"

    application_text:
      type: "text"
      description: "Why they want to create courses"

    approved_at:
      type: "timestamptz"
      nullable: true

    approved_by:
      type: "uuid"
      references: "user_profiles.id"
      nullable: true

    created_at:
      type: "timestamptz"
      default: "now()"

  indexes:
    - "idx_course_creators_user ON course_creators(user_id)"

schema PlatformRoleColumn:
  description: "Add platform role to user_profiles"

  alter_table: "user_profiles"
  add_column:
    name: "platform_role"
    type: "text"
    values: ["ssi_admin"]
    nullable: true
    description: "Platform-level role (separate from educational_role)"

# =============================================================================
# PERMISSION CHECKS (Pseudocode)
# =============================================================================

logic PermissionChecks:
  description: "How to check permissions in code"

  examples:
    can_view_school:
      check: |
        // User can view school if:
        // 1. They are ssi_admin (see all)
        // 2. They are govt_admin for the school's region
        // 3. They are school_admin of that school
        // 4. They are teacher at that school

        function canViewSchool(user, schoolId) {
          if (user.platform_role === 'ssi_admin') return true

          const school = getSchool(schoolId)

          if (isGovtAdmin(user, school.region_code)) return true
          if (isSchoolAdmin(user, schoolId)) return true
          if (isTeacherAt(user, schoolId)) return true

          return false
        }

    can_view_student_roster:
      check: |
        // Only teachers of the class and school_admins can see roster

        function canViewRoster(user, classId) {
          const klass = getClass(classId)

          if (isSchoolAdmin(user, klass.school_id)) return true
          if (isTeacherOf(user, classId)) return true

          return false
        }

    can_view_regional_analytics:
      check: |
        // Only govt_admin for region and ssi_admin

        function canViewRegionalAnalytics(user, regionCode) {
          if (user.platform_role === 'ssi_admin') return true
          if (isGovtAdmin(user, regionCode)) return true

          return false
        }

# =============================================================================
