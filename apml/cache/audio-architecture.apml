# APML v2.0.0 - Audio Caching Architecture
# SSI Learning App
# Last Updated: 2026-06-08 (ONE cache-first player; online=offline via cachePlayOnline; rolling filler + AudioCache; AudioPrefetcher/BundleDownloader/usePrefetchManager/OfflineCache/AudioSource all DELETED)

spec audio_caching_architecture:
  version: "3.0.0"
  status: "implemented"
  date: "2026-06-08"

  description: |
    ONE cache-first player. Online == offline: the player only ever reads from the
    cache, and the network's only job is to fill the cache ahead of the playhead.
    cachePlayOnline is default-ON, so an online learner plays cached WAV blobs
    (decoded from cached MP3) exactly like an offline one — the network is only the
    miss fallback for the very first/uncached clip. Audio and text stay atomically
    bound — a Cycle is complete (3 valid audio ids) or it doesn't play.

    Never show connection errors - always keep playing.

    See docs/cold-start-and-playback.md (the live trace) and docs/buffer-model.md
    (SUPERSEDED design intent) for the prose version of this model.

    SUPERSEDED MODULES (deleted — do NOT reference): @ssi/core OfflineCache,
    AudioSource, DownloadManager; cache/AudioPrefetcher; cache/BundleDownloader;
    composables/usePrefetchManager. Their roles are now covered by AudioCache +
    the rolling filler + createAudioCacheSource (below).

  ## ==========================================================================
  ## BACKEND PROXY
  ## ==========================================================================

  backend_proxy:
    endpoint: "/api/audio/:audioId"
    file: "api/audio/[audioId].ts"

    purpose:
      - "Entitlement verification (paid vs free)"
      - "Future CDN flexibility (swap S3 without app update)"
      - "CORS bypass (proper headers from our domain)"
      - "Returns correct 206 ranges for the <audio> element (the SW deliberately stays OUT of the audio path)"

    request_flow:
      1: "Receive audioId (UUID)"
      2: "Query Supabase for S3 key"
      3: "Proxy audio from S3 with caching headers (206 on Range)"
      4: "Return audio stream"

    response_headers:
      Content-Type: "audio/mpeg"
      Cache-Control: "public, max-age=31536000, immutable"
      Access-Control-Allow-Origin: "*"

    analytics:
      note: >
        The proxy is NO LONGER a play log. The old audio_plays table was dropped
        2026-05-19 — once playback is cache-first the proxy only ever sees the rare
        cache MISS, so it can't count real plays. Source of truth for "what played"
        is now player_events.audio_play (client-side: user_id, course_code,
        session_id + payload {url, role, legoId, cycleId, cycleType, playbackSpeed}).

  ## ==========================================================================
  ## THE CACHE — AudioCache (one IndexedDB store, two lifecycles)
  ## ==========================================================================

  audio_cache:
    file: "packages/player-vue/src/cache/AudioCache.ts"
    interface: "packages/player-vue/src/cache/AudioCache.types.ts"
    db: "ssi-audio-cache-v2 (IndexedDB, single 'audio' store keyed by audio id)"
    purpose: "App-controlled, readable cache for both online cache-play and offline play"

    structure: >
      ONE object store, one row per audio id (blob + mimeType + size + lifecycle +
      cachedAt/lastAccessedAt). A `lifecycle` column distinguishes two namespaces;
      in-memory id Sets (persistentIds / ephemeralIds) make has(id) synchronous.
      Self-heals a storeless DB (interrupted upgrade / ?reset) by delete + recreate.

    namespaces:
      persistent:
        purpose: "Course-spanning warm cache — the rolling filler and pods/L1/warmFirstKnownAudio write here"
        api: "ensure(id) | has(id) | getBlobUrl(id) | evictToTarget(targetBytes)"
        eviction: "persistentEvictToTarget — LRU by lastAccessedAt, deletes oldest persistent rows until under the byte cap (this is the offline depth cap / quota self-trim)"
        promotion: "an id already cached as ephemeral is rewritten in place to persistent (no re-fetch)"
      ephemeral:
        purpose: "Per-LEGO build sets (acquireForLego / releaseForLego, abortable)"
        status: >
          VESTIGIAL — kept for now but NO production callers remain (only the test
          suite acquires/releases ephemeral sets). The rolling filler writes
          persistent only. Treat as dead weight pending removal.

    read_paths:
      getBlobUrl: "mp3 blob: URL — re-wraps to carry mimeType so iOS Safari can decode it"
      getWavBlobUrl: >
        Decode the cached mp3 bytes and re-encode to a WAV blob: URL (bytesToWavBlob,
        cache/wav.ts). THIS is the cache-first / offline play read path: WebKit's
        <audio> rejects mp3 blob: URLs ('operation is not supported') but plays WAV.
        Decoded once per id into an in-memory wavUrlCache and reused (spaced rep
        replays the same clips), so we never decode the same audio twice. WAV is NOT
        a persisted tier — it's just-in-time and in-memory.

    quota:
      quotaPressure: "navigator.storage.estimate() usage/quota ratio (0..1) — drives self-trim before the browser errors"
      stats: "per-namespace count+bytes (5s TTL cache) + quota/usage — used by the offline size estimate"

  ## ==========================================================================
  ## AUDIO SOURCE ADAPTER — createAudioCacheSource
  ## ==========================================================================

  audio_source:
    file: "packages/player-vue/src/cache/createAudioCacheSource.ts"
    purpose: "Read-path bridge: gives RealAudioController a getAudioUrl(audioRef) over AudioCache"

    wiring: >
      createAudioCacheSource(audioCache, courseCode, () => offlinePlaybackActive() || cachePlayOnline)
      in LearningPlayer.vue. The 3rd arg (shouldServeBlobs) is the cache-first gate.

    resolution:
      when_serving_blobs: "getWavBlobUrl(id) → WAV blob: URL from cache; null on miss → fall through to network URL"
      otherwise: "return audioRef.url unchanged (streaming path; only used with ?stream=1)"
      note: >
        The main 4-phase cycle resolves through resolveAudioUrl / resolveCachedPlaybackUrl
        (cache/resolvePlaybackUrl.ts) — the same id→lock-safe-playable-URL substrate the
        listening overlay plays through. createAudioCacheSource serves AudioController's
        OTHER audio (intro, welcome, commentary, pod laps, dialogues).

  cache_play_online:
    flag: "const cachePlayOnline = !URLSearchParams(location.search).has('stream')  (LearningPlayer.vue)"
    default: "ON — online learners play cached WAV blobs, exactly like offline"
    bypass: "?stream=1 forces the legacy streaming path for comparison"
    why: >
      Keeping the MAIN cycle off the network (cache blob, not a streamed range) is what
      survives iOS lock/background. Streaming put the network back in the play path and
      drained the buffer; cache-play removes that.

  ## ==========================================================================
  ## THE ROLLING FILLER — how the cache is kept ahead of the playhead
  ## ==========================================================================

  rolling_filler:
    file: "packages/player-vue/src/components/LearningPlayer.vue"
    purpose: "Network's only job: fill AudioCache.persistent ~20 min ahead of the playhead"

    spans:
      ROLLING_SPAN_MS: "20 * 60 * 1000 — steady deep fill, concurrency 1 (gentle)"
      BURST_SPAN_MS:   "10 * 60 * 1000 — fast head warm, concurrency 3 (cold-start / restart)"

    mechanism:
      expandScript: "grows the loaded script ahead (ensureLiveSpanLoaded) so we warm a DEEP cache, not just the bootstrap window — also extends INF-PLAY / revival tails"
      fillBuffer: >
        Builds ONE ordered missing-list [cycles…, pods…, L1…], dedupes, and a
        missing-only worker drains it front-to-back via audioCache.persistent.ensure(id).
        Structural priority (no rate measurement): every uncached cycle warmed before any
        pod, every pod before any L1 listening clip. Silent on error — the play path
        handles any miss by streaming that one clip.
      triggers:
        - "first rounds load → warmBurst (BURST span, concurrency 3)"
        - "each round advance → fillRollingBuffer (ROLLING span, concurrency 1)"
        - "stop/pause → warmBurst (so a restart is instant)"
      keep_warming_while_locked: >
        fillBuffer KEEPS warming even while hidden/locked (a 63-min locked run streamed
        the whole time and never died — going network-silent on lock just drained the
        buffer and forced streaming anyway). Yields on isOnline false (offline mode owns
        true-offline) and on an active bulk download.

    next_cycle_warm:
      file: "packages/player-vue/src/playback/SimplePlayer.ts"
      method: "prefetchNextCycle() — warms the next cycle's known (priority high) + voice1/voice2 (low) so the head is never a miss"

  ## ==========================================================================
  ## SERVICE WORKER — deliberately OUT of the audio path
  ## ==========================================================================

  service_worker:
    file: "packages/player-vue/vite.config.js (VitePWA / Workbox)"
    audio: >
      The SW does NOT cache audio. The old CacheFirst on /api/audio/* was REMOVED
      2026-05-24 — the SW (and Vercel's edge) served cached full-200 bodies in
      response to <audio> Range requests, which iOS Safari can't handle (plays ~0.5s
      then stalls forever), and it flapped working/broken across SW versions. Audio
      now goes straight to the origin proxy (correct 206s). globIgnores excludes
      mp3/wav/ogg/m4a from precache; cleanupOutdatedCaches clears runtime caches on
      activate. AudioCache (IndexedDB) is the app-controlled cache, fully independent
      of the SW.
    what_sw_still_does:
      - "Precache the app shell (js/css/html/svg/woff2)"
      - "NetworkFirst on document navigations (3s timeout → cache) so deploys propagate"
      - "CacheFirst on Google Fonts (fonts.googleapis.com / fonts.gstatic.com) only"
      - "skipWaiting/clientsClaim FALSE in prod (registerType:'prompt') — never auto-interrupt a playing session"

  ## ==========================================================================
  ## OFFLINE DOWNLOAD — DEPTH PICKER
  ## ==========================================================================

  offline_download:
    file: "packages/player-vue/src/components/LearningPlayer.vue"
    purpose: "Deliberate, opt-in download of upcoming course content for offline play"

    depth_unit:
      measure: "% of course content (rounds ahead of the cursor)"
      NOT: "playback time"
      why: >
        Offline never STOPS — when the downloaded content runs out it drops into
        INF PLAY and recycles the cache forever, so 'hours offline' is infinite
        regardless of download size. The knob controls how much NEW course
        material you carry, not how long you can listen.

    flow:
      - "Tapping 'Offline mode' closes the mode tray (handleOffline) and opens the 'Take it offline' picker (showOfflinePicker)"
      - "Picker = a notched SLIDER (how much of what's left to carry) + a live MB readout + a course-depth bar"
      - "Tapping Download → startOfflineDownload() → sets offlineActive, downloads the selected depth"
      - "Turning offline off revokes blob URLs and resets state"

    single_popup_rule:
      requirement: "The input dialog must ALWAYS be accessible — one popup at a time."
      why: >
        The mode tray lives inside the bottom-nav's z-index:3000 stacking context;
        the picker teleports to <body>. Two things keep the dialog reachable:
      how:
        - "ModeTray.handleOffline closes the tray on the offline tap, so the picker is the only popup"
        - "offline-picker-backdrop z-index 3100 — above the nav/belt-skip/paywall layer (3000), below system prompts (PWA update/install)"
        - "Dialog capped at max-height calc(100dvh - 48px): header + note pinned, options scroll → every control reachable on short/landscape screens"
        - "Dismiss via ✕, backdrop tap, or Escape (matches the app's other modals)"

    depth_slider:
      control: "notched <input type=range> (offlineNotchIndex 0..5) + tappable tick labels"
      notches: "[0.02, 0.05, 0.10, 0.25, 0.50, 1]  # OFFLINE_NOTCHES"
      unit: >
        Fraction of the REMAINING course (cursor → tail), NOT of the whole course.
        So the top notch (100%) always means 'the rest of the course' regardless
        of how far through you are, and notches never collapse into each other —
        no per-notch hiding needed. Thumb starts at the smallest (2%) on each open.
      mapping: "offlineSelectedRounds = frac>=1 ? poolRounds : ceil(poolRounds·frac), min 1"
      pool: >
        offlinePoolRounds: mid-course = total − start (new content ahead);
        finished/INF-PLAY (start >= total, cursor at/past the main-loop tail) =
        the whole course (no new content left — download = keep it offline to
        recycle); unknown length = roundsLoadedAhead. NEVER 0 while total>0
        (was the bug: courseTotalRounds is main-loop-only, so a finished learner
        had remaining=0 → every notch collapsed to one round). offlineAtTail flips
        the slider/bar/labels to the 'keep N% of the course offline' framing.
      why_not_time: >
        Time is misleading twice: INF PLAY makes total offline time infinite, and
        the 'new' portion stretches with turbo/replay. So the readout is MB (real
        cost) + a course-depth bar (the pre-INF-PLAY new learning made visible),
        never a duration.
      course_depth_bar: >
        offlineCourseBar — donePct (start/total, already learned) + newPct
        (selectedRounds/total, the new chunk carried). Untinted remainder = where
        INF PLAY recycling lives. % is of the WHOLE course here (for honest depth).

    size_estimate:
      shown_for_selected_notch: "≈MB and % of device storage (offlineSelectedEstimate); basis gathered once on open (offlineEst), derives synchronously as the slider moves"
      bytes_per_file: "avg from audioCache.stats() (persistent.bytes / count), fallback ~24KB"
      files_projection: "avg files/round from loaded sample × rounds the notch covers"
      device_quota: "navigator.storage.estimate() via audioCache.stats().quotaBytes"
      accuracy: "best-effort, labelled '~'; self-refines as the cache grows"

    key_functions:
      courseTotalRounds: "course length (main-loop), the % denominator"
      roundsForCourseFraction: "fraction → round count ahead, capped at course tail; >=1 → Infinity"
      ensureOfflineRoundsLoaded: "expandScript() until N rounds loaded ahead or generator dry"
      collectRoundsAudioIds: "unique /api/audio ids over N rounds ahead of cursor"
      downloadForOffline: "(roundsAhead) — ensure + collect + fetch missing into IndexedDB"

    progress:
      state: "offlineDlState: idle | preparing | downloading | complete | error"
      counts: "offlineDlDone / offlineDlTotal / offlineDlFailed (only genuine cache writes tick done)"
      shared_state: >
        useOfflineDownloadStatus.ts — module-level refs (offlineDlState/Done/Total/
        Failed) + computeds (offlineDownloadVisible/Active/Pct/Label), written by
        LearningPlayer.downloadForOffline, read by ModeTray. Same shared-singleton
        pattern as usePwaUpdate (no prop-drilling to the mode button). LearningPlayer
        resetOfflineDownloadStatus() onMounted + offlineActive=false onUnmounted so a
        course-change remount can't leave a stale ring or an orphaned write loop.
      indicator: >
        A progress RING around the mode-tray trigger button (where offline is
        switched on), NOT a floating banner. Shown when offlineDownloadVisible
        (state≠idle): determinate arc = offlineDownloadPct while downloading, green
        full ring on complete (~4s then idle), red on error, indeterminate spin while
        preparing. pointer-events:none so it never blocks the button. The granular
        "Downloading… N% (x/y)" detail shows on the tray's Offline row (open the tray
        for it) — green while active, red on error.

    deferred:
      premium_gate: "useEntitlement.canDownload exists but NOT wired to download (no premium users yet)"
      expiry_30_day: "Spotify-style purge-if-not-online-in-30-days — not built yet"

  ## ==========================================================================
  ## GRACEFUL DEGRADATION (INFINITE PLAY)
  ## ==========================================================================

  graceful_degradation:
    file: "packages/player-vue/src/composables/useOfflinePlay.ts"
    purpose: "Never-fail playback - always keep playing"

    degradation_hierarchy:
      level_1_normal:
        condition: "Scheduled cycle is cached or online"
        action: "Play scheduled cycle"

      level_2_belt_only:
        condition: "Scheduled unavailable, other cycles cached"
        action: "Play random cached cycle (avoiding recent)"
        message: "Playing from your offline library"

      level_3_use_phrases:
        condition: "Limited cache, only mastered content"
        action: "Play mastered USE phrases"
        message: "Reviewing mastered content while offline"

      level_4_repeat:
        condition: "Minimal cache"
        action: "Repeat last successfully played cycle"
        message: "Repeating last lesson - go online to continue"

    guarantee: "User NEVER sees connection error - audio keeps playing"

  ## ==========================================================================
  ## DATA FLOW
  ## ==========================================================================

  data_flow:
    playback:
      description: "How audio gets to the user (online == offline, cache-first)"
      flow: |
        Cycle.audioUrl (/api/audio/<id>)
          → resolveAudioUrl / createAudioCacheSource (shouldServeBlobs = offline || cachePlayOnline)
          → audioCache.getWavBlobUrl(id)  # decode cached mp3 → WAV blob: URL, decoded once
          → HIT:  play the WAV blob from cache (no network, lock-safe)
          → MISS: fall through to /api/audio/<id> (origin proxy, 206 ranges) and stream
                  that one clip while the rolling filler warms the cache behind it

    fill:
      description: "How the cache is kept ahead (the network's only job)"
      flow: |
        Round advance / stop / first-rounds-load
          → fillBuffer(span) via fillRollingBuffer (20min, gentle) or warmBurst (10min, fast)
          → expandScript / ensureLiveSpanLoaded grows the loaded script DEEP
          → ordered missing-list [cycles…, pods…, L1…], dedupe, drain front-to-back
          → audioCache.persistent.ensure(id)  # fetch /api/audio/<id>, store mp3 blob
          → (SimplePlayer.prefetchNextCycle warms the very next cycle's clips)

    offline_play:
      description: "How playback continues offline (graceful degradation)"
      flow: |
        Request next cycle
          → Check if scheduled cycle playable (all 3 ids cached)
          → If yes: play normally (WAV blob from cache)
          → If no: degrade to next level (useOfflinePlay)
          → Get cycle from cached pool
          → Play (user unaware of degradation)

  ## ==========================================================================
  ## FILES SUMMARY
  ## ==========================================================================

  files:
    live:
      - path: "api/audio/[audioId].ts"
        purpose: "Vercel serverless proxy (origin, correct 206 ranges)"
      - path: "packages/player-vue/src/cache/AudioCache.ts (+ AudioCache.types.ts)"
        purpose: "IndexedDB ssi-audio-cache-v2 — persistent (warm) + ephemeral (vestigial) namespaces"
      - path: "packages/player-vue/src/cache/createAudioCacheSource.ts"
        purpose: "AudioSource adapter over AudioCache (cache-first read path)"
      - path: "packages/player-vue/src/cache/resolvePlaybackUrl.ts"
        purpose: "resolveCachedPlaybackUrl — shared id → lock-safe playable (WAV) URL"
      - path: "packages/player-vue/src/cache/wav.ts"
        purpose: "bytesToWavBlob — decode cached mp3 bytes → WAV blob for WebKit <audio>"
      - path: "packages/player-vue/src/components/LearningPlayer.vue"
        purpose: "Rolling filler (fillBuffer/expandScript), cachePlayOnline gate, RealAudioController, offline depth picker"
      - path: "packages/player-vue/src/playback/SimplePlayer.ts"
        purpose: "Spotify-style player — single <audio>, prefetchNextCycle"
      - path: "packages/player-vue/src/composables/useOfflinePlay.ts"
        purpose: "Graceful degradation hierarchy (never-fail)"
      - path: "packages/player-vue/src/composables/useOfflineDownloadStatus.ts"
        purpose: "Module-level shared offline-download progress state (mode-button ring)"
      - path: "packages/player-vue/src/config/audioConfig.ts"
        purpose: "Audio URL builder and config"
      - path: "packages/player-vue/vite.config.js"
        purpose: "VitePWA/Workbox SW — app shell + fonts only; NO audio"

    deleted_2026_06_08_and_earlier:
      - "packages/core/src/cache/OfflineCache.ts (→ AudioCache)"
      - "packages/core/src/cache/AudioSource.ts (→ createAudioCacheSource)"
      - "packages/core/src/cache/DownloadManager.ts (resumable downloads — gone; depth picker downloadForOffline replaces it)"
      - "packages/core/src/cache/types.ts"
      - "packages/player-vue/src/cache/AudioPrefetcher.ts (no-op since 2026-05-23)"
      - "packages/player-vue/src/cache/BundleDownloader.ts (always-on full-course download — never fired)"
      - "packages/player-vue/src/composables/usePrefetchManager.ts (30-min buffer mgr → rolling filler)"
      - "packages/player-vue/src/composables/useOfflineCache.ts"
      - "supabase/migrations/...audio_plays.sql (table dropped 2026-05-19 — proxy is not a play log)"

  ## ==========================================================================
  ## QUALITY METRICS
  ## ==========================================================================

  quality_targets:
    never_fail: "Audio must ALWAYS play, regardless of network"
    atomic_binding: "Text and audio ALWAYS match (Cycle ensures this)"
    cache_first: "The player only ever reads from the cache; the network only fills it ahead"
    buffer_target: "~20 min of cycles (+pods+L1) warmed ahead of the playhead (ROLLING_SPAN_MS)"
    lock_safe: "Main cycle plays cached WAV blobs (not streamed ranges) so it survives iOS lock/background"
    offline_capability: "Deliberate depth picker downloads N% of remaining course; INF PLAY recycles forever"
    analytics_coverage: "Plays tracked client-side via player_events.audio_play (NOT the proxy)"
    eviction: "persistent LRU size-cap (persistentEvictToTarget) + quota self-trim before the browser errors"
