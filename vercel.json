{
  "buildCommand": "pnpm --filter @ssi/core build && pnpm --filter player-vue build",
  "outputDirectory": "packages/player-vue/dist",
  "installCommand": "npm install -g pnpm && pnpm install",
  "framework": "vite",
  "regions": ["dub1"],
  "functions": {
    "api/audio/[audioId].ts": {
      "maxDuration": 10
    },
    "api/audio/batch-urls.ts": {
      "maxDuration": 10
    },
    "api/admin/demo-schools.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'sha256-P61JYclv90ZRpx5dbC0HT/wLWBFnxHPiIJ4ZkvrQSIQ=' https://*.paddle.com https://*.profitwell.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.paddle.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.paddle.com; media-src 'self' data: blob: https://*.s3.eu-west-1.amazonaws.com https://*.s3.amazonaws.com; connect-src 'self' https://swfvymspfxmnfhevgdkg.supabase.co wss://swfvymspfxmnfhevgdkg.supabase.co https://*.s3.eu-west-1.amazonaws.com https://*.s3.amazonaws.com https://fonts.googleapis.com https://fonts.gstatic.com https://*.paddle.com https://*.profitwell.com; frame-src 'self' https://*.paddle.com; worker-src 'self' blob:; manifest-src 'self'"
        }
      ]
    },
    {
      "source": "/_schools-mockups/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/api/audio/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/schools", "destination": "/schools/index.html" },
    { "source": "/schools/(.*)", "destination": "/schools/index.html" },
    { "source": "/methodology", "destination": "/methodology/index.html" },
    { "source": "/methodology/", "destination": "/methodology/index.html" },
    { "source": "/paddle-review", "destination": "/paddle-review/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/refunds", "destination": "/refunds/index.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/teacher-payouts", "schedule": "0 6 1 * *" },
    { "path": "/api/cron/expire-demo-schools", "schedule": "0 5 * * *" }
  ]
}
