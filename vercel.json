{
  "buildCommand": "pnpm --filter @ssi/core build && pnpm --filter player-vue build",
  "outputDirectory": "packages/player-vue/dist",
  "installCommand": "npm install -g pnpm && pnpm install",
  "framework": "vite",
  "regions": ["dub1"],
  "functions": {
    "api/audio/[audioId].ts": {
      "maxDuration": 10
    },
    "api/audio/batch-urls.ts": {
      "maxDuration": 10
    },
    "api/admin/demo-schools.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/audio/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/schools", "destination": "/schools/index.html" },
    { "source": "/schools/(.*)", "destination": "/schools/index.html" },
    { "source": "/paddle-review", "destination": "/paddle-review/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/refunds", "destination": "/refunds/index.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/teacher-payouts", "schedule": "0 6 1 * *" },
    { "path": "/api/cron/expire-demo-schools", "schedule": "0 5 * * *" }
  ]
}
